#!/usr/bin/env bash
# llm-wt - per-pane git worktrees for lazy-llm AI panes
#
# An isolated AI pane runs in its own worktree, named once when it's created
# (default <repo>-wt-<n>): directory .worktrees/.panes/<name>, branch
# lazy/<name>. It merges its work back into the branch the workspace's main
# directory is on. Nothing renames it later: a pane rename is only a label. Ownership lives in git config, so this
# works from inside the worktree with no tmux state:
#   branch.<branch>.lazyLlmBase     the branch to integrate into
#   branch.<branch>.lazyLlmPrimary  the main directory (repo toplevel)
#
# Claude Code's own worktrees (subagent isolation, EnterWorktree, claude -w)
# are made here too, by `claude-hook` on WorktreeCreate: directory
# .worktrees/.claude/<name>, branch lazy/<name>, from the parent's HEAD. They
# carry the same two keys plus lazyLlmKind=claude, lazyLlmName (Claude's name
# for it: agent-<agentId> for a subagent), lazyLlmSession and lazyLlmPane. A
# subagent's worktree is integrated by its parent session (integrate --remove).
#
# Usage:
#   llm-wt info [path]                  worktree, branch, base, main directory
#   llm-wt status [path] [--porcelain]  what closing this worktree would lose
#   llm-wt sync [path]                  rebase onto the base branch
#   llm-wt integrate [path] [--remove]  rebase, then fast-forward the base branch;
#                                       --remove deletes the worktree afterwards
#   llm-wt list [dir] [--porcelain]     Claude's worktrees that integrate into <dir>
#   llm-wt claude-hook                  Claude Code hook handler (payload on stdin):
#                                       creates/removes Claude's worktrees, guidance
#   llm-wt create <dir> [name]          new pane worktree for workspace dir <dir>
#   llm-wt default-name <dir>           the name create would pick: <repo>-wt-<n>
#   llm-wt bootstrap <path>             (re)link/copy untracked files, run init hook
#   llm-wt close <path> [--default]     ask what to do with a worktree whose last
#                                       pane is closing; prints remove|keep|cancel
#   llm-wt remove <path> [--force]      delete the worktree and its branch
#
# [path] defaults to the current directory's worktree.
#
# Exit codes (sync/integrate): 0 ok, 1 other error, 2 not a pane worktree,
# 3 uncommitted changes, 4 main directory not on the base branch,
# 5 rebase conflict (or a rebase already in progress), 6 base kept moving,
# 7 the fast-forward would overwrite uncommitted files in the main directory.

set -euo pipefail

# Sibling-first (post-install via stow), then dev-fallback to the in-repo path.
_lib_sibling="$(dirname "$0")/lazy-llm-lib.sh"
if [[ -f "$_lib_sibling" ]]; then
  # shellcheck source=/dev/null
  source "$_lib_sibling"
else
  # shellcheck source=/dev/null
  source "$(dirname "$0")/../../../llm-send-bin/.local/bin/lazy-llm-lib.sh"
fi

readonly MANIFEST_NAME="lazy-llm-bootstrap"
readonly EXCLUDE_MARK="# lazy-llm worktree bootstrap"
readonly DEFAULT_FILES=$'.env*\n.claude/settings.local.json\n.agents/TODO/.work-state'

die() { local code="$1"; shift; printf 'llm-wt: %s\n' "$*" >&2; exit "$code"; }
warn() { printf 'llm-wt: %s\n' "$*" >&2; }

# ── the repo lock ────────────────────────────────────────────────────────

# Serializes writes to what every worktree of a repo shares: .git/config
# (`git config` fails on config.lock under contention), info/exclude, and the
# free-name probe. Claude launching several isolated subagents at once means
# concurrent creates. Reentrant (a depth count), so a locked step can call
# another that locks. Callers bracket the critical section with lock_repo /
# unlock_repo rather than passing a command: a function run as `f || rc=$?`
# loses `set -e` for its whole body. A die() in between exits the process,
# which drops a flock; the symlink lock is removed by an EXIT trap.
_LOCK_DEPTH=0
_LOCK_FD=""
_LOCK_DIR=""

lock_repo() {
  _LOCK_DEPTH=$((_LOCK_DEPTH + 1))
  [[ $_LOCK_DEPTH -gt 1 ]] && return 0
  local common owner waited=0
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die 1 "not in a git repository: $1"
  # LAZY_LLM_WT_LOCK=link forces the portable lock (tests).
  if [[ "${LAZY_LLM_WT_LOCK:-}" != link ]] && command -v flock >/dev/null 2>&1; then
    exec {_LOCK_FD}>>"$common/lazy-llm-wt.lock"
    flock -w 60 "$_LOCK_FD" || die 1 "timed out after 60s waiting for $common/lazy-llm-wt.lock"
    return 0
  fi
  # No flock (macOS): a symlink whose target is the owner's pid. Creating it
  # is atomic and carries the pid, so the lock never exists without an owner.
  # A dead owner's lock is broken by one waiter at a time: the breaker takes
  # a second lock (a mkdir), re-reads the owner under it, and removes the
  # link only if it's still that dead owner's. Nobody else can change the
  # link meanwhile: the owner is dead, other breakers wait, and acquirers
  # can't create over it.
  _LOCK_DIR="$common/lazy-llm-wt.lock.l"
  local brk="$_LOCK_DIR.break" brkwait=0
  until ln -s "$$" "$_LOCK_DIR" 2>/dev/null; do
    owner=$(readlink "$_LOCK_DIR" 2>/dev/null) || owner=""
    if [[ -n "$owner" ]] && ! kill -0 "$owner" 2>/dev/null; then
      if mkdir "$brk" 2>/dev/null; then
        [[ "$(readlink "$_LOCK_DIR" 2>/dev/null)" == "$owner" ]] && rm -f "$_LOCK_DIR"
        rmdir "$brk"
        brkwait=0
        continue
      fi
      # A breaker that died mid-break (it holds the mutex for microseconds).
      brkwait=$((brkwait + 1))
      [[ $brkwait -gt 50 ]] && { rmdir "$brk" 2>/dev/null; brkwait=0; }
    fi
    waited=$((waited + 1))
    [[ $waited -gt 600 ]] && { _LOCK_DIR=""; die 1 "timed out after 60s waiting for $common/lazy-llm-wt.lock.l"; }
    sleep 0.1
  done
  trap 'release_link_lock' EXIT
}

# Remove the symlink lock if it's still ours.
release_link_lock() {
  [[ -n "$_LOCK_DIR" && "$(readlink "$_LOCK_DIR" 2>/dev/null)" == "$$" ]] && rm -f "$_LOCK_DIR"
  return 0
}

# Run a command with the flock fd closed, so nothing it starts inherits the
# lock (the lock lives as long as any process holds that fd open).
# In a subshell: a {var}>&- redirection on the command itself may outlive it
# and close the parent's copy, releasing the lock.
no_lock_fd() {
  if [[ -n "$_LOCK_FD" ]]; then
    ( exec {_LOCK_FD}>&-; "$@" )
  else
    "$@"
  fi
}

# lazy_llm_setup_worktree from <dir>: <dir> <branch> <base dir> <start> <name>
sh_cd_setup() {
  local dir="$1"; shift
  (cd "$dir" && lazy_llm_setup_worktree "$@")
}

unlock_repo() {
  [[ $_LOCK_DEPTH -gt 0 ]] || return 0
  _LOCK_DEPTH=$((_LOCK_DEPTH - 1))
  [[ $_LOCK_DEPTH -eq 0 ]] || return 0
  if [[ -n "$_LOCK_FD" ]]; then
    exec {_LOCK_FD}>&-
    _LOCK_FD=""
  fi
  if [[ -n "$_LOCK_DIR" ]]; then
    release_link_lock
    _LOCK_DIR=""
    trap - EXIT
  fi
  return 0
}

# ── context ──────────────────────────────────────────────────────────────

# The branch a worktree is on, including mid-rebase (when HEAD is detached).
wt_branch() {
  local wt="$1" b f
  b=$(git -C "$wt" branch --show-current 2>/dev/null) || b=""
  if [[ -z "$b" ]]; then
    for f in rebase-merge/head-name rebase-apply/head-name; do
      f=$(git -C "$wt" rev-parse --path-format=absolute --git-path "$f" 2>/dev/null) || continue
      [[ -f "$f" ]] && { b=$(<"$f"); b="${b#refs/heads/}"; break; }
    done
  fi
  printf '%s\n' "$b"
}

rebase_in_progress() {
  local wt="$1" f
  for f in rebase-merge rebase-apply; do
    f=$(git -C "$wt" rev-parse --path-format=absolute --git-path "$f" 2>/dev/null) || continue
    [[ -d "$f" ]] && return 0
  done
  return 1
}

# A worktree's kind: "claude" (made by claude-hook) or "pane" (llm-add -i,
# which records no kind).
wt_kind() {
  local k
  k=$(git -C "$1" config "branch.$2.lazyLlmKind" 2>/dev/null) || k=""
  printf '%s\n' "${k:-pane}"
}

# Sets WT BRANCH BASE PRIMARY for the pane worktree containing $1 (default
# cwd). Exits 2 when it isn't one.
load_ctx() {
  local start="${1:-$PWD}"
  WT=$(git -C "$start" rev-parse --show-toplevel 2>/dev/null) || die 2 "not in a git worktree: $start"
  BRANCH=$(wt_branch "$WT")
  [[ -n "$BRANCH" ]] || die 2 "$WT has no branch checked out"
  BASE=$(git -C "$WT" config "branch.$BRANCH.lazyLlmBase" 2>/dev/null) || BASE=""
  PRIMARY=$(git -C "$WT" config "branch.$BRANCH.lazyLlmPrimary" 2>/dev/null) || PRIMARY=""
  [[ -n "$BASE" && -n "$PRIMARY" ]] || die 2 "$WT (branch $BRANCH) is not a lazy-llm pane worktree"
}

manifest_path() {
  printf '%s/%s\n' "$(git -C "$1" rev-parse --absolute-git-dir)" "$MANIFEST_NAME"
}

# ── bootstrap: untracked files a fresh worktree lacks ───────────────────

# Print the worktree-files entries, one "mode<TAB>pattern" per line, where
# mode is link, copy or exclude. Global list first, then the repo's own.
read_file_entries() {
  local repo="$1" f line mode any=false
  local -a files=("${XDG_CONFIG_HOME:-$HOME/.config}/lazy-llm/worktree-files" "$repo/.lazy-llm/worktree-files")
  for f in "${files[@]}"; do
    [[ -f "$f" ]] || continue
    any=true
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%[[:space:]]#*}"      # trailing " # comment"
      [[ "$line" == \#* ]] && continue    # whole-line comment
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      [[ -z "$line" ]] && continue
      mode="link"
      if [[ "$line" == copy:* ]]; then
        mode=copy; line="${line#copy:}"; line="${line#"${line%%[![:space:]]*}"}"
      elif [[ "$line" == !* ]]; then
        mode=exclude; line="${line#!}"
      fi
      printf '%s\t%s\n' "$mode" "$line"
    done < "$f"
  done
  if ! $any; then
    while IFS= read -r line; do printf 'link\t%s\n' "$line"; done <<< "$DEFAULT_FILES"
  fi
  # Claude Code's .worktreeinclude: what its own worktree creation copies.
  # Our WorktreeCreate hook replaces that, so honor it here, for every kind.
  # Its patterns are copies; a "!" line excludes. Paths and globs are matched
  # at the top level only (no gitignore-style any-depth matching).
  f="$repo/.worktreeinclude"
  [[ -f "$f" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%[[:space:]]#*}"
    [[ "$line" == \#* ]] && continue
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    if [[ "$line" == !* ]]; then
      line="${line#!}"
      printf 'exclude\t%s\n' "${line#/}"
    else
      printf 'copy\t%s\n' "${line#/}"
    fi
  done < "$f"
}

tree_hash() {
  local p="$1"
  if [[ -d "$p" && ! -L "$p" ]]; then
    (cd "$p" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0r sha256sum) | sha256sum | cut -d' ' -f1
  elif [[ -e "$p" ]]; then
    sha256sum < "$p" | cut -d' ' -f1
  else
    printf 'missing\n'
  fi
}

# Link or copy the configured untracked files from the main directory into
# the worktree, record them in the manifest, keep them out of `git add`, and
# run the repo's init hook. Safe to rerun: existing paths are left alone.
cmd_bootstrap() {
  load_ctx "${1:-}"
  local repo="$PRIMARY" wt="$WT" manifest mode pat path ex
  local -a entries=() excludes=() paths=() modes=()
  manifest=$(manifest_path "$wt")
  touch "$manifest"

  while IFS=$'\t' read -r mode pat; do
    pat="${pat%/}"
    [[ -z "$pat" ]] && continue
    if [[ "$mode" == exclude ]]; then excludes+=("$pat"); else entries+=("$mode"$'\t'"$pat"); fi
  done < <(read_file_entries "$repo")

  local entry m
  for entry in ${entries[@]+"${entries[@]}"}; do
    mode="${entry%%$'\t'*}"; pat="${entry#*$'\t'}"
    local -a matches=()
    if [[ "$pat" == *[\*\?\[]* ]]; then
      mapfile -t matches < <(cd "$repo" && shopt -s dotglob nullglob && for m in $pat; do printf '%s\n' "${m%/}"; done)
    else
      # A literal path: linked even when missing (the first write through
      # the dangling link creates it in the main directory); copied only
      # when present.
      matches=("$pat")
      [[ "$mode" == copy && ! -e "$repo/$pat" ]] && matches=()
    fi
    for path in ${matches[@]+"${matches[@]}"}; do
      local skip=false
      for ex in ${excludes[@]+"${excludes[@]}"}; do
        # shellcheck disable=SC2053  # $ex is a glob, deliberately unquoted
        [[ "$path" == $ex ]] && { skip=true; break; }
      done
      $skip && continue
      # Never shadow a tracked file (or a directory holding tracked files).
      git -C "$repo" ls-files --error-unmatch -- "$path" >/dev/null 2>&1 && continue
      # Already handled (first pattern wins), or already in the worktree.
      [[ " ${paths[*]+${paths[*]}} " == *" $path "* ]] && continue
      [[ -e "$wt/$path" || -L "$wt/$path" ]] && continue
      paths+=("$path"); modes+=("$mode")
    done
  done

  local i hash
  for i in "${!paths[@]}"; do
    path="${paths[$i]}"; mode="${modes[$i]}"
    # Excluded before it exists: a bootstrap that stops partway (a copy that
    # fails) must not leave a link `git add -A` would commit.
    add_exclude "$wt" "/$path"
    mkdir -p "$(dirname "$wt/$path")"
    if [[ "$mode" == link ]]; then
      # A dangling link can only create its target if the target's parent
      # exists: make it (an empty directory is invisible to git).
      mkdir -p "$(dirname "$repo/$path")"
      ln -s "$repo/$path" "$wt/$path"
      printf 'link\t%s\n' "$path" >> "$manifest"
    else
      cp -a "$repo/$path" "$wt/$path"
      hash=$(tree_hash "$wt/$path")
      printf 'copy\t%s\t%s\n' "$path" "$hash" >> "$manifest"
    fi
  done

  exclude_bootstrapped "$wt" "$manifest"
  run_init_hook
}

# Keep bootstrapped paths out of `git add -A` in the worktree, so an agent
# can't commit a symlink into the main directory. info/exclude is shared by
# every worktree of the repo (the main directory too); these are untracked
# local files by construction, so ignoring them there changes nothing but
# their "untracked" listing. Lines carry a marker so they're identifiable.
exclude_bootstrapped() {
  local wt="$1" manifest="$2" mode path
  while IFS=$'\t' read -r mode path _; do
    [[ -z "$path" ]] && continue
    add_exclude "$wt" "/$path"
  done < "$manifest"
}

# Append <pattern> to the repo's shared info/exclude, unless git already
# ignores that path or the line is there.
add_exclude() {
  local where="$1" pat="$2" excl
  lock_repo "$where"
  if ! git -C "$where" check-ignore -q --no-index -- "${pat#/}" 2>/dev/null; then
    excl=$(git -C "$where" rev-parse --path-format=absolute --git-common-dir)/info/exclude
    mkdir -p "$(dirname "$excl")"
    touch "$excl"
    # gitignore has no trailing comments: the marker goes on its own line.
    grep -qxF "$pat" "$excl" || printf '%s\n%s\n' "$EXCLUDE_MARK" "$pat" >> "$excl"
  fi
  unlock_repo
}

run_init_hook() {
  local hook="$PRIMARY/.lazy-llm/worktree-init" rc=0 kind
  [[ -x "$hook" ]] || return 0
  kind=$(wt_kind "$WT" "$BRANCH")
  echo "llm-wt: running $hook in $WT" >&2
  (cd "$WT" && LAZY_LLM_WORKTREE=1 LAZY_LLM_WORKTREE_KIND="$kind" LAZY_LLM_PRIMARY_DIR="$PRIMARY" \
    LAZY_LLM_BASE_BRANCH="$BASE" "$hook") >&2 || rc=$?
  [[ $rc -eq 0 ]] || warn "init hook exited $rc (the pane is created anyway)"
  return 0
}

# ── create ───────────────────────────────────────────────────────────────

# A name usable as both a directory and a branch component: anything outside
# [A-Za-z0-9._-] becomes "-", no ".." (git refuses it in a ref), no leading
# dot or dash, no trailing dot or ".lock".
safe_name() {
  local s="${1//[^A-Za-z0-9._-]/-}"
  while [[ "$s" == *..* ]]; do s="${s//../.}"; done
  while [[ "$s" == [.-]* ]]; do s="${s:1}"; done
  while [[ "$s" == *. || "$s" == *.lock ]]; do s="${s%.}"; s="${s%.lock}"; done
  printf '%s\n' "$s"
}

pane_base_dir() { printf '%s\n' "${LAZY_LLM_WORKTREE_DIR:-$1/.worktrees}/.panes"; }

# True when <name> is free in <repo>: no lazy/<name> branch, no directory.
name_free() {
  ! git -C "$1" show-ref --verify --quiet "refs/heads/lazy/$2" && [[ ! -e "$(pane_base_dir "$1")/$2" ]]
}

# <repo>-wt-<n>, the first n that's free.
default_name() {
  local repo="$1" root n=1
  root=$(safe_name "$(basename "$repo")")
  while ! name_free "$repo" "${root}-wt-$n"; do n=$((n + 1)); done
  printf '%s\n' "${root}-wt-$n"
}

cmd_default_name() {
  local repo
  repo=$(git -C "${1:-$PWD}" rev-parse --show-toplevel 2>/dev/null) || die 1 "${1:-$PWD} is not in a git repository"
  default_name "$repo"
}

cmd_create() {
  [[ $# -ge 1 && $# -le 2 ]] || die 1 "usage: llm-wt create <dir> [name]"
  local dir="$1" name="${2:-}" repo base branch wt pane_base
  repo=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || die 1 "$dir is not in a git repository"
  # Locked from the name probe to the last config write (see lock_repo).
  lock_repo "$repo"
  if [[ -n "$name" ]]; then
    local asked="$name"
    name=$(safe_name "$name")
    [[ -n "$name" ]] || die 1 "'$asked' has nothing usable as a name"
    name_free "$repo" "$name" || die 1 "the name '$name' is taken (branch lazy/$name or its directory exists)"
  else
    name=$(default_name "$repo")
  fi
  branch="lazy/$name"
  base=$(git -C "$repo" branch --show-current)
  [[ -n "$base" ]] || die 1 "$repo has a detached HEAD; check out a branch first"
  if [[ -n "$(git -C "$repo" status --porcelain -uno)" ]]; then
    warn "the main directory has uncommitted changes; the isolated pane starts from '$base' HEAD and won't see them"
  fi

  pane_base=$(pane_base_dir "$repo")
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die 1 "invalid branch name: $branch"

  # Ignore .worktrees/ via info/exclude rather than the tracked .gitignore:
  # creating a pane must not leave an uncommitted change in the main directory.
  [[ "$pane_base" == "$repo/.worktrees/"* ]] && add_exclude "$repo" "/.worktrees/"
  wt=$(no_lock_fd sh_cd_setup "$repo" "$branch" "$pane_base" "$base" "$name") || die 1 "could not create the worktree"
  git -C "$repo" config "branch.$branch.lazyLlmBase" "$base"
  git -C "$repo" config "branch.$branch.lazyLlmPrimary" "$repo"
  unlock_repo

  cmd_bootstrap "$wt"
  printf '%s\n' "$wt"
}

# ── Claude Code's worktrees ──────────────────────────────────────────────

claude_base_dir() { printf '%s\n' "${LAZY_LLM_WORKTREE_DIR:-$1/.worktrees}/.claude"; }

# The main directory at the end of a worktree's ownership chain: follow
# lazyLlmPrimary from pane/Claude worktrees until a directory that isn't one.
# Not `git worktree list`'s first entry: in a submodule that's the gitdir.
root_dir() {
  local dir="$1" b p n=0
  while [[ $n -lt 16 ]]; do
    b=$(wt_branch "$dir")
    [[ -n "$b" ]] || break
    p=$(git -C "$dir" config "branch.$b.lazyLlmPrimary" 2>/dev/null) || break
    [[ -n "$p" && -d "$p" && "$p" != "$dir" ]] || break
    dir="$p"
    n=$((n + 1))
  done
  printf '%s\n' "$dir"
}

# Create the worktree Claude asked for (WorktreeCreate). <cwd> is the parent
# session's directory: the worktree starts from its HEAD (never origin's
# default branch, which is what Claude's own creation uses) and integrates
# into its branch, in its directory. A parent that's itself in a pane or
# Claude worktree nests: work flows back one level at a time. The directory
# goes under the root main directory's .worktrees/, not inside the parent.
# Stdout: exactly the worktree's path. Everything else goes to stderr.
claude_create() {
  local cwd="$1" raw="$2" session="$3" parent base root wt_base name cand n=2 branch wt
  parent=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || die 1 "not in a git repository: $cwd"
  base=$(git -C "$parent" branch --show-current 2>/dev/null) || base=""
  root=$(root_dir "$parent")
  wt_base=$(claude_base_dir "$root")
  name=$(safe_name "$raw")
  [[ -n "$name" ]] || name=claude-wt

  lock_repo "$parent"
  cand="$name"
  while git -C "$parent" show-ref --verify --quiet "refs/heads/lazy/$cand" || [[ -e "$wt_base/$cand" ]]; do
    cand="$name-$n"
    n=$((n + 1))
  done
  name="$cand"
  branch="lazy/$name"
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die 1 "invalid branch name: $branch"
  [[ "$wt_base" == "$root/.worktrees/"* ]] && add_exclude "$root" "/.worktrees/"
  # The lock fd is closed for `git worktree add`: its post-checkout hook (and
  # anything that hook leaves running) must not hold the repo lock.
  wt=$(no_lock_fd sh_cd_setup "$parent" "$branch" "$wt_base" HEAD "$name") || die 1 "could not create the worktree"
  # A failed config write undoes the worktree: exiting non-zero with it in
  # place would leave it orphaned, and the plugin shim would make another.
  local -a kv=("lazyLlmKind=claude")
  [[ -n "$raw" ]] && kv+=("lazyLlmName=$raw")
  [[ -n "$session" ]] && kv+=("lazyLlmSession=$session")
  [[ -n "${TMUX_PANE:-}" ]] && kv+=("lazyLlmPane=$TMUX_PANE")
  [[ -n "$base" ]] && kv+=("lazyLlmBase=$base" "lazyLlmPrimary=$parent")
  local e
  for e in "${kv[@]}"; do
    if ! git -C "$parent" config "branch.$branch.${e%%=*}" "${e#*=}"; then
      git -C "$parent" worktree remove --force "$wt" >&2 || true
      git -C "$parent" branch -D "$branch" >&2 || true
      die 1 "could not record ${e%%=*} for $branch; the worktree was rolled back"
    fi
  done
  unlock_repo

  if [[ -n "$base" ]]; then
    # In a child process: a bootstrap failure (an unreadable file to copy,
    # say) is reported, but the worktree exists and is what Claude gets.
    "$0" bootstrap "$wt" >&2 || warn "bootstrapping $wt failed (exit $?); the worktree is usable, but untracked files may be missing"
  else
    warn "$parent has a detached HEAD: $wt has nothing to integrate into (no bootstrap, no llm-wt integrate)"
  fi
  printf '%s\n' "$wt"
}

# Sets WT BRANCH BASE PRIMARY KIND for an llm-wt worktree containing $1, like
# load_ctx, but returns 1 instead of exiting: hook handlers must not exit 2,
# which some hook events treat as "block".
probe_ctx() {
  WT=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
  BRANCH=$(wt_branch "$WT")
  [[ -n "$BRANCH" ]] || return 1
  BASE=$(git -C "$WT" config "branch.$BRANCH.lazyLlmBase" 2>/dev/null) || BASE=""
  PRIMARY=$(git -C "$WT" config "branch.$BRANCH.lazyLlmPrimary" 2>/dev/null) || PRIMARY=""
  [[ -n "$BASE" && -n "$PRIMARY" ]] || return 1
  KIND=$(wt_kind "$WT" "$BRANCH")
}

# The Claude worktree made for subagent <agent_id> (lazyLlmName
# agent-<agent_id>): <cwd>'s worktree when it's that one, else found by
# scanning the repo's branches. Prints its path; returns 1 when there's none,
# i.e. the subagent wasn't isolated.
find_agent_wt() {
  local want="agent-$1" cwd="$2" top b repo key val path="" br=""
  [[ -n "$1" ]] || return 1
  if top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); then
    b=$(wt_branch "$top")
    if [[ -n "$b" && "$(git -C "$top" config "branch.$b.lazyLlmName" 2>/dev/null)" == "$want" ]]; then
      printf '%s\n' "$top"
      return 0
    fi
  fi
  repo="${CLAUDE_PROJECT_DIR:-$cwd}"
  b=""
  while read -r key val; do
    [[ "$val" == "$want" ]] || continue
    b="${key#branch.}"
    b="${b%.*}"
    break
  done < <(git -C "$repo" config --get-regexp '^branch\..*\.lazyllmname$' 2>/dev/null || true)
  [[ -n "$b" ]] || return 1
  while IFS= read -r key; do
    case "$key" in
      worktree\ *) path="${key#worktree }" ;;
      branch\ *) br="${key#branch refs/heads/}"
        [[ "$br" == "$b" ]] && { printf '%s\n' "$path"; return 0; } ;;
    esac
  done < <(git -C "$repo" worktree list --porcelain 2>/dev/null || true)
  return 1
}

# ── claude-hook: Claude Code hook handler ───────────────────────────────
#
# Wired by lazy-llm's plugin (claude-plugin/hooks/worktree.sh). Events:
#   WorktreeCreate  claude_create; stdout is the path Claude uses
#   WorktreeRemove  remove, refusing to lose work (exit 1 says why)
#   SubagentStart   guidance for an isolated subagent (worktree-subagent.md)
#   SubagentStop    remove the subagent's worktree when it left nothing in it
#   PostToolUse     Agent: tell the parent where the work is and how to land
#                   it (worktree-parent.md); EnterWorktree: worktree-agent.md
#   SessionStart    worktree-agent.md for a session started in an llm-wt
#                   worktree of any kind (isolated panes, claude -w)
# Fields are read with grep/sed, like llm-claude-hook: no jq dependency.

# The first "<name>": "<string>" in the payload, JSON escapes decoded
# (\" \\ \/ \t \n; \uXXXX is left as is).
hook_field() {
  local v
  v=$(printf '%s' "$HOOK_INPUT" \
    | grep -oE "\"$1\"[[:space:]]*:[[:space:]]*\"([^\"\\\\]|\\\\.)*\"" | head -1 \
    | sed -E 's/^"[^"]*"[[:space:]]*:[[:space:]]*"//; s/"$//') || true
  v=${v//\\\\/$'\x01'}
  v=${v//\\\"/\"}
  v=${v//\\\//\/}
  v=${v//\\t/$'\t'}
  v=${v//\\n/$'\n'}
  v=${v//$'\x01'/\\}
  printf '%s' "$v"
}

json_escape() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/}
  s=${s//$'\n'/\\n}
  printf '%s' "$s"
}

emit_context() {
  printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$1" "$(json_escape "$2")"
}

share_dir() {
  local d
  for d in "${LAZY_LLM_SHARE_DIR:-}" "$(dirname "$0")/../share/lazy-llm" \
      "$(dirname "$0")/../../../llm-status-bin/.local/share/lazy-llm"; do
    [[ -n "$d" && -d "$d" ]] && { printf '%s\n' "$d"; return 0; }
  done
  return 1
}

# A guidance file with {{path}} {{branch}} {{base}} {{primary}} filled from
# the ctx globals, plus any extra key=value pairs given.
guidance() {
  local file text kv
  file="$(share_dir)/$1" || return 1
  [[ -f "$file" ]] || return 1
  text=$(<"$file")
  # Replacements quoted: bash 5.2 expands an unquoted & to the match.
  text=${text//"{{path}}"/"$WT"}
  text=${text//"{{branch}}"/"$BRANCH"}
  text=${text//"{{base}}"/"$BASE"}
  text=${text//"{{primary}}"/"$PRIMARY"}
  shift
  for kv in "$@"; do
    text=${text//"{{${kv%%=*}}}"/"${kv#*=}"}
  done
  printf '%s' "$text"
}

hook_worktree_create() {
  local cwd
  cwd=$(hook_field cwd)
  claude_create "${cwd:-$PWD}" "$(hook_field name)" "$(hook_field session_id)"
}

hook_worktree_remove() {
  local path
  path=$(hook_field worktree_path)
  [[ -n "$path" ]] || die 1 "WorktreeRemove without a worktree_path"
  [[ -e "$path" ]] || return 0
  local top
  top=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null) || die 1 "$path is not a git worktree"
  [[ "$top" == "$(cd "$path" && pwd -P)" ]] || die 1 "$path is not a worktree's top directory; not removing $top"
  if probe_ctx "$path"; then
    [[ "$KIND" == claude ]] || die 1 "$path is a lazy-llm pane's worktree; close the pane to remove it"
    cmd_remove "$path" >&2
  else
    # Not one of ours (made by the plugin's fallback), or one with nothing to
    # integrate into: plain removal, which refuses a dirty tree and keeps the
    # branch, so commits survive either way.
    git -C "$path" worktree remove "$path" >&2
  fi
}

hook_subagent_start() {
  local wt text
  wt=$(find_agent_wt "$(hook_field agent_id)" "$(hook_field cwd)") || return 0
  probe_ctx "$wt" || return 0
  [[ "$KIND" == claude ]] || return 0
  text=$(guidance worktree-subagent.md) || return 0
  emit_context SubagentStart "$text"
}

hook_subagent_stop() {
  local wt st
  wt=$(find_agent_wt "$(hook_field agent_id)" "$(hook_field cwd)") || return 0
  probe_ctx "$wt" || return 0
  # Only a worktree Claude made for this subagent; never a pane's.
  [[ "$KIND" == claude ]] || return 0
  st=$(cmd_status "$WT" --porcelain) || return 0
  grep -qE $'^(dirty|untracked|unintegrated|rebasing|copies-changed)\t[1-9]' <<< "$st" && return 0
  cmd_remove "$WT" >&2 || warn "could not remove the empty worktree $WT"
  return 0
}

hook_post_tool_use() {
  local tool wt status st key val commits=0 dirty=0 untracked=0 intro text
  tool=$(hook_field tool_name)
  wt=$(hook_field worktreePath)
  case "$tool" in
    Agent)
      status=$(hook_field status)
      # A background launch (status async_launched) carries the agent's id
      # but no worktreePath, and no hook fires when it finishes: this launch
      # is the parent's one chance to be told.
      [[ -n "$wt" ]] || wt=$(find_agent_wt "$(hook_field agentId)" "$(hook_field cwd)") || return 0
      if [[ ! -e "$wt" ]]; then
        emit_context PostToolUse "lazy-llm: that subagent changed nothing in its worktree, so it was removed ($wt). Nothing to integrate."
        return 0
      fi
      probe_ctx "$wt" || return 0
      [[ "$KIND" == claude ]] || return 0
      if [[ "$status" == completed ]]; then
        st=$(cmd_status "$WT" --porcelain) || return 0
        while IFS=$'\t' read -r key val; do
          case "$key" in
            unintegrated) commits=$val ;;
            dirty) dirty=$val ;;
            untracked) untracked=$val ;;
          esac
        done <<< "$st"
        intro="that subagent worked in its own worktree \`$WT\`, branch \`$BRANCH\`, split from \`$BASE\`. It has $commits commit(s) to integrate, $dirty uncommitted change(s) and $untracked untracked file(s)."
      else
        intro="that subagent is running in the background in its own worktree \`$WT\`, branch \`$BRANCH\`, split from \`$BASE\`. When it finishes (if its worktree is gone by then, it changed nothing):"
      fi
      text=$(guidance worktree-parent.md "intro=$intro") || return 0
      emit_context PostToolUse "$text"
      ;;
    EnterWorktree)
      [[ -n "$wt" ]] || return 0
      probe_ctx "$wt" || return 0
      text=$(guidance worktree-agent.md) || return 0
      emit_context PostToolUse "$text"
      ;;
  esac
}

hook_session_start() {
  local cwd text
  cwd=$(hook_field cwd)
  probe_ctx "${cwd:-$PWD}" || return 0
  text=$(guidance worktree-agent.md) || return 0
  emit_context SessionStart "$text"
}

# Each event runs in a child process of this script, so `set -e` holds inside
# the handler (a function called as `f || rc=$?` loses it), and the exit
# status is mapped here: WorktreeCreate's passes through (never 2), a failed
# WorktreeRemove is 1, and every other event always exits 0 — guidance and
# cleanup must never break Claude's flow.
cmd_claude_hook() {
  local input ev rc=0
  input=$(cat)
  HOOK_INPUT="$input"
  ev=$(hook_field hook_event_name)
  case "$ev" in
    WorktreeCreate | WorktreeRemove | SubagentStart | SubagentStop | PostToolUse | SessionStart) ;;
    *) return 0 ;;
  esac
  printf '%s' "$input" | "$0" __claude-hook-run "$ev" || rc=$?
  case "$ev" in
    WorktreeCreate) [[ $rc -eq 2 ]] && rc=1; return "$rc" ;;
    WorktreeRemove) [[ $rc -eq 0 ]] || rc=1; return "$rc" ;;
    *) return 0 ;;
  esac
}

cmd_claude_hook_run() {
  HOOK_INPUT=$(cat)
  case "$1" in
    WorktreeCreate) hook_worktree_create ;;
    WorktreeRemove) hook_worktree_remove ;;
    SubagentStart) hook_subagent_start ;;
    SubagentStop) hook_subagent_stop ;;
    PostToolUse) hook_post_tool_use ;;
    SessionStart) hook_session_start ;;
  esac
}

# ── list ─────────────────────────────────────────────────────────────────

# Claude worktrees that integrate into <dir>'s worktree (default cwd): what a
# parent session still has to land or drop.
cmd_list() {
  local porcelain=false dir="" a top line path="" br="" st key val dirty untracked unintegrated n=0 name
  for a in "$@"; do
    case "$a" in --porcelain) porcelain=true ;; *) dir="$a" ;; esac
  done
  top=$(git -C "${dir:-$PWD}" rev-parse --show-toplevel 2>/dev/null) || die 1 "${dir:-$PWD} is not in a git repository"
  local -a rows=()
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) path="${line#worktree }"; br="" ;;
      branch\ *) br="${line#branch refs/heads/}" ;;
      "")
        if [[ -n "$br" && -n "$path" ]] \
            && [[ "$(git -C "$top" config "branch.$br.lazyLlmKind" 2>/dev/null)" == claude ]] \
            && [[ "$(git -C "$top" config "branch.$br.lazyLlmPrimary" 2>/dev/null)" == "$top" ]]; then
          rows+=("$path"$'\t'"$br")
        fi
        path=""; br="" ;;
    esac
  done < <(git -C "$top" worktree list --porcelain; echo)
  for line in ${rows[@]+"${rows[@]}"}; do
    path="${line%%$'\t'*}"; br="${line#*$'\t'}"
    st=$(cmd_status "$path" --porcelain 2>/dev/null) || continue
    dirty=0; untracked=0; unintegrated=0
    while IFS=$'\t' read -r key val; do
      case "$key" in
        dirty) dirty=$val ;;
        untracked) untracked=$val ;;
        unintegrated) unintegrated=$val ;;
      esac
    done <<< "$st"
    name=$(git -C "$top" config "branch.$br.lazyLlmName" 2>/dev/null) || name=""
    n=$((n + 1))
    if $porcelain; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$path" "$br" "$name" "$dirty" "$untracked" "$unintegrated"
    else
      printf '%s\n  branch %s  ·  %s commit(s) to integrate  ·  %s uncommitted  ·  %s untracked\n' \
        "$path" "$br" "$unintegrated" "$dirty" "$untracked"
    fi
  done
  if ! $porcelain && [[ $n -eq 0 ]]; then
    echo "no Claude worktrees integrate into $top"
  fi
  return 0
}

# ── info / status ────────────────────────────────────────────────────────

# key<TAB>value lines; exits 2 when [path] isn't in a pane worktree.
cmd_info() {
  load_ctx "${1:-}"
  printf 'worktree\t%s\nbranch\t%s\nbase\t%s\nprimary\t%s\n' "$WT" "$BRANCH" "$BASE" "$PRIMARY"
}

# Paths in the manifest, one per line.
manifest_paths() { cut -f2 "$(manifest_path "$1")" 2>/dev/null || true; }

cmd_status() {
  local porcelain=false path=""
  for a in "$@"; do
    case "$a" in --porcelain) porcelain=true ;; *) path="$a" ;; esac
  done
  load_ctx "$path"

  local dirty=0 untracked=0 unintegrated=0 behind=0 ignored_extra=0 rebasing=0
  local -a changed=() boot=()
  local p
  while IFS= read -r p; do [[ -n "$p" ]] && boot+=("$p"); done < <(manifest_paths "$WT")
  # True when $1 is a bootstrapped path, inside a bootstrapped directory, or
  # a directory made only to hold one (.claude/ for settings.local.json).
  in_boot() {
    local q="${1%/}" b
    for b in ${boot[@]+"${boot[@]}"}; do
      [[ "$q" == "$b" || "$q" == "$b/"* || "$b" == "$q/"* ]] && return 0
    done
    return 1
  }

  local rec xy file
  while IFS= read -r -d '' rec; do
    xy="${rec:0:2}"; file="${rec:3}"
    if [[ "$xy" == "??" ]]; then
      in_boot "$file" || untracked=$((untracked + 1))
    else
      dirty=$((dirty + 1))
      # a rename record is followed by its source path: skip it
      [[ "$xy" == R* || "$xy" == C* ]] && IFS= read -r -d '' _
    fi
  done < <(git -C "$WT" status --porcelain=v1 -z --untracked-files=all)

  # Fail safe: a base that's gone (deleted, renamed) or a rev-list error must
  # never read as "nothing unintegrated" -- hooks remove worktrees on that.
  # Without a base, count the commits no other local branch has: what
  # removing the branch would lose.
  local base_missing=0
  if git -C "$WT" rev-parse --verify -q "refs/heads/$BASE^{commit}" >/dev/null; then
    # HEAD and the branch both: mid-rebase, HEAD is detached (maybe at the
    # base) while the branch still holds the commits.
    unintegrated=$(git -C "$WT" rev-list --count HEAD "refs/heads/$BRANCH" --not "$BASE" 2>/dev/null) || unintegrated=1
    behind=$(git -C "$WT" rev-list --count "HEAD..$BASE" 2>/dev/null) || behind=0
  else
    base_missing=1
    unintegrated=$(git -C "$WT" rev-list --count HEAD "refs/heads/$BRANCH" --not --exclude="$BRANCH" --branches 2>/dev/null) \
      || unintegrated=1
  fi
  rebase_in_progress "$WT" && rebasing=1

  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    in_boot "$p" || ignored_extra=$((ignored_extra + 1))
  done < <(git -C "$WT" ls-files --others --ignored --exclude-standard --directory)

  local mode hash
  while IFS=$'\t' read -r mode p hash; do
    [[ -z "$p" ]] && continue
    if [[ "$mode" == link ]]; then
      # A tool that saves via temp-file-and-rename replaces the link with a
      # plain file: its contents are this pane's own now.
      [[ -e "$WT/$p" && ! -L "$WT/$p" ]] && changed+=("$p")
    elif [[ "$(tree_hash "$WT/$p")" != "$hash" ]]; then
      changed+=("$p")
    fi
  done < "$(manifest_path "$WT")"

  if $porcelain; then
    printf 'worktree\t%s\nbranch\t%s\nbase\t%s\nprimary\t%s\n' "$WT" "$BRANCH" "$BASE" "$PRIMARY"
    printf 'dirty\t%s\nuntracked\t%s\nunintegrated\t%s\nbehind\t%s\n' "$dirty" "$untracked" "$unintegrated" "$behind"
    printf 'rebasing\t%s\ncopies-changed\t%s\nignored-extra\t%s\n' "$rebasing" "${#changed[@]}" "$ignored_extra"
    printf 'base-missing\t%s\n' "$base_missing"
    for p in ${changed[@]+"${changed[@]}"}; do printf 'copy-changed\t%s\n' "$p"; done
    return 0
  fi
  printf 'worktree        %s\n' "$WT"
  printf 'branch          %s  (base %s, main directory %s)\n' "$BRANCH" "$BASE" "$PRIMARY"
  [[ $base_missing -eq 1 ]] && printf 'base missing    yes — %s no longer exists; unintegrated counts commits no other branch has\n' "$BASE"
  [[ $rebasing -eq 1 ]] && printf 'rebasing        yes — resolve, git rebase --continue\n'
  printf 'uncommitted     %s\n' "$dirty"
  printf 'untracked       %s\n' "$untracked"
  printf 'unintegrated    %s%s\n' "$unintegrated" "$([[ $unintegrated -gt 0 ]] && echo '  (llm-wt integrate)')"
  printf 'behind base     %s%s\n' "$behind" "$([[ $behind -gt 0 ]] && echo '  (llm-wt sync)')"
  printf 'copies changed  %s\n' "${#changed[@]}"
  for p in ${changed[@]+"${changed[@]}"}; do printf '                  %s\n' "$p"; done
  printf 'ignored extra   %s\n' "$ignored_extra"
}

# ── sync / integrate ─────────────────────────────────────────────────────

require_clean() {
  rebase_in_progress "$WT" \
    && die 5 "a rebase is in progress in $WT: resolve the conflicts, 'git rebase --continue', then run this again"
  [[ -z "$(git -C "$WT" status --porcelain -uno)" ]] \
    || die 3 "uncommitted changes in $WT: commit them first (only committed work is integrated)"
  local n
  n=$(git -C "$WT" status --porcelain | grep -c '^??' || true)
  [[ "$n" -gt 0 ]] && warn "$n untracked file(s) aren't committed and won't be included"
  return 0
}

# Rebase the worktree's branch onto the base branch. Exits 5 on conflict.
rebase_onto_base() {
  git -C "$WT" merge-base --is-ancestor "$BASE" HEAD && return 0
  if ! git -C "$WT" rebase --quiet "$BASE" >&2; then
    local files
    files=$(git -C "$WT" diff --name-only --diff-filter=U | sed 's/^/  /')
    die 5 "rebase onto '$BASE' stopped on conflicts in $WT:
$files
Resolve them there, 'git add' them, 'git rebase --continue', then run this again."
  fi
}

cmd_sync() {
  load_ctx "${1:-}"
  require_clean
  rebase_onto_base
  printf 'up to date with %s; %s commit(s) not yet integrated\n' \
    "$BASE" "$(git -C "$WT" rev-list --count "$BASE..HEAD")"
}

cmd_integrate() {
  local path="" remove=false a
  for a in "$@"; do
    case "$a" in --remove) remove=true ;; *) path="$a" ;; esac
  done
  integrate_into_base "$path"
  # Landed (or nothing to land): --remove drops the worktree and branch. It
  # still refuses if something would be lost (untracked files, say).
  if $remove; then cmd_remove "$WT"; fi
}

integrate_into_base() {
  load_ctx "${1:-}"
  require_clean
  local cur out old
  cur=$(git -C "$PRIMARY" branch --show-current 2>/dev/null) || cur=""
  [[ "$cur" == "$BASE" ]] \
    || die 4 "the main directory ($PRIMARY) is on '${cur:-a detached HEAD}', not '$BASE'; ask the user"

  for _ in 1 2 3; do
    rebase_onto_base
    if [[ "$(git -C "$WT" rev-list --count "$BASE..HEAD")" -eq 0 ]]; then
      echo "nothing to integrate: $BRANCH has no commits beyond $BASE"
      return 0
    fi
    old=$(git -C "$PRIMARY" rev-parse HEAD)
    if out=$(git -C "$PRIMARY" merge --ff-only --quiet "$BRANCH" 2>&1); then
      echo "integrated into $BASE:"
      git -C "$PRIMARY" log --oneline "$old..HEAD"
      return 0
    fi
    # Base moved under us (another agent integrated): rebase again.
    git -C "$WT" merge-base --is-ancestor "$BASE" HEAD || continue
    if [[ "$out" == *"would be overwritten"* ]]; then
      die 7 "the main directory has uncommitted changes to files this integration touches; nothing was changed. Tell the user:
$out"
    fi
    die 1 "git merge --ff-only failed in $PRIMARY:
$out"
  done
  die 6 "'$BASE' kept moving during 3 attempts; run integrate again"
}

# ── close / remove ───────────────────────────────────────────────────────

has_tty() { { : < /dev/tty; } 2>/dev/null; }

# Ask what happens to a worktree whose last pane is closing (spec §8), and
# reconcile changed copies when the answer is "remove". Prints the decision:
# remove, keep or cancel. --default prints the preselected answer without
# asking. With no terminal to ask on, the answer is keep: nothing is lost.
cmd_close() {
  local path="" only_default=false a
  for a in "$@"; do
    case "$a" in --default) only_default=true ;; *) path="$a" ;; esac
  done
  load_ctx "$path"
  local st key val dirty=0 untracked=0 unintegrated=0 ignored=0
  local -a changed=()
  st=$(cmd_status "$WT" --porcelain)
  while IFS=$'\t' read -r key val; do
    case "$key" in
      dirty) dirty=$val ;;
      untracked) untracked=$val ;;
      unintegrated) unintegrated=$val ;;
      ignored-extra) ignored=$val ;;
      copy-changed) changed+=("$val") ;;
    esac
  done <<< "$st"

  # The warning must stand out (fzf --ansi renders these): what can't be
  # recovered in bold red, commits that llm-wt integrate would still save in
  # bold yellow, the rest dim.
  local b=$'\033[1m' red=$'\033[1;31m' yel=$'\033[1;33m' grn=$'\033[1;32m' dim=$'\033[2m' rst=$'\033[0m'
  local loss=false header lines=""
  header="${b}Closing the last pane in worktree ${BRANCH}${rst} ${dim}(base ${BASE})${rst}"
  if [[ $dirty -gt 0 ]]; then loss=true; lines+=$'\n'"  ${red}✗ ${dirty} uncommitted change(s)${rst}"; fi
  if [[ $untracked -gt 0 ]]; then loss=true; lines+=$'\n'"  ${red}✗ ${untracked} untracked file(s)${rst}"; fi
  if [[ ${#changed[@]} -gt 0 ]]; then
    loss=true
    lines+=$'\n'"  ${red}✗ changed copies: $(IFS=,; printf '%s' "${changed[*]}" | sed 's/,/, /g')${rst}"
  fi
  if [[ $unintegrated -gt 0 ]]; then
    loss=true
    lines+=$'\n'"  ${yel}⚠ ${unintegrated} commit(s) not integrated into ${BASE}${rst} ${dim}— llm-wt integrate keeps them${rst}"
  fi
  if $loss; then
    header+=$'\n\n'"${red}⚠ REMOVING THIS WORKTREE WOULD LOSE:${rst}${lines}"
  else
    header+=$'\n\n'"${grn}✓ Nothing would be lost: everything is integrated.${rst}"
  fi
  [[ $ignored -gt 0 ]] && header+=$'\n'"  ${dim}${ignored} ignored path(s) (deps, build output) go with it${rst}"

  local -a opts
  if $loss; then
    opts=("Keep worktree (it stays in the Worktrees tab)" "${red}Remove worktree and branch — loses the above${rst}" "Cancel")
  else
    opts=("Remove worktree and branch" "Keep worktree (it stays in the Worktrees tab)" "Cancel")
  fi
  if $only_default || ! has_tty || ! command -v fzf >/dev/null 2>&1; then
    if $only_default; then
      case "${opts[0]}" in Remove*) echo remove ;; *) echo keep ;; esac
    else
      warn "no terminal to ask on: keeping $WT"
      echo keep
    fi
    return 0
  fi

  local choice
  choice=$(printf '%s\n' "${opts[@]}" | fzf --ansi --height=100% --reverse --border=rounded \
    --header="$header" --prompt="worktree> " --no-info || true)
  case "$choice" in
    Remove*) ;;
    Keep*) echo keep; return 0 ;;
    *) echo cancel; return 0 ;;
  esac

  local p ans
  for p in ${changed[@]+"${changed[@]}"}; do
    while :; do
      ans=$(printf '%s\n' "discard" "copy back to the main directory" "show diff" | fzf --height=100% \
        --reverse --border=rounded --header="$p differs from the copy it started as. Before removing:" \
        --prompt="$p> " --no-info || true)
      case "$ans" in
        "show diff")
          diff -ru "$PRIMARY/$p" "$WT/$p" 2>&1 | "${PAGER:-less}" > /dev/tty || true ;;
        "copy back"*)
          rm -rf "${PRIMARY:?}/$p"
          cp -a "$WT/$p" "$PRIMARY/$p"
          break ;;
        discard) break ;;
        *) echo cancel; return 0 ;;
      esac
    done
  done
  echo remove
}

# Delete a pane worktree and its branch (the branch's config goes with it).
# Refuses when anything would be lost, unless --force.
cmd_remove() {
  local path="" force=no a
  for a in "$@"; do
    case "$a" in --force) force=yes ;; *) path="$a" ;; esac
  done
  load_ctx "$path"
  # Locked: deleting the branch rewrites the shared .git/config.
  lock_repo "$WT"
  if [[ "$force" == no ]]; then
    local st
    st=$(cmd_status "$WT" --porcelain)
    if grep -qE $'^(dirty|untracked|unintegrated|copies-changed|rebasing)\t[1-9]' <<< "$st"; then
      die 1 "$WT has work that would be lost, or a rebase in progress (llm-wt status $WT): integrate it with llm-wt integrate, or use llm-wt remove --force to drop it"
    fi
  fi
  # The branch goes with -D, from here: the status check above already proved
  # nothing is unintegrated (or --force said to drop it). `git branch -d`
  # would judge "merged" against the main directory's HEAD, which isn't the
  # base when this worktree's parent is itself a worktree (nested).
  local branch="$BRANCH" keep="$PRIMARY"
  # Explicit checks: callers may run this with set -e off (f || …), and the
  # branch must never go when its worktree didn't.
  if ! lazy_llm_cleanup_worktree "$WT" no "$force"; then
    die 1 "could not remove $WT; its branch $branch is kept"
  fi
  git -C "$keep" branch -D "$branch" >&2 || warn "could not delete branch $branch"
  unlock_repo
}

# ── main ─────────────────────────────────────────────────────────────────

usage() { sed -n '2,/^$/{s/^# \{0,1\}//;p}' "$0"; }

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
  info) cmd_info "$@" ;;
  status) cmd_status "$@" ;;
  sync) cmd_sync "$@" ;;
  integrate) cmd_integrate "$@" ;;
  list) cmd_list "$@" ;;
  claude-hook) cmd_claude_hook "$@" ;;
  __claude-hook-run) cmd_claude_hook_run "$@" ;;
  create) cmd_create "$@" ;;
  default-name) cmd_default_name "$@" ;;
  bootstrap) cmd_bootstrap "$@" ;;
  close) cmd_close "$@" ;;
  remove) cmd_remove "$@" ;;
  -h | --help | help | "") usage ;;
  *) die 1 "unknown command: $cmd (see llm-wt --help)" ;;
esac
