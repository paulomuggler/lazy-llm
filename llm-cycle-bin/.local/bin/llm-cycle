#!/usr/bin/env bash
# llm-cycle - Cycle between AI panes in a lazy-llm workspace
# Usage: llm-cycle [next|prev|N]
#
# Swaps the currently visible AI pane with the next/prev/Nth one from the
# hidden holding window using tmux swap-pane.

set -euo pipefail

# Source shared library for pane resolution
source "$(dirname "$0")/lazy-llm-lib.sh"

DIRECTION="${1:-next}"

# Resolve current pane context
lazy_llm_resolve_pane || { echo "Error: llm-cycle must be run inside a tmux session" >&2; exit 1; }
lazy_llm_resolve_session_window || { echo "Error: Could not determine session/window" >&2; exit 1; }

# Read multi-pane state
lazy_llm_read_multi_state

if [ -z "$AI_PANES" ]; then
  echo "Error: No @AI_PANES set. Is this a lazy-llm workspace?" >&2
  exit 1
fi

# Prune stale panes and validate holding window
lazy_llm_prune_stale_panes
lazy_llm_validate_hold_win

# Parse into arrays
read -ra pane_arr <<< "$AI_PANES"
read -ra tool_arr <<< "$AI_TOOLS"
current_idx="${AI_PANE_IDX:-0}"
total=${#pane_arr[@]}

# No-op if only one pane (or none) remains
if [ "$total" -le 1 ]; then
  exit 0
fi

# Calculate target index
case "$DIRECTION" in
  next)
    target_idx=$(( (current_idx + 1) % total ))
    ;;
  prev)
    target_idx=$(( (current_idx - 1 + total) % total ))
    ;;
  [0-9]*)
    target_idx="$DIRECTION"
    if [ "$target_idx" -ge "$total" ] || [ "$target_idx" -lt 0 ]; then
      echo "Error: Index $target_idx out of range (0-$((total - 1)))" >&2
      exit 1
    fi
    ;;
  *)
    echo "Usage: llm-cycle [next|prev|N]" >&2
    exit 1
    ;;
esac

# No-op if same index
if [ "$target_idx" -eq "$current_idx" ]; then
  exit 0
fi

# Save the currently focused pane so we can restore focus after the swap
# (lazy_llm_cycle_to_index leaves selection on the target pane; llm-cycle's own
# contract is to keep the caller's focus where it was).
original_pane="$_CURRENT_PANE"

# Swap + state-update logic is shared with the dashboard's cross-workspace pane
# switch — see lazy_llm_cycle_to_index in lazy-llm-lib.sh (single source of truth).
lazy_llm_cycle_to_index "$_SESSION" "$_WINDOW" "$target_idx"

tmux select-pane -t "$original_pane"
