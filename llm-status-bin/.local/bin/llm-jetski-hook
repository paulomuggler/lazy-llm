#!/usr/bin/env bash
# llm-jetski-hook - Jetski CLI hook handler feeding lazy-llm's pane status
#
# The Jetski counterpart of llm-claude-hook. Wired by lazy-llm's own Jetski
# plugin (jetski-plugin/hooks.json, linked into ~/.gemini/config/plugins/ by
# install.sh), whose hooks call this script directly — it's stowed into
# ~/.local/bin like every other lazy-llm command, so edits take effect at once.
#
# Usage: llm-jetski-hook <state>   (hook payload JSON on stdin)
#
# What each event does (Jetski hook payloads carry no event name, so the plugin
# passes <state> per event):
#   PreInvocation  <state> "working": fires before every model call of a turn,
#                  so a long turn keeps its status file fresh. Clears the pane's
#                  unread mark on a turn's first call (invocationNum 0: you
#                  just prompted it).
#                  In an isolated pane (LAZY_LLM_WORKTREE=1, set by llm-add -i)
#                  the turn's first call also gets the worktree guidance
#                  (share/lazy-llm/worktree-agent.md) as an ephemeral message.
#   Stop           <state> "idle": marks the pane unread (◉ — finished, not
#                  looked at yet; lazy_llm_mark_unread skips a pane you're
#                  focused on) and, on the same condition, fires a "finished"
#                  desktop notification with the reply's opening line.
#   Subagent executions (non-empty parentConversationId) fire the same hooks
#   from the same process; they're ignored — they don't speak for the pane.
#   (every event)  records `conversationId` as the pane's conversation, for
#                  `lazy-llm restore` (resumed with `jetski-cli --conversation`),
#                  saving the workspace manifest when it changes; and
#                  `modelName` as the pane's model, for the pane border.
#
# Jetski has no permission-prompt event, so this never writes "waiting":
# lazy_llm_detect_pane_status cross-checks a fresh "working" against the
# screen scrape, which does see the "Allow" dialog.
#
# Output contract: Jetski reads a JSON object from every hook's stdout, so this
# always prints one ({} or the PreInvocation injectSteps; Stop's decision is
# "allow" — never "continue", which would keep the agent running).
# Silent no-op outside tmux (TMUX_PANE unset, e.g. the Jetski desktop app, which
# reads the same ~/.gemini/config). Always exits 0: never fail Jetski's flow.

STATE="${1:-}"
PANE_ID="${TMUX_PANE:-}"

reply() {
  local out="${1:-}"
  [ -n "$out" ] || out='{}'
  [ "$STATE" = idle ] && out='{"decision":"allow"}'
  printf '%s\n' "$out"
  exit 0
}

[ -z "$PANE_ID" ] && reply

# shellcheck source=/dev/null
source "$(dirname "$0")/lazy-llm-lib.sh" 2>/dev/null || reply

HOOK_INPUT=$(cat 2>/dev/null)

# Debugging aid: LAZY_LLM_HOOK_LOG=<file> in the environment jetski-cli is
# launched from appends every payload received, one JSON object per line.
[ -n "${LAZY_LLM_HOOK_LOG:-}" ] && printf '# %s\n%s\n' "$STATE" "$HOOK_INPUT" >> "$LAZY_LLM_HOOK_LOG" 2>/dev/null

# Only the pane's own jetski speaks for the pane. A jetski started from inside
# it (e.g. `jetski -p` run by the agent's own shell tool) inherits TMUX_PANE
# and fires these hooks too, with its own conversation. So walk up from this
# hook (jetski runs hooks through `sh -c`) to the pane's shell: the first jetski
# met must be the pane's own, i.e. only jetski processes (the CLI may run
# helpers of its own) between it and the pane's shell. A shell or anything else
# in between means a jetski launched from a command inside the pane: ignore.
# Never reaching the pane's shell means the hook isn't running under the pane
# at all (run by hand, or by a test): handle it.
spawned_by_nested_jetski() {
  local pane_pid pid="$PPID" ppid comm seen_jetski=false gap=false
  pane_pid=$(tmux display-message -t "$PANE_ID" -p '#{pane_pid}' 2>/dev/null) || return 1
  [ -n "$pane_pid" ] || return 1
  for _ in $(seq 1 24); do
    [ -n "$pid" ] && [ "$pid" -gt 1 ] || return 1
    if [ "$pid" = "$pane_pid" ]; then
      $seen_jetski && $gap && {
        [ -n "${LAZY_LLM_HOOK_LOG:-}" ] && printf '# nested jetski under pane_pid %s: ignored\n' "$pane_pid" >> "$LAZY_LLM_HOOK_LOG"
        return 0
      }
      return 1
    fi
    comm=$(ps -o comm= -p "$pid" 2>/dev/null)
    ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    case "${comm##*/}" in
      jetski*) seen_jetski=true ;;
      *) $seen_jetski && gap=true ;;
    esac
    pid="$ppid"
  done
  return 1
}
spawned_by_nested_jetski && reply

# Subagents run inside the same jetski process and fire the same hooks, with
# their own conversationId and a parentConversationId naming the pane's. Their
# Stop is not the pane's (the parent is still working), nor is their
# conversation the one to resume: only top-level executions speak for the pane.
if printf '%s' "$HOOK_INPUT" | grep -qE '"parentConversationId"[[:space:]]*:[[:space:]]*"[^"]+"'; then
  reply
fi

# First "<name>": "<string>" value in the payload (no jq dependency).
field() {
  printf '%s' "$HOOK_INPUT" \
    | grep -oE "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 \
    | sed -E 's/.*:[[:space:]]*"([^"]*)"$/\1/'
}

# First "<name>": <number> value in the payload.
num_field() {
  printf '%s' "$HOOK_INPUT" \
    | grep -oE "\"$1\"[[:space:]]*:[[:space:]]*[0-9]+" | head -1 \
    | grep -oE '[0-9]+$'
}

json_escape() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/}
  s=${s//$'\n'/\\n}
  printf '%s' "$s"
}

notify() {
  local title="$1" body="$2"
  if command -v notify-send >/dev/null 2>&1; then
    body=${body//&/"&amp;"}
    body=${body//</"&lt;"}
    body=${body//>/"&gt;"}
    notify-send -a lazy-llm -u normal -t 8000 "$title" "$body" >/dev/null 2>&1 &
  elif command -v osascript >/dev/null 2>&1; then
    title=${title//\\/\\\\}
    title=${title//\"/\\\"}
    body=${body//\\/\\\\}
    body=${body//\"/\\\"}
    osascript -e "display notification \"$body\" with title \"$title\"" >/dev/null 2>&1 &
  fi
}

# Where the pane is: tmux session:window, pane label, directory.
pane_where() {
  local where sw panes names p idx=0 label cwd
  sw=$(tmux display-message -t "$PANE_ID" -p '#S:#I' 2>/dev/null)
  where=${sw:-$PANE_ID}
  panes=$(tmux show-option -wv -t "$sw" @AI_PANES 2>/dev/null)
  names=$(tmux show-option -wv -t "$sw" @AI_PANE_NAMES 2>/dev/null)
  for p in $panes; do
    if [ "$p" = "$PANE_ID" ]; then
      label=$(lazy_llm_pane_display_label jetski-cli "$names" "$idx")
      [ "$label" != jetski-cli ] && where="$where · $label"
      break
    fi
    idx=$((idx + 1))
  done
  cwd=$(tmux display-message -t "$PANE_ID" -p '#{pane_current_path}' 2>/dev/null)
  [ -n "$cwd" ] && where="$where · ${cwd/#$HOME/\~}"
  printf '%s' "$where"
}

# The opening line of the turn's final reply (Stop's finalModelOutput),
# markdown stripped. jq reads the string in full; without it, field() stops at
# the first escaped quote, which still leaves a usable opening.
reply_headline() {
  local text line
  if command -v jq >/dev/null 2>&1; then
    text=$(printf '%s' "$HOOK_INPUT" | jq -r '.finalModelOutput // empty' 2>/dev/null)
  else
    text=$(field finalModelOutput)
    text=${text//\\n/$'\n'}
  fi
  while IFS= read -r line; do
    line=$(printf '%s' "$line" | sed -E 's/^[[:space:]]*([#>*-]+[[:space:]]*)+//; s/\*\*|`//g')
    if [ -n "${line//[[:space:]]/}" ]; then
      [ "${#line}" -gt 160 ] && line="${line:0:159}…"
      printf '%s' "$line"
      return 0
    fi
  done <<<"$text"
}

notify_finished() {
  local title dir
  dir=$(tmux display-message -t "$PANE_ID" -p '#{pane_current_path}' 2>/dev/null)
  title="Jetski finished: ${dir##*/}"
  local headline
  headline=$(reply_headline)
  notify "$title" "${headline:-Done}"$'\n'"$(pane_where)"
}

STATUS_DIR="$HOME/.cache/lazy-llm/status"
write_status() {
  mkdir -p "$STATUS_DIR" 2>/dev/null || return 0
  printf '%s %s\n' "$1" "$(date +%s)" > "$STATUS_DIR/$PANE_ID" 2>/dev/null
  find "$STATUS_DIR" -type f -mtime +1 -delete 2>/dev/null
}

# Worktree guidance for an isolated pane, as a PreInvocation injectSteps reply.
# Placeholders: {{path}} {{branch}} {{base}} {{primary}}.
worktree_injection() {
  [ "${LAZY_LLM_WORKTREE:-}" = 1 ] || return 0
  local guide text wt branch
  guide="$(dirname "$0")/../share/lazy-llm/worktree-agent.md"
  [ -f "$guide" ] || return 0
  wt=$(git rev-parse --show-toplevel 2>/dev/null) || wt="$PWD"
  branch=$(git -C "$wt" branch --show-current 2>/dev/null)
  text=$(cat "$guide")
  text=${text//"{{path}}"/$wt}
  text=${text//"{{branch}}"/$branch}
  text=${text//"{{base}}"/${LAZY_LLM_BASE_BRANCH:-}}
  text=${text//"{{primary}}"/${LAZY_LLM_PRIMARY_DIR:-}}
  printf '{"injectSteps":[{"ephemeralMessage":"%s"}]}' "$(json_escape "$text")"
}

if lazy_llm_set_pane_conv "$PANE_ID" "$(field conversationId)"; then
  lazy_llm_save_async
fi
model=$(field modelName)
[ -n "$model" ] && lazy_llm_set_pane_model "$PANE_ID" "$model"

case "$STATE" in
  working)
    write_status working
    out=""
    # invocationNum counts model calls within one turn from 0: call 0 is the
    # one right after you sent a prompt. (Absent: treat as the first.)
    inv=$(num_field invocationNum)
    if [ -z "$inv" ] || [ "$inv" -eq 0 ]; then
      lazy_llm_clear_unread "$PANE_ID"
      out=$(worktree_injection)
    fi
    reply "$out"
    ;;
  idle)
    write_status idle
    lazy_llm_mark_unread "$PANE_ID"
    if ! lazy_llm_pane_is_focused "$PANE_ID"; then
      # Detached, fds closed: Jetski waits on this hook, not on the notification.
      notify_finished </dev/null >/dev/null 2>&1 &
    fi
    reply
    ;;
esac

reply
