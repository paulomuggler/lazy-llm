#!/usr/bin/env bash
# llm-status - AI pane status segment for tmux status-right
# Usage: llm-status
#
# A labeled "AI" chip, then one tile per AI pane (tool name, a real space,
# then a color-coded status glyph), the active pane highlighted with a
# filled background instead of bare brackets, then a dim "Prefix+S" hint.
#
# For use in tmux status-right: set -g status-right '#(llm-status)'
#
# Colors reuse this project's own tmux theme palette (see tmux.conf.local's
# tmux_conf_theme_colour_* table) rather than inventing a new one, so this
# segment reads as part of the same UI instead of a bolted-on afterthought:
#   colour_4  #00afff light blue — the "AI" chip (matches active-pane-border)
#   colour_5  #ffff00 yellow     — working (generating)
#   colour_10 #ff00af pink       — waiting (needs you)
#   colour_11 #5fff00 green      — idle (ready)
#   colour_3  #8a8a8a light gray — unknown / dim text
#
# Status glyphs:
#   ● working   ○ idle   ◐ waiting   ? unknown
#
# Output examples (tmux #[..] style codes, interpreted once substituted into
# status-right — same mechanism this script already relied on for #[bold]):
#   Single pane:  [AI] claude ●   Prefix+S
#   Multi pane:   [AI] (claude ●) gemini ◐   Prefix+S   (active pane filled)

set -euo pipefail

# Source shared library for pane resolution + status detection
source "$(dirname "$0")/lazy-llm-lib.sh"

readonly C_BG="#080808"
readonly C_CHIP="#00afff"
readonly C_CHIP_FG="#080808"
readonly C_ACTIVE_BG="#303030"
readonly C_TEXT="#e4e4e4"
readonly C_DIM="#8a8a8a"
readonly C_WORKING="#ffff00"
readonly C_WAITING="#ff00af"
readonly C_IDLE="#5fff00"
readonly C_UNKNOWN="#8a8a8a"

glyph_for() {
  case "$1" in
    working) printf '●' ;;
    idle)    printf '○' ;;
    waiting) printf '◐' ;;
    *)       printf '?' ;;
  esac
}

glyph_color() {
  case "$1" in
    working) printf '%s' "$C_WORKING" ;;
    waiting) printf '%s' "$C_WAITING" ;;
    idle)    printf '%s' "$C_IDLE" ;;
    *)       printf '%s' "$C_UNKNOWN" ;;
  esac
}

# Render one pane's tile. Args: tool status is-active(0|1)
render_tile() {
  local tool="$1" status="$2" active="$3"
  local color glyph
  color=$(glyph_color "$status")
  glyph=$(glyph_for "$status")
  if [ "$active" = "1" ]; then
    printf '#[fg=%s,bg=%s,bold] %s #[fg=%s,bg=%s,bold]%s#[fg=%s,bg=%s,nobold] ' \
      "$C_TEXT" "$C_ACTIVE_BG" "$tool" "$color" "$C_ACTIVE_BG" "$glyph" "$C_ACTIVE_BG" "$C_BG"
  else
    printf '#[fg=%s,bg=%s] %s #[fg=%s,bg=%s]%s#[default] ' \
      "$C_TEXT" "$C_BG" "$tool" "$color" "$C_BG" "$glyph"
  fi
}

emit() {
  local body="$1"
  printf '#[fg=%s,bg=%s,bold] AI #[fg=%s,bg=%s,nobold]#[fg=%s,bg=%s]%s#[fg=%s,bg=%s] Prefix+S #[default]\n' \
    "$C_CHIP_FG" "$C_CHIP" "$C_CHIP" "$C_BG" "$C_TEXT" "$C_BG" "$body" "$C_DIM" "$C_BG"
}

# Resolve pane context (exit silently on failure — status bar must not error)
lazy_llm_resolve_pane || exit 0
lazy_llm_resolve_session_window || exit 0

# Read multi-pane state
lazy_llm_read_multi_state

# Fall back to single-pane mode
if [ -z "$AI_PANES" ]; then
  AI_TOOL=$(tmux show-option -wv -t "$_SESSION:$_WINDOW" @AI_TOOL 2>/dev/null) || true
  if [ -n "$AI_TOOL" ]; then
    ai_pane_id=$(tmux show-option -wv -t "$_SESSION:$_WINDOW" @AI_PANE_ID 2>/dev/null) || ai_pane_id=""
    status="unknown"
    [ -n "$ai_pane_id" ] && status=$(lazy_llm_detect_pane_status "$ai_pane_id" "$AI_TOOL")
    emit "$(render_tile "$AI_TOOL" "$status" 1)"
  fi
  exit 0
fi

# Parse into arrays
read -ra pane_arr <<< "$AI_PANES"
read -ra tool_arr <<< "$AI_TOOLS"
current_idx="${AI_PANE_IDX:-0}"
total=${#tool_arr[@]}

# Single pane: simple tile
if [ "$total" -le 1 ]; then
  status=$(lazy_llm_detect_pane_status "${pane_arr[0]}" "${tool_arr[0]}")
  emit "$(render_tile "${tool_arr[0]}" "$status" 1)"
  exit 0
fi

# Multi pane: one tile per pane, active one filled
body=""
for i in "${!tool_arr[@]}"; do
  status=$(lazy_llm_detect_pane_status "${pane_arr[$i]}" "${tool_arr[$i]}")
  active=0
  [ "$i" -eq "$current_idx" ] && active=1
  body+=$(render_tile "${tool_arr[$i]}" "$status" "$active")
done
emit "$body"
