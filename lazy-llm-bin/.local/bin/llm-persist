#!/usr/bin/env bash
# llm-persist - save lazy-llm workspaces to a manifest and rebuild them after
# the tmux server dies. Reached as `lazy-llm save|restore|saved|forget`.
#
# The manifest is one JSON file per workspace under
#   ${LAZY_LLM_STATE_DIR:-${XDG_STATE_HOME:-~/.local/state}/lazy-llm}/workspaces/<id>.json
# holding everything lazy-llm keeps in tmux options that tmux itself can't
# bring back: which AI panes a workspace had (tools, display names, visible vs
# held), the conversation each pane was on, its prompt file and nvim
# snapshots, its fold state and dashboard position. Design and rationale:
# .agents/TODO/specs/workspace-save-restore.md.
#
# Retention rule (why a crash can't clobber the entries restore needs):
#   - every entry records the tmux server that last saw it live;
#   - save rewrites only live workspaces' files, never another server's;
#   - an entry whose workspace vanished under the SAME server is only marked
#     `gone`, and moved to closed/ once a later save still sees that server
#     alive 60s on — a save racing a dying server can mark, never drop;
#   - with no server running, save does nothing at all.
#
# Usage: see usage() below. find-dir <dir> is plumbing for the launcher.

set -euo pipefail

_lib_sibling="$(dirname "$0")/lazy-llm-lib.sh"
if [[ -f "$_lib_sibling" ]]; then
  # shellcheck source=/dev/null
  source "$_lib_sibling"
else
  # shellcheck source=/dev/null
  source "$(dirname "$0")/../../../llm-send-bin/.local/bin/lazy-llm-lib.sh"
fi

STATE="${LAZY_LLM_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/lazy-llm}"
WS_DIR="$STATE/workspaces"
CLOSED_DIR="$STATE/closed"
LOCK="$STATE/.lock"
PENDING="$STATE/.pending"
GONE_GRACE=60
CLOSED_RETENTION_DAYS=30
MANIFEST_VERSION=1

command -v jq >/dev/null 2>&1 || { echo "llm-persist: jq is required" >&2; exit 1; }

die() { echo "llm-persist: $*" >&2; exit 1; }

# ── lock ────────────────────────────────────────────────────────────────────

# mkdir-based (flock isn't on macOS). A lock whose holder is dead (e.g. left
# over from before a reboot) is taken over.
# Args: $1 "wait" (poll up to 10s) or "try" (return 1 at once if held)
lock_acquire() {
  mkdir -p "$STATE"
  local tries=0 holder
  while ! mkdir "$LOCK" 2>/dev/null; do
    holder=$(cat "$LOCK/pid" 2>/dev/null || true)
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$LOCK"
      continue
    fi
    # Holder crashed between mkdir and writing its pid.
    if [[ -z "$holder" ]] && [[ -n "$(find "$LOCK" -maxdepth 0 -mmin +1 2>/dev/null)" ]]; then
      rm -rf "$LOCK"
      continue
    fi
    [[ "$1" == "try" ]] && return 1
    tries=$((tries + 1))
    [[ $tries -ge 100 ]] && die "manifest locked by pid ${holder:-?}"
    sleep 0.1
  done
  echo $$ > "$LOCK/pid"
  trap lock_release EXIT
}

lock_release() {
  [[ "$(cat "$LOCK/pid" 2>/dev/null || true)" == "$$" ]] && rm -rf "$LOCK"
  trap - EXIT
}

# ── helpers ─────────────────────────────────────────────────────────────────

# The running tmux server's identity, or nothing when no server is up.
server_id() {
  tmux display-message -p '#{pid}-#{start_time}' 2>/dev/null || true
}

new_ws_id() {
  printf '%s-%04x%04x\n' "$(date +%Y%m%d%H%M%S)" "$RANDOM" "$RANDOM"
}

# Atomic write of stdin to $1.
write_file() {
  local dest="$1" tmp="$1.tmp.$$"
  cat > "$tmp"
  mv "$tmp" "$dest"
}

# Every readable manifest entry in $1 (dir), one path per line. Entries of an
# unknown format version are reported and skipped.
entry_files() {
  local dir="$1" f v
  [[ -d "$dir" ]] || return 0
  for f in "$dir"/*.json; do
    [[ -f "$f" ]] || continue
    v=$(jq -r '.version // empty' "$f" 2>/dev/null || true)
    if [[ "$v" != "$MANIFEST_VERSION" ]]; then
      echo "llm-persist: skipping $f (manifest version '${v:-?}', expected $MANIFEST_VERSION)" >&2
      continue
    fi
    printf '%s\n' "$f"
  done
}

# id<TAB>name of every live lazy-llm workspace (adopting ids as needed).
live_workspaces() {
  local name id
  while IFS=$'\t' read -r name _; do
    [[ -n "$name" ]] || continue
    id=$(tmux show-option -qv -t "=$name:" @lazy_llm_ws_id 2>/dev/null || true)
    if [[ -z "$id" ]]; then
      id=$(new_ws_id)
      tmux set-option -t "=$name:" @lazy_llm_ws_id "$id"
    fi
    printf '%s\t%s\n' "$id" "$name"
  done < <(lazy_llm_gather_sessions)
}

# RPC socket of the nvim running in a pane, if any. nvim 0.12 is a TUI
# client plus an `nvim --embed` server child; the socket is the server's
# ($XDG_RUNTIME_DIR/nvim.<pid>.0 on Linux, $TMPDIR/nvim.$USER/*/nvim.<pid>.0
# on macOS), so look two process levels down.
nvim_socket_for_pane() {
  local pane="$1" pid c gc cand
  pid=$(tmux display-message -t "$pane" -p '#{pane_pid}' 2>/dev/null) || return 0
  [[ -n "$pid" ]] || return 0
  for c in $(pgrep -P "$pid" 2>/dev/null); do
    for cand in "$c" $(pgrep -P "$c" 2>/dev/null); do
      [[ "$(ps -o comm= -p "$cand" 2>/dev/null)" == nvim ]] || continue
      for gc in "${XDG_RUNTIME_DIR:-/nonexistent}/nvim.$cand.0" "${TMPDIR:-/tmp}"/nvim."${USER:-}"/*/nvim."$cand".0; do
        [[ -S "$gc" ]] && { printf '%s\n' "$gc"; return 0; }
      done
    done
  done
  return 0
}

# Ask the nvim in a pane to write its rolling session snapshot (see
# nvim-session-plugin's lazy_llm.session). Covers nvims started before the
# plugin was installed; for the others it just refreshes what their own
# autosave keeps. Best effort, bounded by a 2s timeout.
nvim_snapshot() {
  local pane="$1" path="$2" sock
  sock=$(nvim_socket_for_pane "$pane")
  [[ -n "$sock" ]] || return 0
  lazy_llm_with_timeout 2 nvim --server "$sock" --remote-expr \
    "luaeval('require(\"lazy_llm.session\").snapshot(_A)', '${path//\'/\'\'}')" >/dev/null 2>&1 || true
}

# The prompt file a pre-feature prompt pane was opened on: the last *.md
# argument of the nvim running in it.
adopt_prompt_file() {
  local pane="$1" pid c arg=""
  pid=$(tmux display-message -t "$pane" -p '#{pane_pid}' 2>/dev/null) || return 0
  for c in $(pgrep -P "$pid" 2>/dev/null); do
    [[ "$(ps -o comm= -p "$c" 2>/dev/null)" == nvim ]] || continue
    arg=$(ps -o args= -p "$c" 2>/dev/null | tr ' ' '\n' | grep -E '\.md$' | tail -1 || true)
    [[ -n "$arg" ]] && break
  done
  printf '%s' "$arg"
}

# ── save ────────────────────────────────────────────────────────────────────

# JSON for one lazy-llm window. Adopts pre-feature windows (no snapshot
# paths yet) and asks both nvims for a snapshot.
# Args: $1 session  $2 window index  $3 position among the session's lazy-llm windows  $4 dir
window_json() {
  local name="$1" win="$2" pos="$3" dir="$4" target="=$1:$2"
  local editor_session prompt_session prompt_file prompt_pane visible_id suffix=""
  editor_session=$(tmux show-option -wqv -t "$target" @lazy_llm_editor_session)
  prompt_session=$(tmux show-option -wqv -t "$target" @lazy_llm_prompt_session)
  prompt_file=$(tmux show-option -wqv -t "$target" @lazy_llm_prompt_file)
  prompt_pane=$(tmux show-option -wqv -t "$target" @PROMPT_PANE_ID)
  visible_id=$(tmux show-option -wqv -t "$target" @AI_PANE_ID)

  if [[ -z "$editor_session" || -z "$prompt_session" ]]; then
    [[ "$pos" -gt 0 ]] && suffix="-$((pos + 1))"
    editor_session="$dir/.lazy-llm/sessions/editor${suffix}.vim"
    prompt_session="$dir/.lazy-llm/sessions/prompt${suffix}.vim"
    tmux set-option -w -t "$target" @lazy_llm_editor_session "$editor_session"
    tmux set-option -w -t "$target" @lazy_llm_prompt_session "$prompt_session"
    if [[ -z "$prompt_file" && -n "$prompt_pane" ]]; then
      prompt_file=$(adopt_prompt_file "$prompt_pane")
      tmux set-option -w -t "$target" @lazy_llm_prompt_file "$prompt_file"
    fi
  fi

  # The editor is the one pane that's neither the visible AI pane nor the prompt pane.
  local p editor_pane=""
  for p in $(tmux list-panes -t "$target" -F '#{pane_id}' 2>/dev/null); do
    [[ "$p" == "$visible_id" || "$p" == "$prompt_pane" ]] || editor_pane="$p"
  done
  [[ -n "$editor_pane" ]] && nvim_snapshot "$editor_pane" "$editor_session"
  [[ -n "$prompt_pane" ]] && nvim_snapshot "$prompt_pane" "$prompt_session"

  local -a pane_arr=() tool_arr=() name_arr=() panes_json=()
  read -ra pane_arr <<< "$(tmux show-option -wqv -t "$target" @AI_PANES)"
  read -ra tool_arr <<< "$(tmux show-option -wqv -t "$target" @AI_TOOLS)"
  read -ra name_arr <<< "$(tmux show-option -wqv -t "$target" @AI_PANE_NAMES)"
  local i tool pname visible=0 kept=0
  for i in "${!pane_arr[@]}"; do
    p="${pane_arr[$i]}"
    lazy_llm_validate_pane "$p" || continue
    [[ "$p" == "$visible_id" ]] && visible=$kept
    tool="${tool_arr[$i]:-claude}"
    pname="${name_arr[$i]:-_}"
    [[ "$pname" == "_" ]] && pname=""
    panes_json+=("$(jq -nc \
      --arg tool "$tool" --arg name "$pname" \
      --arg conv "$(lazy_llm_tool_conv "$tool" "$p")" \
      --arg model "$(lazy_llm_pane_model_raw "$p")" \
      --arg cwd "$(tmux display-message -t "$p" -p '#{pane_current_path}')" \
      'def n: if . == "" then null else . end;
       {tool: $tool, name: ($name|n), conv: ($conv|n), model: ($model|n), cwd: $cwd}')")
    kept=$((kept + 1))
  done
  [[ $kept -gt 0 ]] || return 0

  jq -nc --argjson visible "$visible" \
    --arg prompt_file "$prompt_file" --arg es "$editor_session" --arg ps "$prompt_session" \
    --argjson panes "$(printf '%s\n' "${panes_json[@]}" | jq -sc .)" \
    'def n: if . == "" then null else . end;
     {visible: $visible, prompt_file: ($prompt_file|n), editor_session: $es,
      prompt_session: $ps, panes: $panes}'
}

# Write workspaces/<id>.json for one live workspace.
# Args: $1 id  $2 session name  $3 order  $4 server id
save_workspace() {
  local id="$1" name="$2" order="$3" srv="$4"
  local dir collapsed win pos=0 wj
  local -a windows=()

  dir=$(tmux show-option -qv -t "=$name:" @lazy_llm_dir 2>/dev/null || true)
  if [[ -z "$dir" ]]; then
    # Pre-feature workspace: the launcher cd's the prompt pane into its dir.
    local first_win prompt_pane
    first_win=$(tmux list-windows -t "=$name" -F '#{window_index}	#{@AI_PANES}' | awk -F'\t' '$2 != "" {print $1; exit}')
    prompt_pane=$(tmux show-option -wqv -t "=$name:$first_win" @PROMPT_PANE_ID)
    dir=$(tmux display-message -t "${prompt_pane:-=$name:$first_win}" -p '#{pane_current_path}')
    tmux set-option -t "=$name:" @lazy_llm_dir "$dir"
  fi
  [[ "$(tmux show-option -qv -t "=$name:" @lazy_llm_collapsed 2>/dev/null || true)" == "1" ]] \
    && collapsed=true || collapsed=false

  while IFS=$'\t' read -r win _; do
    wj=$(window_json "$name" "$win" "$pos" "$dir")
    [[ -n "$wj" ]] && windows+=("$wj")
    pos=$((pos + 1))
  done < <(tmux list-windows -t "=$name" -F '#{window_index}	#{@AI_PANES}' | awk -F'\t' '$2 != ""')
  [[ ${#windows[@]} -gt 0 ]] || return 0

  mkdir -p "$WS_DIR"
  jq -n --argjson version "$MANIFEST_VERSION" --arg id "$id" --arg name "$name" \
    --arg dir "$dir" --argjson collapsed "$collapsed" --argjson order "$order" \
    --arg server "$srv" --argjson saved "$(date +%s)" \
    --argjson windows "$(printf '%s\n' "${windows[@]}" | jq -sc .)" \
    '{version: $version, id: $id, name: $name, dir: $dir, collapsed: $collapsed,
      order: $order, server: $server, saved: $saved, gone: null, windows: $windows}' \
    | write_file "$WS_DIR/$id.json"
}

# One pass of the save algorithm (spec §7.3). Prints the summary line.
save_pass() {
  local srv now live ordered ws_count=0 panes=0 convs=0 order id name f
  srv=$(server_id)
  [[ -n "$srv" ]] || { echo "lazy-llm: no tmux server running, nothing saved"; return 0; }
  now=$(date +%s)

  live=$(live_workspaces)
  # Dashboard order, as the tree shows it (no bash-4 associative arrays: macOS
  # ships bash 3.2).
  ordered=$(lazy_llm_apply_ws_order "$(lazy_llm_gather_sessions)" | cut -f1)

  while IFS=$'\t' read -r id name; do
    [[ -n "$id" ]] || continue
    order=$(grep -nxF "$name" <<< "$ordered" | head -1 | cut -d: -f1)
    save_workspace "$id" "$name" "$(( ${order:-1} - 1 ))" "$srv"
    [[ -f "$WS_DIR/$id.json" ]] || continue
    ws_count=$((ws_count + 1))
    panes=$((panes + $(jq '[.windows[].panes[]] | length' "$WS_DIR/$id.json")))
    convs=$((convs + $(jq '[.windows[].panes[] | select(.conv != null)] | length' "$WS_DIR/$id.json")))
  done <<< "$live"

  # Entries that aren't live: another server's are left exactly as they are;
  # this server's are marked gone, then closed once the grace has passed.
  local e_id e_srv e_gone
  while IFS= read -r f; do
    read -r e_id e_srv e_gone < <(jq -r '[.id, .server, (.gone // "null")] | @tsv' "$f" | tr '\t' ' ')
    grep -q "^$e_id	" <<< "$live" && continue
    [[ "$e_srv" == "$srv" ]] || continue
    if [[ "$e_gone" == "null" ]]; then
      jq --argjson now "$now" '.gone = $now' "$f" | write_file "$f"
    elif (( now - e_gone >= GONE_GRACE )); then
      mkdir -p "$CLOSED_DIR"
      mv "$f" "$CLOSED_DIR/"
    fi
  done < <(entry_files "$WS_DIR")

  find "$CLOSED_DIR" -name '*.json' -mtime +"$CLOSED_RETENTION_DAYS" -delete 2>/dev/null || true
  echo "lazy-llm: saved $ws_count workspace$([[ $ws_count -eq 1 ]] || echo s), $convs/$panes conversations"
}

cmd_save() {
  local mode="${1:-}" summary
  if [[ "$mode" == "--async" ]]; then
    lock_acquire try || { mkdir -p "$STATE"; : > "$PENDING"; return 0; }
  else
    lock_acquire wait
    # Lets a server that predates Prefix+C-s pick up lazy-llm's bindings.
    [[ -n "$(server_id)" ]] && lazy_llm_register_tmux_integration
  fi
  summary=$(save_pass)
  if [[ -f "$PENDING" ]]; then
    rm -f "$PENDING"
    summary=$(save_pass)
  fi
  lock_release
  case "$mode" in
    --async) ;;
    --notify) tmux display-message "$summary" 2>/dev/null || true ;;
    *) printf '%s\n' "$summary" ;;
  esac
}

# ── forget ──────────────────────────────────────────────────────────────────

# Drop an entry from restore's view: workspaces/ → closed/. An entry already
# in closed/ is deleted for good.
cmd_forget() {
  local id="" name="" f
  case "${1:-}" in
    --id) id="${2:-}"; [[ -n "$id" ]] || die "forget --id needs an id" ;;
    "") die "usage: lazy-llm forget <name> | --id <id>" ;;
    *) name="$1" ;;
  esac
  lock_acquire wait

  if [[ -z "$id" ]]; then
    local -a matches=()
    local live_ids
    live_ids=$(live_workspaces | cut -f1)
    while IFS= read -r f; do
      [[ "$(jq -r .name "$f")" == "$name" ]] || continue
      grep -qxF "$(jq -r .id "$f")" <<< "$live_ids" && continue
      matches+=("$f")
    done < <(entry_files "$WS_DIR"; entry_files "$CLOSED_DIR")
    [[ ${#matches[@]} -gt 0 ]] || die "no saved workspace named '$name' (live ones are killed with 'lazy-llm kill')"
    [[ ${#matches[@]} -eq 1 ]] || die "several saved workspaces named '$name'; use --id (see 'lazy-llm saved')"
    id=$(jq -r .id "${matches[0]}")
  fi

  if [[ -f "$WS_DIR/$id.json" ]]; then
    mkdir -p "$CLOSED_DIR"
    mv "$WS_DIR/$id.json" "$CLOSED_DIR/$id.json"
    echo "Forgot workspace $(jq -r .name "$CLOSED_DIR/$id.json") ($id)"
  elif [[ -f "$CLOSED_DIR/$id.json" ]]; then
    local gone_name
    gone_name=$(jq -r .name "$CLOSED_DIR/$id.json")
    rm -f "$CLOSED_DIR/$id.json"
    echo "Deleted closed workspace $gone_name ($id)"
  else
    die "no saved workspace with id '$id'"
  fi
  lock_release
}

# ── entry states ────────────────────────────────────────────────────────────

# live       its id is a running session's @lazy_llm_ws_id
# restorable not live, and last seen by another (dead) server — or no server
#            is running at all
# closed     not live, closed during this server's lifetime (same server), or
#            in closed/ (forgotten / closed and dropped)
# Args: $1 entry file  $2 live ids (newline list)  $3 current server id
entry_state() {
  local f="$1" live_ids="$2" srv="$3" id server
  read -r id server < <(jq -r '[.id, .server] | @tsv' "$f" | tr '\t' ' ')
  if [[ -n "$live_ids" ]] && grep -qxF "$id" <<< "$live_ids"; then
    echo live
  elif [[ "$f" == "$CLOSED_DIR/"* ]]; then
    echo closed
  elif [[ -n "$srv" && "$server" == "$srv" ]]; then
    echo closed
  else
    echo restorable
  fi
}

ago() {
  local s=$(( $(date +%s) - $1 ))
  if (( s < 90 )); then echo "${s}s ago"
  elif (( s < 5400 )); then echo "$((s / 60))m ago"
  elif (( s < 172800 )); then echo "$((s / 3600))h ago"
  else echo "$((s / 86400))d ago"; fi
}

# ── saved ───────────────────────────────────────────────────────────────────

# Human listing, or (--tsv) one machine row per entry for the dashboard:
#   state id name dir panes held convs saved_epoch   (tab-separated)
# live entries first (dashboard order), then restorable, then closed.
cmd_saved() {
  local verbose=false tsv=false with_closed=false only_id="" f
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v) verbose=true ;;
      --tsv) tsv=true ;;
      --closed) with_closed=true ;;
      --id) only_id="${2:-}"; shift ;;
      *) die "unknown option for saved: $1" ;;
    esac
    shift
  done
  local srv live_ids
  srv=$(server_id)
  live_ids=""
  [[ -n "$srv" ]] && live_ids=$(live_workspaces | cut -f1)

  local rows="" state rank
  while IFS= read -r f; do
    state=$(entry_state "$f" "$live_ids" "$srv")
    [[ "$state" == closed && "$with_closed" == false && -z "$only_id" ]] && continue
    case "$state" in live) rank=0 ;; restorable) rank=1 ;; *) rank=2 ;; esac
    rows+=$(jq -r --arg state "$state" --arg rank "$rank" \
      '[$rank, (.order|tostring), $state, .id, .name, .dir,
        ([.windows[].panes[]] | length | tostring),
        ([.windows[] | (.panes | length) - 1] | add | tostring),
        ([.windows[].panes[] | select(.conv != null)] | length | tostring),
        (.saved|tostring)] | @tsv' "$f")$'\n'
  done < <(entry_files "$WS_DIR"; entry_files "$CLOSED_DIR")
  rows=$(printf '%s' "$rows" | grep . | sort -t$'\t' -k1,1n -k2,2n | cut -f3- || true)
  [[ -n "$only_id" ]] && rows=$(awk -F'\t' -v id="$only_id" '$2 == id' <<< "$rows")

  if $tsv; then
    [[ -n "$rows" ]] && printf '%s\n' "$rows"
    return 0
  fi
  if [[ -z "$rows" ]]; then
    echo "No saved lazy-llm workspaces."
    return 0
  fi
  local id name dir panes held convs saved glyph file
  while IFS=$'\t' read -r state id name dir panes held convs saved; do
    case "$state" in live) glyph="●" ;; restorable) glyph="◌" ;; *) glyph="✕" ;; esac
    printf '%s %-24s %-40s %s AI pane%s (%s held)  %s/%s conversations  saved %s\n' \
      "$glyph" "$name" "${dir/#$HOME/\~}" "$panes" "$([[ $panes -eq 1 ]] || echo s)" \
      "$held" "$convs" "$panes" "$(ago "$saved")"
    $verbose || continue
    file="$WS_DIR/$id.json"
    [[ -f "$file" ]] || file="$CLOSED_DIR/$id.json"
    jq -r --arg home "$HOME" '
      def short: if . == null then "-" else sub("^" + $home; "~") end;
      "    id \(.id)  state '"$state"'",
      (.windows | to_entries[] |
        "    window \(.key + 1): prompt file \(.value.prompt_file | short)",
        "      editor snapshot \(.value.editor_session | short)",
        "      prompt snapshot \(.value.prompt_session | short)",
        (.value.visible as $v | .value.panes | to_entries[] |
          "      pane \(.key + 1) \(if .key == $v then "visible" else "held   " end)  \(.value.tool)  \(.value.name // "-")  conv \(.value.conv // "-")  model \(.value.model // "-")  cwd \(.value.cwd | short)"))' "$file"
  done <<< "$rows"
}

# ── find-dir ────────────────────────────────────────────────────────────────

# Restorable entries for a dir (realpath comparison), for the launcher's
# "restore instead?" prompt. Prints: id<TAB>name<TAB>summary
cmd_find_dir() {
  local want f real srv live_ids
  want=$(realpath "${1:?usage: llm-persist find-dir <dir>}" 2>/dev/null || printf '%s' "$1")
  srv=$(server_id)
  live_ids=""
  [[ -n "$srv" ]] && live_ids=$(live_workspaces | cut -f1)
  while IFS= read -r f; do
    [[ "$(entry_state "$f" "$live_ids" "$srv")" == restorable ]] || continue
    real=$(realpath "$(jq -r .dir "$f")" 2>/dev/null || jq -r .dir "$f")
    [[ "$real" == "$want" ]] || continue
    jq -r --arg ago "$(ago "$(jq -r .saved "$f")")" '
      ([.windows[].panes[]] | length) as $n |
      ([.windows[].panes[] | select(.conv != null)] | length) as $c |
      [.id, .name, "\($n) AI pane\(if $n == 1 then "" else "s" end), \($c) conversation\(if $c == 1 then "" else "s" end), saved \($ago)"] | @tsv' "$f"
  done < <(entry_files "$WS_DIR")
}

# ── restore ─────────────────────────────────────────────────────────────────

# Session name for a restored workspace: its saved name, or the launcher's
# de-dup (name-2, name-3, ...) when a live session already has it. Exact
# matches only (=name): tmux's own prefix matching would treat "ws-2" as ws.
free_session_name() {
  local base="$1" name="$1" n=2
  while tmux has-session -t "=$name" 2>/dev/null; do
    name="$base-$n"
    n=$((n + 1))
  done
  printf '%s\n' "$name"
}

# The command typed into an AI pane: the tool adapter's launch command, run
# from the pane's own cwd when that differs from the workspace dir (claude
# looks conversations up under the project dir).
pane_launch_cmd() {
  local pane_json="$1" dir="$2" tool conv model cwd cmd
  tool=$(jq -r .tool <<< "$pane_json")
  conv=$(jq -r '.conv // ""' <<< "$pane_json")
  model=$(jq -r '.model // ""' <<< "$pane_json")
  cwd=$(jq -r '.cwd // ""' <<< "$pane_json")
  cmd=$(lazy_llm_tool_launch_cmd "$tool" "$conv" "$model")
  if [[ -n "$cwd" && "$cwd" != "$dir" && -d "$cwd" ]]; then
    cmd="cd '${cwd//\'/\'\\\'\'}' && $cmd"
  fi
  printf '%s\n' "$cmd"
}

# Record a restored pane's conversation and model against its new pane id.
# True by construction (the pane was launched resuming exactly these), and it
# keeps the save that follows a restore from writing the conversations off as
# unknown before the tool's own hook has reported in.
seed_pane() {
  local pane_id="$1" pane_json="$2" conv model
  conv=$(jq -r '.conv // ""' <<< "$pane_json")
  model=$(jq -r '.model // ""' <<< "$pane_json")
  [[ -n "$conv" ]] && { lazy_llm_set_pane_conv "$pane_id" "$conv" || true; }
  [[ -n "$model" ]] && lazy_llm_set_pane_model "$pane_id" "$model"
  return 0
}

# Rebuild one workspace from its manifest entry. Prints the session name.
# Args: $1 entry file
restore_one() {
  local f="$1" name dir id session win nwin w
  name=$(jq -r .name "$f")
  dir=$(jq -r .dir "$f")
  id=$(jq -r .id "$f")
  session=$(free_session_name "$name")

  tmux new-session -d -s "$session" -n dev -c "$dir"
  tmux set-option -t "=$session:" @lazy_llm_ws_id "$id"
  tmux set-option -t "=$session:" @lazy_llm_dir "$dir"
  win=$(tmux list-windows -t "=$session" -F '#{window_index}' | head -1)

  nwin=$(jq '.windows | length' "$f")
  for ((w = 0; w < nwin; w++)); do
    local wj npanes p pj names="" any_name=false visible
    wj=$(jq -c ".windows[$w]" "$f")
    [[ $w -gt 0 ]] && win=$(tmux new-window -d -t "=$session:" -n dev -c "$dir" -P -F '#{window_index}')
    tmux set-option -w -t "=$session:$win" @lazy_llm_editor_session "$(jq -r .editor_session <<< "$wj")"
    tmux set-option -w -t "=$session:$win" @lazy_llm_prompt_session "$(jq -r .prompt_session <<< "$wj")"

    pj=$(jq -c '.panes[0]' <<< "$wj")
    lazy_llm_build_window "$session" "$win" "$dir" "$(jq -r .tool <<< "$pj")" \
      "$(pane_launch_cmd "$pj" "$dir")" "$(jq -r '.prompt_file // ""' <<< "$wj")" restore
    seed_pane "$(tmux show-option -wqv -t "=$session:$win" @AI_PANE_ID)" "$pj"
    npanes=$(jq '.panes | length' <<< "$wj")
    for ((p = 1; p < npanes; p++)); do
      pj=$(jq -c ".panes[$p]" <<< "$wj")
      seed_pane "$(lazy_llm_add_ai_pane "$session" "$win" "$dir" "$(jq -r .tool <<< "$pj")" \
        "$(pane_launch_cmd "$pj" "$dir")")" "$pj"
    done

    names=$(jq -r '[.panes[] | .name // "_"] | join(" ")' <<< "$wj")
    [[ "$names" =~ [^_\ ] ]] && any_name=true
    $any_name && tmux set-option -w -t "=$session:$win" @AI_PANE_NAMES "$names"

    visible=$(jq -r '.visible // 0' <<< "$wj")
    [[ "$visible" -gt 0 ]] && lazy_llm_cycle_to_index "$session" "$win" "$visible"
  done
  [[ "$(jq -r .collapsed "$f")" == "true" ]] && tmux set-option -t "=$session:" @lazy_llm_collapsed 1
  tmux select-window -t "=$session:$(tmux list-windows -t "=$session" -F '#{window_index}' | head -1)"
  printf '%s\n' "$session"
}

cmd_restore() {
  local dry_run=false
  local -a selectors=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=true ;;
      --id) selectors+=("id:${2:?--id needs an id}"); shift ;;
      -*) die "unknown option for restore: $1" ;;
      *) selectors+=("name:$1") ;;
    esac
    shift
  done
  # Launched from inside a Claude Code session, this would otherwise leak
  # into a tmux server started here, and every pane's claude would think it's
  # nested.
  unset CLAUDECODE

  lock_acquire wait
  local srv live_ids f state
  srv=$(server_id)
  live_ids=""
  [[ -n "$srv" ]] && live_ids=$(live_workspaces | cut -f1)

  # Candidates: every restorable entry, or exactly the selected ones.
  local -a picked=() skipped=()
  if [[ ${#selectors[@]} -eq 0 ]]; then
    while IFS= read -r f; do
      state=$(entry_state "$f" "$live_ids" "$srv")
      case "$state" in
        restorable) picked+=("$f") ;;
        closed) skipped+=("$(jq -r .name "$f") (closed in this tmux server; restore it by name)") ;;
      esac
    done < <(entry_files "$WS_DIR")
  else
    local sel kind val
    for sel in "${selectors[@]}"; do
      kind="${sel%%:*}"; val="${sel#*:}"
      local -a hits=()
      while IFS= read -r f; do
        [[ "$(entry_state "$f" "$live_ids" "$srv")" == live ]] && continue
        if [[ "$kind" == id ]]; then
          [[ "$(jq -r .id "$f")" == "$val" ]] && hits+=("$f")
        else
          [[ "$(jq -r .name "$f")" == "$val" ]] && hits+=("$f")
        fi
      done < <(entry_files "$WS_DIR"; entry_files "$CLOSED_DIR")
      [[ ${#hits[@]} -eq 1 ]] || die "'$val' matches ${#hits[@]} saved workspaces that aren't running (see 'lazy-llm saved --closed')"
      picked+=("${hits[0]}")
    done
  fi

  if [[ ${#picked[@]} -eq 0 ]]; then
    echo "Nothing to restore: every saved workspace is running."
    local s
    for s in "${skipped[@]}"; do echo "  skipped $s"; done
    lock_release
    return 0
  fi

  # Saved dashboard order.
  local -a ordered=()
  while IFS=$'\t' read -r _ f; do
    ordered+=("$f")
  done < <(for f in "${picked[@]}"; do printf '%s\t%s\n' "$(jq -r .order "$f")" "$f"; done | sort -n)

  if $dry_run; then
    local d
    for f in "${ordered[@]}"; do
      d=$(jq -r .dir "$f")
      printf '%s  (%s)%s\n' "$(jq -r .name "$f")" "${d/#$HOME/\~}" "$([[ -d "$d" ]] || echo '  — dir missing, would skip')"
      local nw w np p wj pj
      nw=$(jq '.windows | length' "$f")
      for ((w = 0; w < nw; w++)); do
        wj=$(jq -c ".windows[$w]" "$f")
        np=$(jq '.panes | length' <<< "$wj")
        for ((p = 0; p < np; p++)); do
          pj=$(jq -c ".panes[$p]" <<< "$wj")
          printf '  %s pane %s %-8s %s\n      $ %s\n' "$([[ $nw -gt 1 ]] && echo "window $((w + 1))")" "$((p + 1))" \
            "$([[ $p -eq $(jq -r .visible <<< "$wj") ]] && echo visible || echo held)" \
            "$(jq -r '"\(.tool)  \(.name // "-")"' <<< "$pj")" "$(pane_launch_cmd "$pj" "$d")"
        done
        printf '  editor snapshot: %s\n  prompt snapshot: %s\n' \
          "$(jq -r .editor_session <<< "$wj" | { read -r x; [[ -f "$x" ]] && echo "$x" || echo "none (bare editor)"; })" \
          "$(jq -r .prompt_session <<< "$wj" | { read -r x; [[ -f "$x" ]] && echo "$x" || echo "none (prompt file $(jq -r '.prompt_file // "new"' <<< "$wj"))"; })"
      done
    done
    lock_release
    return 0
  fi

  local order_before
  order_before=$(lazy_llm_apply_ws_order "$(lazy_llm_gather_sessions)" | cut -f1)

  local -a restored=()
  local d session saved_name
  for f in "${ordered[@]}"; do
    d=$(jq -r .dir "$f")
    saved_name=$(jq -r .name "$f")
    if [[ ! -d "$d" ]]; then
      echo "Skipped $saved_name: $d no longer exists" >&2
      continue
    fi
    # A closed/ entry being restored explicitly comes back into workspaces/.
    [[ "$f" == "$CLOSED_DIR/"* ]] && { mkdir -p "$WS_DIR"; mv "$f" "$WS_DIR/"; f="$WS_DIR/$(basename "$f")"; }
    session=$(restore_one "$f" | tail -1)
    restored+=("$session")
    if [[ "$session" == "$saved_name" ]]; then
      echo "Restored $session"
    else
      echo "Restored $saved_name as $session ('$saved_name' is taken)"
    fi
    jq -r '.windows[].panes[] | select(.conv == null) | "  \(.tool) pane \(.name // "") started fresh (no saved conversation)"' "$f"
  done

  # Dashboard order: restored workspaces in their saved order, then the ones
  # that were already running.
  if [[ ${#restored[@]} -gt 0 ]]; then
    local order_tail="" o
    for o in $order_before; do order_tail+=" $o"; done
    tmux set-option -s @lazy_llm_ws_order "${restored[*]}$order_tail"
  fi

  lock_release
  "$0" save >/dev/null

  [[ ${#restored[@]} -gt 0 ]] || return 0
  if [[ -z "${TMUX:-}" && -t 0 && -t 1 ]]; then
    exec tmux attach-session -t "=${restored[0]}"
  elif [[ -n "${TMUX:-}" && ${#restored[@]} -eq 1 ]]; then
    tmux switch-client -t "=${restored[0]}"
  else
    echo "Attach with: tmux attach -t ${restored[0]}"
  fi
}

usage() {
  cat <<'EOF'
Usage: lazy-llm save [--async|--notify]      save every running workspace now
       lazy-llm restore [--dry-run] [--id <id>]... [name]...
                                             rebuild saved workspaces that aren't running
       lazy-llm saved [-v] [--closed]        list saved workspaces
       lazy-llm forget <name> | --id <id>    drop a saved workspace
EOF
}

case "${1:-}" in
  save)     shift; cmd_save "$@" ;;
  restore)  shift; cmd_restore "$@" ;;
  saved)    shift; cmd_saved "$@" ;;
  forget)   shift; cmd_forget "$@" ;;
  find-dir) shift; cmd_find_dir "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
