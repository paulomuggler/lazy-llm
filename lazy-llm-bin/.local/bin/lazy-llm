#!/bin/bash

# dev-session - Launch tmux development session with AI tools, editor, and prompt buffer
# Usage: dev-session [-s session_name] [-d directory] [-t ai_tool] [-w] [-W branch]

# Source shared library (worktree + session helpers).
# Sibling-first (post-install via stow), then dev-fallback to in-repo path.
_lib_sibling="$(dirname "$0")/lazy-llm-lib.sh"
if [[ -f "$_lib_sibling" ]]; then
  # shellcheck source=/dev/null
  source "$_lib_sibling"
else
  # shellcheck source=/dev/null
  source "$(dirname "$0")/../../../llm-send-bin/.local/bin/lazy-llm-lib.sh"
fi

# Default values
SESSION_NAME=""
TARGET_DIR="$(pwd)"
AI_TOOL="claude"
NEW_WINDOW=false
WORKTREE_BRANCH=""

# File retention periods (in days)
PROMPT_RETENTION_DAYS=7
UNDO_RETENTION_DAYS=30

# Initialize state directories (workspace-local)
# These will be set after TARGET_DIR is determined
STATE_DIR=""
PROMPTS_DIR=""
SWAP_DIR=""
UNDO_DIR=""

init_state_dirs() {
  # Use workspace-local .lazy-llm directory
  STATE_DIR="${TARGET_DIR}/.lazy-llm"
  PROMPTS_DIR="${STATE_DIR}/prompts"
  SWAP_DIR="${STATE_DIR}/swap"
  UNDO_DIR="${STATE_DIR}/undo"

  mkdir -p "$PROMPTS_DIR" "$SWAP_DIR" "$UNDO_DIR"
}

# Cleanup old files based on retention policy
cleanup_old_files() {
  # Clean up old prompt files (older than PROMPT_RETENTION_DAYS), except ones
  # a prompt-pane session snapshot still has open: the prompt pane restores
  # them on every launch, so an untouched-for-a-week prompt isn't abandoned.
  local keep="" snap old
  for snap in "$STATE_DIR"/sessions/prompt*.vim; do
    [[ -f "$snap" ]] && keep+=$(grep -oE 'prompt-[0-9]{8}-[0-9]{6}\.md' "$snap")$'\n'
  done
  while IFS= read -r old; do
    grep -qxF "$(basename "$old")" <<< "$keep" || rm -f "$old"
  done < <(find "$PROMPTS_DIR" -name "prompt-*.md" -type f -mtime +${PROMPT_RETENTION_DAYS} 2>/dev/null)

  # Clean up old undo files (older than UNDO_RETENTION_DAYS)
  find "$UNDO_DIR" -type f -mtime +${UNDO_RETENTION_DAYS} -delete 2>/dev/null
}

# Note: Swap file recovery is handled natively by nvim
# When opening a file with an existing swap file, nvim will show its
# built-in recovery prompt directly in the buffer - no need for custom handling

# Subcommand dispatch — route to llm-sessions for management commands
case "${1:-}" in
  list)     shift; exec "$HOME/.local/bin/llm-sessions" --list "$@" ;;
  kill)     shift; exec "$HOME/.local/bin/llm-sessions" --kill "$@" ;;
  sessions) shift; exec "$HOME/.local/bin/llm-sessions" "$@" ;;
  save|restore|saved|forget) exec "$HOME/.local/bin/llm-persist" "$@" ;;
esac

# Parse named parameters
while getopts "s:d:t:wW:h" opt; do
  case $opt in
  s) SESSION_NAME="$OPTARG" ;;
  d) TARGET_DIR="$OPTARG" ;;
  t) AI_TOOL="$OPTARG" ;;
  w) NEW_WINDOW=true ;;
  W) WORKTREE_BRANCH="$OPTARG" ;;
  h)
    echo "Usage: lazy-llm [-s session_name] [-d directory] [-t ai_tool] [-w] [-W branch]"
    echo "       lazy-llm list | kill <name> | sessions"
    echo "       lazy-llm save | restore [--dry-run] [name...] | saved [-v] | forget <name>"
    echo ""
    echo "Options:"
    echo "  -s  Session name (auto-generated if not provided)"
    echo "  -d  Working directory (default: current directory)"
    echo "  -t  AI tool to launch (claude, gemini, codex, grok, etc.)"
    echo "  -w  Force new window mode (otherwise auto-detected when in tmux)"
    echo "  -W  Spawn a session bound to a git worktree for <branch>"
    echo "       Creates branch (from HEAD) and worktree (under .worktrees/<branch>)"
    echo "       if needed. Always spawns a new session, even from inside tmux."
    echo "       Override worktree base path with LAZY_LLM_WORKTREE_DIR."
    echo ""
    echo "Behavior:"
    echo "  - Outside tmux: Creates new session or attaches to existing one"
    echo "  - Inside tmux: Adds new window to current session"
    echo "  - With -s <existing>: Adds window to that session (attaches if needed)"
    echo "  - With -W <branch>: Always creates a new session bound to the worktree;"
    echo "    attaches to an existing lazy-llm session there if one exists"
    echo "  - Opening a dir that has a saved (not running) workspace offers to restore it"
    echo ""
    echo "Save/restore:"
    echo "  Workspaces are saved automatically on every change (and with Prefix+C-s)."
    echo "  After the tmux server dies, 'lazy-llm restore' rebuilds them: AI panes and"
    echo "  their conversations, display names, prompt and editor state, folds, order."
    exit 0
    ;;
  *)
    echo "Invalid option: -$OPTARG" >&2
    exit 1
    ;;
  esac
done

# Worktree setup: must run AFTER argparse (to know WORKTREE_BRANCH) and
# BEFORE init_state_dirs (which depends on TARGET_DIR).
if [[ -n "$WORKTREE_BRANCH" ]]; then
  TARGET_DIR=$(lazy_llm_setup_worktree "$WORKTREE_BRANCH") || exit $?

  # If a lazy-llm session is already pointed at this worktree, attach to it
  # instead of creating a duplicate. Use realpath comparison via the lib helper.
  EXISTING=$(lazy_llm_find_session_for_path "$TARGET_DIR")
  if [[ -n "$EXISTING" ]]; then
    echo "Existing lazy-llm session '$EXISTING' is already at this worktree; attaching..."
    if [[ -n "${TMUX:-}" ]]; then
      exec tmux switch-client -t "$EXISTING"
    else
      exec tmux attach-session -t "$EXISTING"
    fi
  fi

  # Force new-session mode regardless of TMUX context. Worktree binding is
  # session-scoped — never add as a window to an existing session.
  unset TMUX
  NEW_WINDOW=false

  # Auto-derive session name from branch if user didn't pass -s. Just the
  # branch name — no "dev-" prefix or "-<tool>" suffix (collisions, e.g. two
  # tools on the same branch, are already handled by the de-dup loop below,
  # which appends -2/-3/etc.).
  if [[ -z "$SESSION_NAME" ]]; then
    SESSION_NAME="${WORKTREE_BRANCH//\//-}"
  fi
fi

# Initialize state directories and cleanup old files
init_state_dirs
cleanup_old_files

# Generate session name from directory if not provided — just the
# directory's own name, no "dev-" prefix or "-<tool>" suffix (per direct
# user request; collisions are already handled by the de-dup loop below).
NAME_AUTO_GENERATED=false
if [ -z "$SESSION_NAME" ]; then
  # Use basename of directory and replace dots/spaces with underscores
  DIR_NAME=$(basename "$TARGET_DIR" | sed 's/[. ]/_/g')
  SESSION_NAME="$DIR_NAME"
  NAME_AUTO_GENERATED=true
fi

# Auto-detect if we're inside tmux or if -w flag is set
# If so, add a window to current/specified session instead of creating new session
IN_TMUX=false
if [ -n "$TMUX" ]; then
  IN_TMUX=true
fi

# Determine target session for adding window
TARGET_SESSION=""
if [ "$NEW_WINDOW" = true ] || [ "$IN_TMUX" = true ]; then
  # Check if user provided -s with an existing session name
  SESSION_EXISTS=false
  if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
    SESSION_EXISTS=true
  fi

  if [ "$SESSION_EXISTS" = true ]; then
    # Use the specified existing session
    TARGET_SESSION="$SESSION_NAME"
  elif [ "$IN_TMUX" = true ]; then
    # Use current session
    TARGET_SESSION=$(tmux display-message -p '#S')
  elif [ "$NEW_WINDOW" = true ]; then
    # -w flag but not in tmux and session doesn't exist
    echo "Error: -w flag requires you to be inside a tmux session or specify an existing session with -s"
    exit 1
  fi

  # If we have a target session, add window to it
  if [ -n "$TARGET_SESSION" ]; then
    echo "Adding new window to session '$TARGET_SESSION'..."
    echo "Directory: $TARGET_DIR"
    echo "AI Tool: $AI_TOOL"

    # Get the next window index
    BASE_INDEX=$(tmux show-options -g | grep base-index | awk '{print $2}')
    NEXT_WIN=$(tmux list-windows -t "$TARGET_SESSION" -F "#{window_index}" | sort -n | tail -1)
    NEXT_WIN=$((NEXT_WIN + 1))

    # Create new window
    tmux new-window -t "$TARGET_SESSION:$NEXT_WIN" -n "dev" -c "$TARGET_DIR"

    # Set up the 3-pane layout
    lazy_llm_build_window "$TARGET_SESSION" "$NEXT_WIN" "$TARGET_DIR" "$AI_TOOL" "$(lazy_llm_tool_launch_cmd "$AI_TOOL")"

    # Switch to the new window
    tmux select-window -t "$TARGET_SESSION:$NEXT_WIN"

    # Attach if not already in tmux
    if [ "$IN_TMUX" = false ]; then
      tmux attach-session -t "$TARGET_SESSION"
    fi

    exit 0
  fi
fi

# Handle existing session: auto-generated names get a counter suffix,
# explicitly named sessions (-s) just attach
if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
  if [ "$NAME_AUTO_GENERATED" = true ]; then
    BASE_NAME="$SESSION_NAME"
    COUNTER=2
    while tmux has-session -t "=$SESSION_NAME" 2>/dev/null; do
      SESSION_NAME="${BASE_NAME}-${COUNTER}"
      COUNTER=$((COUNTER + 1))
    done
  else
    echo "Session '$SESSION_NAME' already exists. Attaching..."
    tmux attach-session -t "$SESSION_NAME"
    exit 0
  fi
fi

# A saved workspace for this dir that isn't running (e.g. after the tmux
# server died): offer to bring it back instead of starting a fresh one.
if [ -t 0 ] && [ -x "$HOME/.local/bin/llm-persist" ]; then
  SAVED=$("$HOME/.local/bin/llm-persist" find-dir "$TARGET_DIR" 2>/dev/null || true)
  if [ -n "$SAVED" ]; then
    SAVED_COUNT=$(grep -c . <<< "$SAVED")
    if [ "$SAVED_COUNT" -eq 1 ]; then
      IFS=$'\t' read -r SAVED_ID SAVED_NAME SAVED_SUMMARY <<< "$SAVED"
      printf "Saved workspace '%s' for this dir (%s).\nRestore it instead? [Y/n] " "$SAVED_NAME" "$SAVED_SUMMARY"
      read -r ANSWER
      case "$ANSWER" in
        n|N|no|No) ;;
        *) exec "$HOME/.local/bin/llm-persist" restore --id "$SAVED_ID" ;;
      esac
    else
      echo "Saved workspaces for this dir:"
      i=1
      while IFS=$'\t' read -r _ SAVED_NAME SAVED_SUMMARY; do
        echo "  $i) $SAVED_NAME ($SAVED_SUMMARY)"
        i=$((i + 1))
      done <<< "$SAVED"
      printf "Restore which? [1-%s, n = new workspace] " "$SAVED_COUNT"
      read -r ANSWER
      if [[ "$ANSWER" =~ ^[0-9]+$ ]] && [ "$ANSWER" -ge 1 ] && [ "$ANSWER" -le "$SAVED_COUNT" ]; then
        SAVED_ID=$(sed -n "${ANSWER}p" <<< "$SAVED" | cut -f1)
        exec "$HOME/.local/bin/llm-persist" restore --id "$SAVED_ID"
      fi
    fi
  fi
fi

echo "Creating session: $SESSION_NAME"
echo "Directory: $TARGET_DIR"
echo "AI Tool: $AI_TOOL"

# Create new tmux session
tmux new-session -d -s "$SESSION_NAME" -n "dev" -c "$TARGET_DIR"

# Get base-index for the first window
WIN_INDEX=$(tmux show-options -g | grep base-index | awk '{print $2}')

# Set up the 3-pane layout using shared function
lazy_llm_build_window "$SESSION_NAME" "$WIN_INDEX" "$TARGET_DIR" "$AI_TOOL" "$(lazy_llm_tool_launch_cmd "$AI_TOOL")"

# Attach to the session
tmux attach-session -t "$SESSION_NAME"
