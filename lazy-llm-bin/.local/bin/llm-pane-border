#!/usr/bin/env bash
# llm-pane-border - compact per-pane status text for tmux pane-border-format
# Usage: llm-pane-border <pane_id> <tool>
#
# Deliberately separate from llm-status: a pane border is much narrower than
# the status-right segment (often just that one pane's own width — tens of
# columns, not the whole terminal), so this renders "Nws Mwaiting │ tool
# glyph" — the SAME cross-workspace summary llm-status shows (per user
# request — "add the same workspace status as the bottom status bar"), plus
# this specific pane's own tool+status. Only meaningful for the AI pane; the
# editor and prompt panes' borders show their own text directly via the
# pane-border-format expression, this script isn't invoked for those.

set -euo pipefail

source "$(dirname "$0")/lazy-llm-lib.sh"

readonly C_TEXT="#e4e4e4"
readonly C_DIM="#8a8a8a"
readonly C_WORKING="#ffff00"
readonly C_WAITING="#ff00af"
readonly C_IDLE="#5fff00"
readonly C_UNKNOWN="#8a8a8a"

glyph_for() {
  case "$1" in
    working) printf '●' ;;
    idle)    printf '○' ;;
    waiting) printf '◐' ;;
    *)       printf '?' ;;
  esac
}

glyph_color() {
  case "$1" in
    working) printf '%s' "$C_WORKING" ;;
    waiting) printf '%s' "$C_WAITING" ;;
    idle)    printf '%s' "$C_IDLE" ;;
    *)       printf '%s' "$C_UNKNOWN" ;;
  esac
}

pane_id="${1:-}"
tool="${2:-claude}"
[ -z "$pane_id" ] && exit 0

status=$(lazy_llm_detect_pane_status "$pane_id" "$tool")
color=$(glyph_color "$status")
glyph=$(glyph_for "$status")

# This pane's display label -- its dashboard rename if one's set, else the
# plain tool name (lazy_llm_pane_display_label, shared with llm-status and
# the dashboard tree, so a pane rename shows up everywhere consistently).
# Resolve session:window FROM pane_id -- this script only ever receives the
# target pane's own id/tool, not its window context.
display_label="$tool"
sw=$(tmux display-message -t "$pane_id" -p '#S:#I' 2>/dev/null) || sw=""
if [ -n "$sw" ]; then
  ai_panes=$(tmux show-option -wv -t "$sw" @AI_PANES 2>/dev/null) || ai_panes=""
  ai_names=$(tmux show-option -wv -t "$sw" @AI_PANE_NAMES 2>/dev/null) || ai_names=""
  if [ -n "$ai_panes" ]; then
    idx=0
    for p in $ai_panes; do
      if [ "$p" = "$pane_id" ]; then
        display_label=$(lazy_llm_pane_display_label "$tool" "$ai_names" "$idx")
        break
      fi
      idx=$((idx + 1))
    done
  fi
fi

read -r ws_count waiting_count < <(lazy_llm_compute_summary)
summary="${ws_count}ws"
if [ "$waiting_count" -gt 0 ]; then
  summary+=" #[fg=${C_WAITING},bold]${waiting_count}◐#[fg=${C_TEXT},nobold]"
fi

# Explicit fg on EVERY piece of text, including the tool name — a pane
# border inherits pane-border-style/pane-active-border-style by default
# (dim gray for an unfocused pane), which makes un-styled text nearly
# invisible when the pane isn't focused. Only the glyph had its own color
# before; fixed per user report (confirmed low contrast, not a rendering
# bug) — everything here now has an explicit color that doesn't fade with
# focus, matching the status-right segment's own tiles.
printf ' #[fg=%s]%s#[default] │ #[fg=%s]%s #[fg=%s]%s#[default] ' \
  "$C_DIM" "$summary" "$C_TEXT" "$display_label" "$color" "$glyph"
