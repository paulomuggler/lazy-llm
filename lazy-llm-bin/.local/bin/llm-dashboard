#!/usr/bin/env bash
# llm-dashboard - Tabbed popup dashboard for lazy-llm
#
# "Workspace" here means a lazy-llm tmux session (one project directory, opened
# via `lazy-llm`, holding N AI panes + nvim + prompt pane) — not an individual
# LLM chat/conversation. See docs/USAGE.md.
#
# Tabs:
#   1. Workspaces - collapsible tree: every lazy-llm workspace, its AI panes
#                   nested beneath it, status glyphs + live ANSI preview.
#                   Folds the old separate Panes tab in (that tab only ever
#                   showed the current window's panes anyway — this shows
#                   every workspace's panes, which is the point).
#   2. Worktrees  - worktree lifecycle (see worktree-bridge-tab)
#   3. Help       - the full keybinding reference, reachable via '3' or '?'
#                   from either other tab. A tab rather than a transient
#                   popup so it's consistent with the rest of the UI and
#                   gets the full popup width (no preview split needed) —
#                   see the header-width comment on render_sessions_tab for
#                   why that width matters here.
#
# Designed to be launched via `tmux display-popup -E`; binds to Prefix+S.
# All keybindings inside the popup are popup-scoped, single-letter, dense.
#
# Tab keys:            1 (Workspaces), 2 (Worktrees), 3 (Help)
# Workspaces actions:  Enter (switch, or switch+focus-pane on a pane row),
#                     n (new), K (kill workspace / remove pane), r (rename),
#                     z (fold/unfold), a (add pane, current workspace),
#                     ]/[ (cycle pane, current workspace), R (refresh),
#                     ? (help), q/Esc (quit)
#
# Usage: llm-dashboard [--tab workspaces|worktrees|help] [--help]

set -euo pipefail

# Resolve lib path: try sibling first (post-install via stow), else dev location
_lib_sibling="$(dirname "$0")/lazy-llm-lib.sh"
if [[ -f "$_lib_sibling" ]]; then
  # shellcheck source=/dev/null
  source "$_lib_sibling"
else
  # shellcheck source=/dev/null
  source "$(dirname "$0")/../../../llm-send-bin/.local/bin/lazy-llm-lib.sh"
fi

# ──────────────────────────────────────────────────────────────────────────
# Glyph mapping (shared with llm-status; kept here too so the dashboard
# doesn't pull in another source file just for one tiny function).
# ──────────────────────────────────────────────────────────────────────────
glyph_for() {
  case "$1" in
    working) printf '●' ;;
    idle)    printf '○' ;;
    waiting) printf '◐' ;;
    *)       printf '?' ;;
  esac
}

# ──────────────────────────────────────────────────────────────────────────
# Workspaces tab
# ──────────────────────────────────────────────────────────────────────────

# Row model: each line is "<id>\t<display text>". <id> is hidden from view via
# --with-nth=2 (fzf still returns the full line on selection, and {1} in the
# preview command always refers to the hidden id field regardless of
# --with-nth). This is what lets a single fzf list mix two row types:
#   ws:<name>                    — a workspace row
#   pane:<name>:<idx0>:<pane_id> — an AI pane row nested under workspace <name>,
#                                  <idx0> is its 0-based index into that
#                                  workspace's @AI_PANES list
#
# Collapse state (_collapsed[name] set = collapsed) is a script-global
# associative array declared near the bottom of this file, mutated by
# dispatch_action so it survives across re-renders of this tab within one
# dashboard invocation (render_workspaces_tab itself runs in a subshell via
# command substitution, so it can only READ _collapsed, never write it).
#
# Returns (echoes) one of:
#   "tab:worktrees"                      — switch to worktrees tab
#   "action:switch:<name>"               — switch to selected workspace
#   "action:switch-pane:<name>:<idx0>"   — switch to workspace + focus that pane
#   "action:kill:<name>"                 — kill selected workspace
#   "action:rename:<name>"               — rename selected workspace
#   "action:toggle:<name>"               — collapse/expand that workspace's panes
#   "action:new"                         — launch new lazy-llm workspace
#   "action:pane-add"                    — add AI pane to the CURRENT workspace
#                                           (the one this dashboard was opened
#                                           from — not whatever's highlighted;
#                                           see help text)
#   "action:pane-remove:<idx0>"          — remove a pane from the CURRENT workspace
#   "action:pane-remove-unsupported"     — K pressed on a pane row belonging to a
#                                           workspace other than the current one
#   "action:pane-next" / "action:pane-prev" — cycle panes in the CURRENT workspace
#   "action:refresh"                     — re-render the tab
#   "tab:help"                            — switch to the Help tab
#   "quit"                               — exit dashboard
render_sessions_tab() {
  # Resolve the workspace this dashboard was launched from, if any — needed to
  # scope 'a' / ']' / '[' / pane-row 'K' to the current workspace only (see
  # header comment). A popup opened from outside any lazy-llm window (or from
  # no tmux session at all) leaves this empty; the tree still renders fine,
  # those specific actions just become unavailable/no-ops, same as they'd be
  # unreachable entirely in the pre-merge Panes tab under the same condition.
  local launch_ws=""
  if lazy_llm_resolve_pane 2>/dev/null && lazy_llm_resolve_session_window 2>/dev/null; then
    launch_ws="$_SESSION"
  fi

  local data
  data=$(lazy_llm_gather_sessions)

  local lines="" header
  if [[ -z "$data" ]]; then
    header="[Workspaces] none yet. n:new ?:help q:close"
  else
    while IFS=$'\t' read -r name dir tools wins attached; do
      local first_win
      first_win=$(tmux list-windows -t "$name" -F '#{window_index}' 2>/dev/null | head -1)

      # Full per-pane list for this workspace's first window — every AI pane
      # gets its own row + glyph, not just the first (the old Sessions tab's
      # limitation this task exists to fix).
      local reply_panes reply_tools reply_idx
      lazy_llm_read_multi_state_for "$name" "$first_win"
      reply_panes="$REPLY_PANES"; reply_tools="$REPLY_TOOLS"; reply_idx="${REPLY_IDX:-0}"

      local -a pane_arr=() tool_arr=()
      if [[ -n "$reply_panes" ]]; then
        read -ra pane_arr <<< "$reply_panes"
        read -ra tool_arr <<< "$reply_tools"
      else
        # Legacy/single-pane fallback: @AI_PANES was never set for this window
        # (e.g. a workspace that's never had a second pane added).
        local single_pane_id
        single_pane_id=$(tmux show-option -wv -t "$name:$first_win" @AI_PANE_ID 2>/dev/null) || single_pane_id=""
        if [[ -n "$single_pane_id" ]]; then
          local single_tool
          single_tool=$(tmux show-option -wv -t "$name:$first_win" @AI_TOOL 2>/dev/null) || single_tool="${tools%% *}"
          pane_arr=("$single_pane_id")
          tool_arr=("$single_tool")
        fi
      fi

      # Workspace row's aggregate glyph: worst-case across its panes, in the
      # order a human would want to notice — needs-you beats busy beats idle.
      local saw_waiting=false saw_working=false saw_idle=false
      local i st
      for i in "${!pane_arr[@]}"; do
        st=$(lazy_llm_detect_pane_status "${pane_arr[$i]}" "${tool_arr[$i]:-claude}")
        case "$st" in
          waiting) saw_waiting=true ;;
          working) saw_working=true ;;
          idle)    saw_idle=true ;;
        esac
      done
      local agg_glyph="?"
      if   [[ "$saw_waiting" == true ]]; then agg_glyph=$(glyph_for waiting)
      elif [[ "$saw_working" == true ]]; then agg_glyph=$(glyph_for working)
      elif [[ "$saw_idle"    == true ]]; then agg_glyph=$(glyph_for idle)
      fi

      local short_dir="${dir/#$HOME/\~}"
      [[ ${#short_dir} -gt 40 ]] && short_dir="...${short_dir: -37}"
      local mark=""
      [[ -n "$attached" ]] && mark=" *"

      local fold_glyph="▾"
      [[ -n "${_collapsed[$name]:-}" ]] && fold_glyph="▸"

      local ws_display
      ws_display=$(printf '%s %-26s  %-40s  %s %-14s %sw%s' \
        "$fold_glyph" "$name" "$short_dir" "$agg_glyph" "$tools" "$wins" "$mark")
      lines+="ws:${name}"$'\t'"${ws_display}"$'\n'

      if [[ -z "${_collapsed[$name]:-}" ]]; then
        for i in "${!pane_arr[@]}"; do
          local pid="${pane_arr[$i]}" tool="${tool_arr[$i]:-?}" glyph
          st=$(lazy_llm_detect_pane_status "$pid" "$tool")
          glyph=$(glyph_for "$st")
          local active_mark=""
          [[ "$i" -eq "$reply_idx" ]] && active_mark=" (active)"
          local pane_display
          pane_display=$(printf '    ↳ %-12s %s%s' "$tool" "$glyph" "$active_mark")
          lines+="pane:${name}:${i}:${pid}"$'\t'"${pane_display}"$'\n'
        done
      fi
    done <<< "$data"
    lines="${lines%$'\n'}"
    # Deliberately short and static — NOT an enumeration of every key. With a
    # right-side preview active, --header's available width is the LIST
    # column's share (~45% of the popup), not the popup's own width — at a
    # 90-column terminal that's only ~30 characters before fzf truncates with
    # '..', regardless of how many lines the header string has. Trying to
    # enumerate keys here is fundamentally fragile against terminal width;
    # the full list lives in the '?' help overlay instead (see dashboard-help-tab
    # in .agents/TODO, which builds a more persistent version of this).
    header="[Workspaces] ?:help q:close"
  fi

  # Preview: branch on the row's hidden id (field 1) to find the right pane —
  # a workspace row previews its active pane, a pane row previews itself.
  local preview_cmd
  preview_cmd='set -- {1}; id="$1"; pid=""; '
  preview_cmd+='case "$id" in '
  preview_cmd+='ws:*) ws="${id#ws:}"; win=$(tmux list-windows -t "$ws" -F "#{window_index}" 2>/dev/null | head -1); '
  preview_cmd+='pid=$(tmux show-option -wv -t "$ws:$win" @AI_PANE_ID 2>/dev/null) ;; '
  preview_cmd+='pane:*) rest="${id#pane:}"; pid="${rest##*:}" ;; '
  preview_cmd+='esac; '
  preview_cmd+='if [ -n "$pid" ]; then '
  preview_cmd+='tmux capture-pane -p -e -S -200 -t "$pid" 2>/dev/null || echo "(could not capture pane $pid)"; '
  preview_cmd+='else echo "(no AI pane to preview)"; fi'

  local selection key
  selection=$(printf '%s\n' "$lines" | fzf \
    --ansi \
    --reverse \
    --border=rounded \
    --prompt="workspace> " \
    --header="$header" \
    --delimiter=$'\t' \
    --with-nth=2 \
    --nth=2 \
    --preview="$preview_cmd" \
    --preview-window="right:55%:follow" \
    --bind='q:abort' \
    --expect="1,2,3,n,K,r,R,z,a,],[,?" \
  ) || { echo "quit"; return 0; }

  key=$(echo "$selection" | head -1)
  local chosen_line chosen_id
  chosen_line=$(echo "$selection" | tail -1)
  chosen_id=$(printf '%s' "$chosen_line" | cut -f1)

  local chosen_ws="" chosen_pane_idx=""
  case "$chosen_id" in
    ws:*)
      chosen_ws="${chosen_id#ws:}"
      ;;
    pane:*)
      local rest="${chosen_id#pane:}"
      chosen_ws="${rest%%:*}"
      local rest2="${rest#*:}"
      chosen_pane_idx="${rest2%%:*}"
      ;;
  esac

  case "$key" in
    1)     echo "action:refresh" ;;
    2)     echo "tab:worktrees" ;;
    n)     echo "action:new" ;;
    K)
      if [[ -n "$chosen_pane_idx" ]]; then
        if [[ -n "$launch_ws" && "$chosen_ws" == "$launch_ws" ]]; then
          echo "action:pane-remove:$chosen_pane_idx"
        else
          echo "action:pane-remove-unsupported"
        fi
      elif [[ -n "$chosen_ws" ]]; then
        echo "action:kill:$chosen_ws"
      else
        echo "action:refresh"
      fi
      ;;
    r)     [[ -z "$chosen_ws" ]] && echo "action:refresh" || echo "action:rename:$chosen_ws" ;;
    R)     echo "action:refresh" ;;
    z)     [[ -z "$chosen_ws" ]] && echo "action:refresh" || echo "action:toggle:$chosen_ws" ;;
    a)     echo "action:pane-add" ;;
    "]")   echo "action:pane-next" ;;
    "[")   echo "action:pane-prev" ;;
    3)     echo "tab:help" ;;
    "?")   echo "tab:help" ;;
    *)
      if [[ -z "$chosen_ws" ]]; then
        echo "quit"
      elif [[ -n "$chosen_pane_idx" ]]; then
        echo "action:switch-pane:$chosen_ws:$chosen_pane_idx"
      else
        echo "action:switch:$chosen_ws"
      fi
      ;;
  esac
}

# ──────────────────────────────────────────────────────────────────────────
# Worktrees tab (placeholder)
# ──────────────────────────────────────────────────────────────────────────

render_worktrees_tab() {
  local data lines header
  data=$(lazy_llm_gather_worktrees)

  if [[ -z "$data" ]]; then
    lines="(No worktrees in this repo, or not inside a git repo.)"
    header="[Worktrees] none. n:new ?:help q:close"
  else
    lines=""
    while IFS=$'\t' read -r path branch dirty ahead behind session pr; do
      local short_path="${path/#$HOME/\~}"
      [[ ${#short_path} -gt 38 ]] && short_path="...${short_path: -35}"

      local dirty_mark="${dirty:- }"
      local ab="↑${ahead} ↓${behind}"
      local sess_mark=" "
      [[ -n "$session" ]] && sess_mark="●"
      local pr_mark="   "
      case "$pr" in
        OPEN)   pr_mark="PR●" ;;
        MERGED) pr_mark="PR✓" ;;
        CLOSED) pr_mark="PRx" ;;
      esac

      lines+=$(printf '%-38s  %-24s %s  %-10s %s  %s' \
        "$short_path" "$branch" "$dirty_mark" "$ab" "$sess_mark" "$pr_mark")
      lines+=$'\n'
    done <<< "$data"
    lines="${lines%$'\n'}"
    # Short and static — see the matching comment on the Workspaces tab's header.
    header="[Worktrees] ?:help q:close"
  fi

  # Preview: git status -sb + recent log for the selected worktree path.
  local preview_cmd
  preview_cmd='set -- {1}; '
  preview_cmd+='wt="$1"; wt="${wt/#\~/$HOME}"; '
  preview_cmd+='if git -C "$wt" rev-parse --git-dir >/dev/null 2>&1; then '
  preview_cmd+='echo "=== git status ==="; git -C "$wt" -c color.status=always status -sb 2>&1 | head -20; '
  preview_cmd+='echo; echo "=== git log -10 ==="; git -C "$wt" -c color.ui=always log --oneline -10 2>&1; '
  preview_cmd+='else echo "(preview unavailable: $wt)"; fi'

  local selection key
  selection=$(echo "$lines" | fzf \
    --ansi \
    --reverse \
    --border=rounded \
    --prompt="worktree> " \
    --header="$header" \
    --preview="$preview_cmd" \
    --preview-window="right:55%:follow" \
    --bind='q:abort' \
    --expect="1,2,3,n,g,K,R,?" \
  ) || { echo "quit"; return 0; }

  key=$(echo "$selection" | head -1)
  local chosen_line chosen_path
  chosen_line=$(echo "$selection" | tail -1)
  chosen_path=$(echo "$chosen_line" | awk '{print $1}')
  chosen_path="${chosen_path/#\~/$HOME}"
  [[ -d "$chosen_path" ]] || chosen_path=""

  case "$key" in
    1)   echo "tab:workspaces" ;;
    2)   echo "action:refresh" ;;
    n)   echo "action:worktree-new" ;;
    g)   [[ -z "$chosen_path" ]] && echo "action:refresh" || echo "action:worktree-lazygit:$chosen_path" ;;
    K)   [[ -z "$chosen_path" ]] && echo "action:refresh" || echo "action:worktree-cleanup:$chosen_path" ;;
    R)   echo "action:refresh" ;;
    3)   echo "tab:help" ;;
    "?") echo "tab:help" ;;
    *)
      [[ -z "$chosen_path" ]] && echo "quit" || echo "action:worktree-open:$chosen_path"
      ;;
  esac
}

# ──────────────────────────────────────────────────────────────────────────
# Action dispatch
# ──────────────────────────────────────────────────────────────────────────

dispatch_action() {
  local action="$1"
  case "$action" in
    action:new)
      tmux display-popup -E "$HOME/.local/bin/lazy-llm"
      ;;
    action:switch:*)
      local name="${action#action:switch:}"
      tmux switch-client -t "$name" 2>/dev/null \
        || tmux attach-session -t "$name" 2>/dev/null \
        || echo "Could not switch to $name" >&2
      # switching exits the popup naturally
      ;;
    action:switch-pane:*)
      # Switch to the workspace AND focus a specific pane in it. Uses
      # lazy_llm_cycle_to_index with an explicit session:window target rather
      # than llm-cycle's ambient "current pane" resolution — after
      # switch-client, ambient resolution from inside this popup process
      # can't be trusted to follow the client to the new window (untested
      # tmux edge case; explicit targeting sidesteps the question entirely).
      # Order matters: cycle BEFORE switching, so the pane is already in
      # place by the time the client lands on the window.
      local rest="${action#action:switch-pane:}"
      local name="${rest%%:*}"
      local idx="${rest#*:}"
      local win
      win=$(tmux list-windows -t "$name" -F '#{window_index}' 2>/dev/null | head -1)
      [[ -n "$win" ]] && lazy_llm_cycle_to_index "$name" "$win" "$idx"
      tmux switch-client -t "$name" 2>/dev/null \
        || tmux attach-session -t "$name" 2>/dev/null \
        || echo "Could not switch to $name" >&2
      ;;
    action:toggle:*)
      local name="${action#action:toggle:}"
      if [[ -n "${_collapsed[$name]:-}" ]]; then
        unset "_collapsed[$name]"
      else
        _collapsed[$name]=1
      fi
      ;;
    action:kill:*)
      local name="${action#action:kill:}"
      # Use llm-sessions --kill for the validated kill path (checks @lazy_llm marker)
      local confirm
      confirm=$(printf 'no\nyes' | fzf \
        --reverse --border=rounded --header="Kill workspace '$name'?" \
        --prompt="confirm> " || echo no)
      if [[ "$confirm" == "yes" ]]; then
        "$HOME/.local/bin/llm-sessions" --kill "$name" >&2 || true
      fi
      ;;
    action:rename:*)
      local name="${action#action:rename:}"
      local new_name
      new_name=$(echo "" | fzf --print-query \
        --reverse --border=rounded \
        --header="Rename workspace '$name' to:" \
        --prompt="new name> " \
        --query="$name" \
        --no-info \
        --bind 'enter:accept-non-empty' \
        --expect=enter | head -1 || true)
      if [[ -n "$new_name" ]] && [[ "$new_name" != "$name" ]]; then
        tmux rename-session -t "$name" "$new_name" 2>/dev/null \
          || echo "Could not rename to $new_name" >&2
      fi
      ;;
    action:refresh)
      : # outer loop re-renders the current tab
      ;;
    action:pane-add)
      local tool
      tool=$(printf 'claude\ngemini\ncodex\ngrok\naider' | fzf \
        --reverse --border=rounded --prompt="tool> " \
        --header="Pick an AI tool to add (esc to cancel):" \
        --no-info)
      [[ -n "$tool" ]] && "$HOME/.local/bin/llm-add" -t "$tool" >&2 || true
      ;;
    action:pane-remove:*)
      local idx="${action#action:pane-remove:}"
      [[ -z "$idx" ]] && return 0
      local confirm
      confirm=$(printf 'no\nyes' | fzf \
        --reverse --border=rounded --header="Remove pane $idx?" \
        --prompt="confirm> " || echo no)
      [[ "$confirm" == "yes" ]] && "$HOME/.local/bin/llm-remove" -f "$idx" >&2 || true
      ;;
    action:pane-next)
      "$HOME/.local/bin/llm-cycle" next >&2 || true
      ;;
    action:pane-prev)
      "$HOME/.local/bin/llm-cycle" prev >&2 || true
      ;;
    action:pane-remove-unsupported)
      tmux display-message "Pane removal only works for the current workspace's panes today — switch to it first (Enter), then K."
      ;;
    action:worktree-open:*)
      local path="${action#action:worktree-open:}"
      local branch
      branch=$(git -C "$path" branch --show-current 2>/dev/null)
      if [[ -n "$branch" ]]; then
        "$HOME/.local/bin/lazy-llm" -W "$branch" >&2 || true
      fi
      ;;
    action:worktree-new)
      local new_branch
      new_branch=$(echo "" | fzf --print-query --reverse --border=rounded \
        --header="New worktree — branch name (will be created from HEAD if it doesn't exist):" \
        --prompt="branch> " --no-info \
        --bind 'enter:accept-non-empty' | head -1)
      if [[ -n "$new_branch" ]]; then
        "$HOME/.local/bin/lazy-llm" -W "$new_branch" >&2 || true
      fi
      ;;
    action:worktree-lazygit:*)
      local path="${action#action:worktree-lazygit:}"
      if command -v lazygit >/dev/null 2>&1; then
        tmux display-popup -E -w 95% -h 90% "lazygit -p '$path'"
      else
        tmux display-message "lazygit not installed"
      fi
      ;;
    action:worktree-cleanup:*)
      local path="${action#action:worktree-cleanup:}"
      _dashboard_worktree_cleanup_flow "$path"
      ;;
  esac
}

# Cleanup flow with pre-flight warnings and dual confirms.
# Lives in the dashboard (not the lib) because the prompts are fzf-bound.
_dashboard_worktree_cleanup_flow() {
  local path="$1"
  local repo branch session ahead_count default warnings_text=""
  repo=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null) || return 1
  branch=$(git -C "$path" branch --show-current 2>/dev/null)
  if [[ -z "$branch" ]]; then
    tmux display-message "Detached worktree — refusing to cleanup"
    return 1
  fi

  default=$(lazy_llm_default_branch "$repo")

  if [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]]; then
    warnings_text+="⚠  Worktree has uncommitted changes"$'\n'
  fi
  ahead_count=$(git -C "$path" rev-list --count "origin/$default..HEAD" 2>/dev/null || echo 0)
  if [[ "$ahead_count" -gt 0 ]]; then
    warnings_text+="⚠  Branch is $ahead_count commits ahead of origin/$default — they will be lost if branch is deleted"$'\n'
  fi
  if ! git -C "$path" rev-parse --verify "@{u}" >/dev/null 2>&1; then
    warnings_text+="⚠  Branch has no upstream — local-only commits will be lost"$'\n'
  fi
  session=$(lazy_llm_find_session_for_path "$path")
  if [[ -n "$session" ]]; then
    warnings_text+="⚠  Will kill attached lazy-llm workspace '$session'"$'\n'
  fi
  if command -v gh >/dev/null 2>&1; then
    local pr_state
    pr_state=$(gh pr view "$branch" --json state -q .state 2>/dev/null) || pr_state=""
    [[ "$pr_state" == "OPEN" ]] && warnings_text+="⚠  Open PR — branch deletion may close it remotely"$'\n'
  fi

  local confirm body
  body=$(printf 'Cleanup worktree: %s\nBranch: %s\n%s' "$path" "$branch" "${warnings_text:-(no warnings — clean removal)}")
  confirm=$(printf 'no\nyes' | fzf --reverse --border=rounded \
    --header="$body" --prompt="remove worktree? " || echo no)
  [[ "$confirm" != "yes" ]] && return 0

  local default_choice="yes"
  [[ -n "$warnings_text" ]] && default_choice="no"
  local del_branch
  del_branch=$(printf 'no\nyes' | fzf --reverse --border=rounded \
    --header="Also delete branch '$branch'? (data loss risk if warnings shown)" \
    --prompt="delete branch ($default_choice)? " || echo "$default_choice")

  local force="no"
  [[ -n "$warnings_text" ]] && force="yes"

  if lazy_llm_cleanup_worktree "$path" "$del_branch" "$force"; then
    tmux display-message "Cleaned up '$path'"
  fi
}

# ──────────────────────────────────────────────────────────────────────────
# Help tab — a proper tab (not a separate ephemeral popup), reachable from
# any other tab via '?' and, like the others, via '1'/'2'/'3'.
#
# Why a tab and not the always-visible subframe the originating task
# preferred by default: the Workspaces/Worktrees headers can only afford
# ~30-50 characters (see the header-width comment on render_sessions_tab) —
# a right-side preview leaves the list column only ~45% of the popup width.
# An always-visible keybinding strip would compete for that same scarce
# space. A dedicated tab instead gets the FULL popup width (no preview
# split needed here), which is exactly the difference between "the sparse
# header hints" and "the complete reference" fitting at all.
# ──────────────────────────────────────────────────────────────────────────

render_help_tab() {
  local body
  body="lazy-llm dashboard — keybindings

  Tabs
    1            switch to Workspaces tab
    2            switch to Worktrees tab
    3            this tab

  Workspaces tab — a tree: every lazy-llm workspace, its AI panes nested
  beneath it. Row-dependent keys act on whatever's highlighted.
    Enter        on a workspace row: switch to it
                 on a pane row: switch to its workspace AND focus that pane
    z            fold/unfold the highlighted workspace's panes
    n            new lazy-llm workspace
    r            rename the highlighted workspace
    K            on a workspace row: kill it (with confirmation)
                 on a pane row: remove that pane — only for the CURRENT
                 workspace (the one this dashboard was opened from); on
                 another workspace's pane row, shows why it's unsupported
    R            refresh list

  Workspaces tab — these three always act on the CURRENT workspace (the one
  this dashboard was opened from), regardless of what's highlighted:
    a            add an AI pane (tool picker)
    ]            cycle to next AI pane
    [            cycle to previous AI pane

  Worktrees tab
    Enter        open/attach lazy-llm workspace in worktree (via lazy-llm -W)
    n            new worktree + workspace (prompts for branch)
    g            launch lazygit pointed at the worktree
    K            atomic cleanup (workspace + worktree + optional branch)
    R            refresh list

  Global
    ?            open this tab from Workspaces or Worktrees
    q / Esc       close the dashboard"

  local header="[Help] 1:workspaces 2:worktrees q:close"
  local selection key
  selection=$(printf '%s\n' "$body" | fzf \
    --reverse \
    --border=rounded \
    --prompt="help> " \
    --header="$header" \
    --no-info \
    --bind='q:abort' \
    --expect="1,2,3" \
  ) || { echo "quit"; return 0; }

  key=$(echo "$selection" | head -1)
  case "$key" in
    1) echo "tab:workspaces" ;;
    2) echo "tab:worktrees" ;;
    *) echo "action:refresh" ;;
  esac
}

# ──────────────────────────────────────────────────────────────────────────
# CLI handling
# ──────────────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: llm-dashboard [--tab workspaces|worktrees|help] [--help]

Tabbed popup dashboard for lazy-llm. Launches Workspaces tab by default. The
Workspaces tab is a tree: every lazy-llm workspace, with its AI panes nested
beneath it (press z to fold/unfold). The old separate Panes tab is folded
into this tree — '--tab panes' is still accepted as a compat alias for
'--tab workspaces'. Full keybinding reference: the Help tab ('3' or '?' from
either other tab) — the dashboard's own headers only have room for a couple
of hints (see the Help tab for why), so this is the actual reference.

Inside the dashboard:
  1, 2, 3    switch tabs (Workspaces, Worktrees, Help)
  Enter      primary action (switch workspace, or workspace+pane on a pane
             row / open worktree)
  n          new workspace (Workspaces) / new worktree+workspace (Worktrees)
  z          fold/unfold a workspace's panes (Workspaces)
  a          add an AI pane to the CURRENT workspace (Workspaces — the one
             this dashboard was opened from, not whatever's highlighted)
  g          launch lazygit (Worktrees)
  K          kill workspace / remove pane / cleanup worktree (with confirmation)
  r          rename (Workspaces)
  ], [       cycle next / prev AI pane in the CURRENT workspace (Workspaces)
  R          refresh
  ?          open the Help tab
  q, Esc     close
EOF
}

# Parse args
current_tab=workspaces
while [[ $# -gt 0 ]]; do
  case "$1" in
    --tab)
      shift
      case "$1" in
        workspaces) current_tab="workspaces" ;;
        panes) current_tab="workspaces" ;; # compat alias — panes now live in the Workspaces tree
        worktrees) current_tab="worktrees" ;;
        help) current_tab="help" ;;
        *) echo "Unknown tab: $1" >&2; exit 2 ;;
      esac
      shift
      ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

# ──────────────────────────────────────────────────────────────────────────
# Main outer loop — tab dispatch
# ──────────────────────────────────────────────────────────────────────────

if ! command -v fzf &>/dev/null; then
  echo "Error: fzf is required" >&2
  exit 1
fi

# Per-workspace fold state for the Workspaces tree tab. render_sessions_tab
# runs in a subshell (command substitution) and can only READ this; only
# dispatch_action (run directly, in this shell) mutates it — see the header
# comment on render_sessions_tab.
declare -A _collapsed=()

while true; do
  case "$current_tab" in
    workspaces) result=$(render_sessions_tab) ;;
    worktrees) result=$(render_worktrees_tab) ;;
    help)       result=$(render_help_tab) ;;
    *)         echo "Unknown tab: $current_tab" >&2; exit 1 ;;
  esac

  case "$result" in
    tab:*)
      current_tab="${result#tab:}"
      ;;
    action:switch:*|action:switch-pane:*|action:toggle:*|action:kill:*|action:rename:*|action:new|action:refresh|action:pane-add|action:pane-remove:*|action:pane-remove-unsupported|action:pane-next|action:pane-prev|action:worktree-open:*|action:worktree-new|action:worktree-lazygit:*|action:worktree-cleanup:*)
      dispatch_action "$result"
      # Switch action exits the popup; for others we re-enter the current tab
      [[ "$result" == action:switch:* || "$result" == action:switch-pane:* ]] && break
      ;;
    quit|"")
      break
      ;;
    *)
      echo "Unexpected result: $result" >&2
      break
      ;;
  esac
done
