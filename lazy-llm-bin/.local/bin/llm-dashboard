#!/usr/bin/env bash
# llm-dashboard - Tabbed popup dashboard for lazy-llm
#
# "Workspace" here means a lazy-llm tmux session (one project directory, opened
# via `lazy-llm`, holding N AI panes + nvim + prompt pane) — not an individual
# LLM chat/conversation. See docs/USAGE.md.
#
# Tabs:
#   1. Workspaces - collapsible tree: every lazy-llm workspace, its AI panes
#                   nested beneath it, status glyphs + live ANSI preview.
#                   Folds the old separate Panes tab in (that tab only ever
#                   showed the current window's panes anyway — this shows
#                   every workspace's panes, which is the point).
#   2. Worktrees  - worktree lifecycle (see worktree-bridge-tab)
#   3. Help       - the full keybinding reference, reachable via '?' from
#                   either other tab (not '3' — dropped as a redundant
#                   second shortcut to the same tab, per direct request).
#                   A tab rather than a transient popup so it's consistent
#                   with the rest of the UI and gets the full popup width
#                   (no preview split needed) — see the header-width
#                   comment on render_sessions_tab for why that width
#                   matters here.
#
# Designed to be launched via `tmux display-popup -E`; binds to Prefix+S.
# All keybindings inside the popup are popup-scoped, single-letter, dense.
#
# Tab keys:            1 (Workspaces), 2 (Worktrees)
# Workspaces actions:  Enter (switch, or switch+focus-pane on a pane row),
#                     K (kill workspace / remove pane), r (rename),
#                     z (fold/unfold), Ctrl-Up/Ctrl-Down or k/j (reorder
#                     row, scoped to its own tree level), a (add pane, current
#                     workspace), ]/[ (cycle pane, current workspace),
#                     R (refresh), ? (help), q/Esc (quit), / (search),
#                     Tab (done searching — NOT Esc, which always quits,
#                     even mid-search, per direct request)
#
# Usage: llm-dashboard [--tab workspaces|worktrees|help] [--help]

set -euo pipefail

# On macOS, /bin/bash is 3.2 (which mangles ${var/#$HOME/\~} and lacks Bash 4+
# features). Re-exec under Homebrew Bash 4+ if invoked via /bin/bash.
if [[ "${BASH_VERSINFO[0]:-0}" -lt 4 ]]; then
  for _b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$_b" ]] && exec "$_b" "$0" "$@"
  done
fi

# Resolve lib path: try sibling first (post-install via stow), else dev location
_lib_sibling="$(dirname "$0")/lazy-llm-lib.sh"
if [[ -f "$_lib_sibling" ]]; then
  # shellcheck source=/dev/null
  source "$_lib_sibling"
else
  # shellcheck source=/dev/null
  source "$(dirname "$0")/../../../llm-send-bin/.local/bin/lazy-llm-lib.sh"
fi

# Absolute path to this script itself. Needed so the Workspaces tree's fold
# key can bind fzf's transform()/reload-sync() actions to re-invoke this same
# script — those run as independent subprocesses in fzf's own cwd (not
# necessarily this script's directory, and not necessarily the cwd the
# dashboard was originally launched from), so a bare/relative "$0" can't be
# trusted there the way it can at top-level sourcing above.
_dashboard_self="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)/$(basename "$0")"

# ──────────────────────────────────────────────────────────────────────────
# Adaptive header width. A right-side preview means --header only gets the
# LIST column's share of the popup (~45%, not the popup's own width — see
# dashboard-preview-render-fix's correction) — but that column's absolute
# width still varies a lot by terminal (a 27-char "?:help q:close" fallback
# is only necessary on a narrow terminal; a wide one has room for the real
# keybinding list). Measure the actual client width and pick accordingly,
# instead of hardcoding for the narrowest case everyone pays for.
# ──────────────────────────────────────────────────────────────────────────
_dashboard_header_budget() {
  local client_w
  client_w=$(tmux display-message -p '#{client_width}' 2>/dev/null) || client_w=100
  # popup is 90% of client width, list column is ~45% of the popup, minus a
  # few columns for the row-select border/marker and rounding slack.
  echo $(( client_w * 90 / 100 * 45 / 100 - 4 ))
}

# ──────────────────────────────────────────────────────────────────────────
# Status glyphs: the mapping itself (lazy_llm_status_glyph /
# lazy_llm_status_color) lives in the lib, shared with llm-status and
# llm-pane-border. The dashboard only adds the ANSI wrapping below — these
# are raw truecolor escapes (\033[38;2;R;G;Bm), not tmux's #[fg=...]
# syntax, since this is plain fzf row text shown via --ansi, a different
# rendering context than the status-right segment or pane border.
# ──────────────────────────────────────────────────────────────────────────
_ansi_fg() {
  local hex="${1#\#}"
  printf '\033[38;2;%d;%d;%dm' "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))"
}

# Glyph wrapped in its status color + reset — what tree rows actually use.
glyph_for_colored() {
  printf '%s%s\033[0m' "$(_ansi_fg "$(lazy_llm_status_color "$1")")" "$(lazy_llm_status_glyph "$1")"
}

# Extract the workspace/session name from a tree row id ("ws:<name>" or
# "pane:<name>:<idx0>:<pane_id>" — see the row-model comment above
# render_sessions_tab). Shared by the interactive dispatch below and by
# --fold-transform (invoked out-of-process by fzf's transform(...), which
# only has the raw id, not the parsed chosen_ws render_sessions_tab computes
# for its own accept path). Echoes empty for an unrecognized id.
_dashboard_ws_from_id() {
  local id="$1"
  case "$id" in
    ws:*)   printf '%s' "${id#ws:}" ;;
    pane:*) local rest="${id#pane:}"; printf '%s' "${rest%%:*}" ;;
  esac
}

# ──────────────────────────────────────────────────────────────────────────
# Workspaces tab
# ──────────────────────────────────────────────────────────────────────────

# Row model: each line is "<id>\t<display text>". <id> is hidden from view via
# --with-nth=2 (fzf still returns the full line on selection, and {1} in the
# preview command always refers to the hidden id field regardless of
# --with-nth). This is what lets a single fzf list mix two row types:
#   ws:<name>                    — a workspace row
#   pane:<name>:<idx0>:<pane_id> — an AI pane row nested under workspace <name>,
#                                  <idx0> is its 0-based index into that
#                                  workspace's @AI_PANES list
#
# Collapse state lives in a per-workspace tmux option (@lazy_llm_collapsed —
# see lazy_llm_read_collapsed/lazy_llm_toggle_collapsed in lazy-llm-lib.sh),
# NOT an in-process bash array: the 'z' fold/unfold key is bound directly to
# fzf's transform() action (see below) so folding no longer exits and
# relaunches fzf — and transform()'s command runs as an independent
# subprocess with no access to this script's memory, so anything it needs
# (fold flags, the row data itself) has to be readable from outside the
# process. --emit-rows (dispatched from the CLI-parsing block at the bottom
# of this file) is that same row-building logic exposed as a standalone mode
# for exactly this reason; render_sessions_tab and --emit-rows both call
# _dashboard_build_rows so there's one source of truth for the row format.
# --fold-transform (also dispatched from that CLI-parsing block) is
# transform()'s own target: it toggles the fold flag AND works out where the
# cursor should land in the reloaded list, in one out-of-process call — see
# its own comment for why cursor placement can't be left to fzf's --track.
#
# Returns (echoes) one of:
#   "tab:worktrees"                      — switch to worktrees tab
#   "action:switch:<name>"               — switch to selected workspace
#   "action:switch-pane:<name>:<idx0>"   — switch to workspace + focus that pane
#   "action:kill:<name>"                 — kill selected workspace
#   "action:rename:<name>"               — rename selected workspace
#   "action:rename-pane:<name>:<idx0>"   — rename that pane's DISPLAY label
#   "action:pane-add"                    — add AI pane to the CURRENT workspace
#                                           (the one this dashboard was opened
#                                           from — not whatever's highlighted;
#                                           see help text)
#   "action:pane-remove:<idx0>"          — remove a pane from the CURRENT workspace
#   "action:pane-remove-unsupported"     — K pressed on a pane row belonging to a
#                                           workspace other than the current one
#   "action:pane-next" / "action:pane-prev" — cycle panes in the CURRENT workspace
#   "action:refresh"                     — re-render the tab
#   "tab:help"                            — switch to the Help tab
#   "quit"                               — exit dashboard
# (fold/unfold does NOT round-trip through this return value — 'z' never
# exits fzf, see the fzf --bind list below.)

# Build the Workspaces tree's row list. Factored out of render_sessions_tab so
# --emit-rows (fzf's reload-sync() target for the fold key) can produce the
# exact same rows from a cold, standalone process invocation. Called DIRECTLY
# (not via command substitution) — a subshell would make the REPLY_START_POS
# side-output invisible to the caller — same REPLY_* convention
# lazy-llm-lib.sh's own multi-state readers already use.
#
# Args:   $1 launch_ws (may be empty) — used only to compute the initial
#         cursor row; irrelevant to a reload (cursor placement across a fold
#         reload is computed explicitly by --fold-transform and applied via
#         pos(N), not by recomputing a start position here).
# Sets:   REPLY_ROWS (the row list, "" if no workspaces),
#         REPLY_START_POS (1-based initial cursor row, default 1)
_dashboard_build_rows() {
  local launch_ws="$1"
  local data
  data=$(lazy_llm_gather_sessions)
  # Apply the persisted MANUAL order (dashboard-manual-list-reordering,
  # Ctrl+Up/Down) before anything below walks $data — this is the one
  # place workspace order gets applied; render_sessions_tab, --emit-rows
  # and --reorder-transform all go through this function, so there's a
  # single source of truth for the applied order, same reasoning as
  # _dashboard_build_rows itself existing. A workspace not yet in the
  # persisted order is appended in gather_sessions's own natural order
  # (see lazy_llm_apply_ws_order) — never silently hidden.
  data=$(lazy_llm_apply_ws_order "$data")
  # Deliberately NOT auto-reordered to put the launch workspace first. Tried
  # that (awk-based reorder, same idea as a "most recently used" list) and
  # it was explicitly rejected: it defeats the point of the cursor
  # highlight now that load:pos(N) actually works — a STABLE list order
  # (same position every time, regardless of which workspace is active) is
  # what makes the tree glanceable and short-term learnable across repeat
  # visits; re-sorting it on every open adds back the exact cognitive load
  # the highlight was meant to remove. lazy_llm_gather_sessions's own order
  # (tmux list-sessions's order — stable across invocations, doesn't
  # change with activity) is used as-is; load:pos(N) below still jumps the
  # cursor straight to the active pane wherever it naturally falls.

  REPLY_ROWS=""
  REPLY_START_POS=1
  local lines="" _line_no=0
  if [[ -n "$data" ]]; then
    while IFS=$'\t' read -r name dir tools wins attached; do
      local first_win
      first_win=$(tmux list-windows -t "$name" -F '#{window_index}' 2>/dev/null | head -1)

      # Full per-pane list for this workspace's first window — every AI pane
      # gets its own row + glyph, not just the first (the old Sessions tab's
      # limitation this task exists to fix).
      local reply_panes reply_tools reply_idx reply_names
      lazy_llm_read_multi_state_for "$name" "$first_win"
      reply_panes="$REPLY_PANES"; reply_tools="$REPLY_TOOLS"; reply_idx="${REPLY_IDX:-0}"
      reply_names="$REPLY_PANE_NAMES"

      local -a pane_arr=() tool_arr=()
      if [[ -n "$reply_panes" ]]; then
        read -ra pane_arr <<< "$reply_panes"
        read -ra tool_arr <<< "$reply_tools"
      else
        # Legacy/single-pane fallback: @AI_PANES was never set for this window
        # (e.g. a workspace that's never had a second pane added).
        local single_pane_id
        single_pane_id=$(tmux show-option -wv -t "$name:$first_win" @AI_PANE_ID 2>/dev/null) || single_pane_id=""
        if [[ -n "$single_pane_id" ]]; then
          local single_tool
          single_tool=$(tmux show-option -wv -t "$name:$first_win" @AI_TOOL 2>/dev/null) || single_tool="${tools%% *}"
          pane_arr=("$single_pane_id")
          tool_arr=("$single_tool")
        fi
      fi

      # "Active pane" heuristic: tmux's OWN per-window pane_active flag —
      # the pane last given real focus in that window — instead of
      # @AI_PANE_IDX (only updated by llm-cycle, so it goes stale the moment
      # focus moves any other way: mouse click, prefix+arrow, etc.).
      # Reported directly as "still not working" after the @AI_PANE_IDX
      # version; tmux already tracks this natively and correctly per window,
      # no extra bookkeeping needed. Falls back to @AI_PANE_IDX only when
      # the actually-focused pane isn't one of this workspace's AI panes at
      # all (e.g. focus is on the editor/prompt pane, not an AI one).
      local focused_pane_id focus_i
      focused_pane_id=$(tmux list-panes -t "$name:$first_win" -f '#{pane_active}' -F '#{pane_id}' 2>/dev/null | head -1) || focused_pane_id=""
      if [[ -n "$focused_pane_id" ]]; then
        for focus_i in "${!pane_arr[@]}"; do
          [[ "${pane_arr[$focus_i]}" == "$focused_pane_id" ]] && { reply_idx="$focus_i"; break; }
        done
      fi

      # Workspace row's aggregate glyph: worst-case across its panes, in the
      # order a human would want to notice — blocked-on-you beats
      # your-turn beats busy beats idle.
      local saw_waiting=false saw_unread=false saw_working=false saw_idle=false
      local i st
      for i in "${!pane_arr[@]}"; do
        st=$(lazy_llm_detect_pane_status "${pane_arr[$i]}" "${tool_arr[$i]:-claude}")
        case "$st" in
          waiting) saw_waiting=true ;;
          unread)  saw_unread=true ;;
          working) saw_working=true ;;
          idle)    saw_idle=true ;;
        esac
      done
      local agg_glyph
      agg_glyph=$(glyph_for_colored unknown)
      if   [[ "$saw_waiting" == true ]]; then agg_glyph=$(glyph_for_colored waiting)
      elif [[ "$saw_unread"  == true ]]; then agg_glyph=$(glyph_for_colored unread)
      elif [[ "$saw_working" == true ]]; then agg_glyph=$(glyph_for_colored working)
      elif [[ "$saw_idle"    == true ]]; then agg_glyph=$(glyph_for_colored idle)
      fi

      local short_dir="${dir/#$HOME/\~}"
      [[ ${#short_dir} -gt 40 ]] && short_dir="...${short_dir: -37}"
      local mark=""
      [[ -n "$attached" ]] && mark=" *"

      local collapsed
      collapsed=$(lazy_llm_read_collapsed "$name")
      local fold_glyph="▾"
      [[ "$collapsed" == "1" ]] && fold_glyph="▸"

      local ws_display
      ws_display=$(printf '%s %-26s  %-40s  %s %-14s %sw%s' \
        "$fold_glyph" "$name" "$short_dir" "$agg_glyph" "$tools" "$wins" "$mark")
      lines+="ws:${name}"$'\t'"${ws_display}"$'\n'
      _line_no=$((_line_no + 1))
      # Fallback start position: the launch workspace's own row, in case it
      # has no pane rows to land on below (collapsed, or no panes at all).
      [[ "$name" == "$launch_ws" ]] && REPLY_START_POS=$_line_no

      if [[ "$collapsed" != "1" ]]; then
        for i in "${!pane_arr[@]}"; do
          local pid="${pane_arr[$i]}" tool="${tool_arr[$i]:-?}" glyph
          # Display label: the custom rename if one's set (and isn't the
          # "_" no-override placeholder), else the tool name. Status
          # detection below always uses $tool, never the display label —
          # renaming a pane must not change what it's detected as.
          local display_label
          display_label=$(lazy_llm_pane_display_label "$tool" "$reply_names" "$i")
          st=$(lazy_llm_detect_pane_status "$pid" "$tool")
          glyph=$(glyph_for_colored "$st")
          local pane_display
          pane_display=$(printf '    ↳ %-12s %s' "$display_label" "$glyph")
          # Bold instead of an "(active)" text tag — real ANSI codes (not
          # tmux's #[..] syntax), since this is plain fzf row text rendered
          # via --ansi, a different rendering context than status-right/
          # pane-border-format.
          [[ "$i" -eq "$reply_idx" ]] && pane_display=$'\033[1m'"${pane_display}"$'\033[0m'
          lines+="pane:${name}:${i}:${pid}"$'\t'"${pane_display}"$'\n'
          _line_no=$((_line_no + 1))
          # Precise start position: this workspace's currently-active pane.
          [[ "$name" == "$launch_ws" && "$i" -eq "$reply_idx" ]] && REPLY_START_POS=$_line_no
        done
      fi
    done <<< "$data"
    lines="${lines%$'\n'}"
  fi
  REPLY_ROWS="$lines"
}

render_sessions_tab() {
  # Resolve the workspace this dashboard was launched from, if any — needed to
  # scope 'a' / ']' / '[' / pane-row 'K' to the current workspace only (see
  # header comment). A popup opened from outside any lazy-llm window (or from
  # no tmux session at all) leaves this empty; the tree still renders fine,
  # those specific actions just become unavailable/no-ops, same as they'd be
  # unreachable entirely in the pre-merge Panes tab under the same condition.
  # Prefer the explicit value llm-dashboard-open resolved and passed in
  # (-e LAZY_LLM_LAUNCH_SESSION=...) — verified live that a popup's child
  # process does NOT reliably inherit the calling session via ambient
  # resolution (TMUX_PANE unset inside it, and the display-message fallback
  # resolved to an unrelated session in testing). Fall back to the ambient
  # lookup only for direct `llm-dashboard` invocation without the wrapper
  # (e.g. manual CLI use, `--tab` testing).
  local launch_ws="${LAZY_LLM_LAUNCH_SESSION:-}"
  if [[ -z "$launch_ws" ]] && lazy_llm_resolve_pane 2>/dev/null && lazy_llm_resolve_session_window 2>/dev/null; then
    launch_ws="$_SESSION"
  fi

  _dashboard_build_rows "$launch_ws"
  local lines="$REPLY_ROWS"
  local _start_pos="$REPLY_START_POS"

  local header
  if [[ -z "$lines" ]]; then
    header="no workspaces yet"
  else
    # Deliberately short and static — NOT an enumeration of every key. With a
    # right-side preview active, --header's available width is the LIST
    # column's share (~45% of the popup), not the popup's own width. Universal
    # nav (tab switching, help, close) lives in the popup's own title bar now
    # (see llm-dashboard-open) — full popup width, single line, can't wrap
    # awkwardly inside the box the way a --header line could. This header is
    # just the tab-specific action keys, sized to what actually fits; the
    # full reference is always in the Help tab too.
    local _budget
    _budget=$(_dashboard_header_budget)
    # Status glyph legend — same idea as the action hints: only shown when
    # it actually fits, as its own line (each line is sized independently;
    # what made the old multi-line header "look awful" was content that
    # didn't fit its column, not multi-line headers as such).
    # "? unknown" is left to the Help tab — rare, and it kept this line short.
    local _legend="◐ waiting  ◉ unread  ● working  ○ idle"
    if [[ "$_budget" -ge 85 ]]; then
      header="/:search enter:switch K:kill/rm r:rename z:fold a:add-pane ]/[:cycle-pane R:refresh"
      [[ "$_budget" -ge 40 ]] && header+=$'\n'"$_legend"
    elif [[ "$_budget" -ge 50 ]]; then
      header="/:search enter:switch K:kill a:add-pane R:refresh"
      [[ "$_budget" -ge 40 ]] && header+=$'\n'"$_legend"
    else
      header=""
    fi
  fi

  # Preview: branch on the row's hidden id (field 1) to find the right pane —
  # a workspace row previews its active pane, a pane row previews itself.
  local preview_cmd
  preview_cmd='set -- {1}; id="$1"; pid=""; '
  preview_cmd+='case "$id" in '
  preview_cmd+='ws:*) ws="${id#ws:}"; win=$(tmux list-windows -t "$ws" -F "#{window_index}" 2>/dev/null | head -1); '
  preview_cmd+='pid=$(tmux show-option -wv -t "$ws:$win" @AI_PANE_ID 2>/dev/null) ;; '
  preview_cmd+='pane:*) rest="${id#pane:}"; pid="${rest##*:}" ;; '
  preview_cmd+='esac; '
  preview_cmd+='if [ -n "$pid" ]; then '
  preview_cmd+='tmux capture-pane -p -e -S -200 -t "$pid" 2>/dev/null || echo "(could not capture pane $pid)"; '
  preview_cmd+='else echo "(no AI pane to preview)"; fi'

  # Modal search. --expect's single-key actions (r, K, a, ...) ALWAYS
  # intercept their key the instant it's pressed, even mid-query with
  # --disabled/--no-input active — confirmed by direct testing: those two
  # flags only gate whether OTHER, unbound characters reach the query, they
  # don't touch --expect at all, so --expect-only can't be fixed this way.
  # The real fix: drop --expect and give each action key an explicit
  # `print(KEY)+accept` --bind (same two-line "key\nselection" stdout shape
  # --expect produced — verified byte-for-byte — so dispatch's `head -1`/
  # `tail -1` parsing below needs no changes), then use unbind(...)/
  # rebind(...) to actually REMOVE those key bindings while searching and
  # restore them on exit. "/" unbinds them, hides+enables the query input;
  # tab clears the query, hides the input, and rebinds them. NOT esc for
  # "leave search" — tried that first, but it meant esc no longer closed
  # the dashboard while searching, reported directly ("I'd like to keep
  # the behavior that it always closes the dashboard as it was before").
  # Esc is deliberately left unbound here so it falls back to fzf's own
  # default (abort) unconditionally, in every mode — "q" remains the other
  # close key, unchanged. `enter` gets its own explicit `print()+accept`
  # (empty key line) so a plain switch/open still round-trips through the
  # same two-line shape; it's never unbound since Enter is never a filter
  # character. Fixes the "fuzzy search crashes the pane after the third
  # filter keystroke" report, which was --expect's action keys firing
  # mid-filter, not a crash.
  # --height=100%: the user's own shell exports FZF_DEFAULT_OPTS with
  # "--height 40%" (a sane default for ad-hoc interactive fzf use), which
  # every fzf call in THIS script silently inherits unless overridden —
  # confirmed live as the actual cause of "big outer popup, fixed small
  # inner pane" (chat preview, git log, and the Help tab all stopped short
  # at ~40% of the popup's real height, exactly matching the report; a
  # plain --height=100% test in the same popup filled it completely). A
  # script embedding fzf for its own UI should never rely on the invoking
  # shell's ambient fzf preferences — every fzf call below sets its own
  # --height explicitly for this reason, not just this one.
  #
  # 'z' (fold/unfold) is deliberately NOT a print(z)+accept binding like the
  # other action keys — it never exits fzf at all. It's bound directly to
  # transform(...): fzf runs the command and interprets its STDOUT as a
  # further chain of actions to perform (`man fzf`, transform(...) action).
  # --fold-transform (the command run) toggles this row's workspace's fold
  # flag out-of-process ({1} is the hidden id field — same idiom the preview
  # command above already uses for {1}), rebuilds the row list, and prints
  # back `reload-sync(... --emit-rows)+pos(N)` — reload-sync() swaps in the
  # new list in the SAME running fzf process (no exit, no relaunch, no
  # flicker — verified live: identical fzf PID across a fold action, via
  # `ps --ppid <popup pane pid> --forest`), and the chained pos(N) explicitly
  # places the cursor afterward. reload-sync specifically, NOT plain reload —
  # see --fold-transform's own comment for why: a plain reload(...)+pos(N) in
  # one transform() output races (reload is async, pos(N) can land before/
  # during it and gets discarded), confirmed live with a minimal repro before
  # this was caught.
  #
  # An earlier version of this used fzf's own --track --id-nth=1 (tracks the
  # cursor across a reload by the hidden id field) instead of an explicit
  # pos(N). That works for the common case (cursor on the toggled workspace
  # row itself — its id survives the reload, --track keeps the cursor on it
  # despite the fold glyph changing), but --track has no structural fallback
  # when the tracked id vanishes ENTIRELY from the reloaded list — which is
  # exactly what happens when the cursor is on a nested pane row and 'z'
  # folds that row's own parent workspace (folding always hides that
  # workspace's pane rows, and a pane row can only be focused while its
  # workspace is expanded, so this vanish case is the ONLY thing that can
  # happen when 'z' is pressed on a pane row — never the reverse). Verified
  # live (fzf 0.74.3, ANSI-aware `capture-pane -e`, reproduced from clean
  # process state) that --track's actual fallback there is a reset to row 1,
  # not the parent row, and `man fzf`'s own --id-nth section documents why:
  # with --id-nth, --track's search for the tracked key BLOCKS cursor
  # movement/query input until a match is found in the reload stream or the
  # user cancels (Esc/Ctrl-C) — when the id can never be found (because it's
  # genuinely gone), that's a real risk of a stuck/blocked UI, not just a
  # cosmetic wrong-row landing. --fold-transform computes the correct target
  # explicitly instead (same row's id if it survives, else its parent
  # workspace's "ws:<name>" row) and positions with pos(N), which fzf
  # documents as absolute-position placement, no tracking/search/blocking
  # involved — so --track/--id-nth were dropped from this fzf call entirely
  # (not layered underneath) once pos(N) already covers every case,
  # including the one --track used to.
  #
  # Ctrl-Up/Ctrl-Down (dashboard-manual-list-reordering) copy 'z'/
  # --fold-transform's shape exactly, for the same reasons: bound directly
  # to transform(...), never round-trip through print(KEY)+accept/exit, and
  # the out-of-process --reorder-transform handler (CLI-parsing block at
  # the bottom of this file) does the mutate-rebuild-reposition dance and
  # prints back reload-sync(...)+pos(N) — reload-sync, not reload, for the
  # identical confirmed-live async race --fold-transform's own comment
  # documents. Scoped to the row's own tree level inside
  # --reorder-transform: a "ws:" id reorders among workspaces
  # (lazy_llm_move_ws_order, persisted to the server-scoped
  # @lazy_llm_ws_order option), a "pane:" id reorders among that
  # workspace's own panes only (lazy_llm_move_pane_order, persisted
  # straight into @AI_PANES/@AI_TOOLS/@AI_PANE_NAMES — no separate order
  # option needed, those arrays' own element order IS the pane order).
  # Both helpers no-op (not error) at either end of their sibling list.
  #
  # 'k'/'j' are plain alternates for Ctrl-Up/Ctrl-Down (same
  # --reorder-transform call, same up/down direction) — direct request:
  # Ctrl+Arrow doesn't reach this popup cleanly over some SSH/tunneled
  # terminals (the combo gets eaten or remapped somewhere in the chain),
  # so a modifier-free vim-style fallback was needed. Safe to bind as plain
  # letters for the same reason 'z'/'a'/'r'/'K'/'R'/'?' already are: this
  # fzf instance runs with --disabled --no-input, so no key does anything
  # unless explicitly bound, and the '/'-search unbind/rebind lists already
  # remove every single-letter action key (this pair included) the instant
  # '/' is pressed — 'j'/'k' remain fully typable in a search query, same
  # as any other action letter already is.
  local -a _reorder_binds=(
    --bind="ctrl-up:transform($_dashboard_self --reorder-transform up {1})"
    --bind="ctrl-down:transform($_dashboard_self --reorder-transform down {1})"
    --bind='/:unbind(1,2,K,r,R,z,a,],[,?,ctrl-up,ctrl-down,j,k)+show-input+enable-search'
    --bind='tab:clear-query+hide-input+rebind(1,2,K,r,R,z,a,],[,?,ctrl-up,ctrl-down,j,k)'
  )
  if ! fzf --bind='ctrl-up:abort' --filter='' </dev/null >/dev/null 2>&1; then
    _reorder_binds=(
      --bind="alt-up:transform($_dashboard_self --reorder-transform up {1})"
      --bind="alt-down:transform($_dashboard_self --reorder-transform down {1})"
      --bind='/:unbind(1,2,K,r,R,z,a,],[,?,alt-up,alt-down,j,k)+show-input+enable-search'
      --bind='tab:clear-query+hide-input+rebind(1,2,K,r,R,z,a,],[,?,alt-up,alt-down,j,k)'
    )
  fi

  local selection key
  selection=$(printf '%s\n' "$lines" | fzf \
    --height=100% \
    --ansi \
    --reverse \
    --border=rounded \
    --prompt="workspace> " \
    --header="$header" \
    --delimiter=$'\t' \
    --with-nth=2 \
    --preview="$preview_cmd" \
    --preview-window="right:55%:follow" \
    --disabled --no-input \
    --bind='enter:print()+accept' \
    --bind='1:print(1)+accept' --bind='2:print(2)+accept' \
    --bind='K:print(K)+accept' --bind='r:print(r)+accept' --bind='R:print(R)+accept' \
    --bind="z:transform($_dashboard_self --fold-transform {1})" \
    --bind='a:print(a)+accept' \
    --bind=']:print(])+accept' --bind='[:print([)+accept' --bind='?:print(?)+accept' \
    --bind="k:transform($_dashboard_self --reorder-transform up {1})" \
    --bind="j:transform($_dashboard_self --reorder-transform down {1})" \
    "${_reorder_binds[@]}" \
    --bind='q:abort' \
    --bind="load:pos(${_start_pos})+unbind(load)" \
  ) || { echo "quit"; return 0; }
  # `load`, not `start` — this is the actual bug behind "cursor always
  # lands on the first (workspace) row, never the active pane," reported
  # across multiple rounds despite every UPSTREAM computation (_start_pos,
  # the active-pane heuristic) checking out correct every time. Confirmed
  # directly, pixel-for-pixel: capture-pane -e against a minimal
  # reproduction showed pos(3) correctly highlighting row 3 when bound to
  # a real keypress, but silently landing on row 1 when bound to the
  # `start` event — `start` fires before fzf's list is far enough along
  # for pos() to act on meaningfully; `load` (fires once the initial data
  # load completes) is the correct event for an initial cursor position.
  # This was never caught earlier because every previous verification
  # pass checked _start_pos's VALUE (via debug prints) or pos()'s
  # mechanism in isolation (triggered by a real key) — never the actual
  # `start:pos(N)` binding rendered live with -e capture, which is the
  # only way this specific failure shows up.
  #
  # `+unbind(load)` (dashboard-reload-avoid-full-redraw rework round):
  # `load` is NOT a one-shot "very first render" event the way it reads —
  # confirmed live that it fires again on every SUBSEQUENT reload-sync(...)
  # too (once the new list finishes loading), same as it does at startup.
  # Left bound permanently, `load:pos(${_start_pos})` re-fires every time
  # 'z' folds/unfolds and forces the cursor back to wherever it was at
  # DASHBOARD LAUNCH, silently overriding --fold-transform's own explicit
  # `pos(N)` for the row the cursor should land on after THIS reload — the
  # two pos() calls race and `load`'s always won in testing. This was the
  # actual root cause of the "cursor resets to row 1" bug the Verify Report
  # caught (not a `--track` limitation, and not something `reload-sync`
  # alone fixes — reload-sync was ALSO a genuine, separately-confirmed fix
  # for an unrelated reload()-vs-pos() race, see --fold-transform's own
  # comment, but by itself was not sufficient: with `load` still bound
  # permanently, the symptom simply changed from "always row 1" to "always
  # the launch-time row," which happened to equal row 1 in the exact repro
  # used here but is the same class of bug). `+unbind(load)` makes the
  # `load` bind fire exactly once — for the real initial launch position —
  # and never again, so later reloads are governed solely by whatever
  # explicit `pos(N)` that specific action chain provides. Verified live:
  # without `+unbind(load)`, a minimal reproduction fzf instance with an
  # otherwise-identical bind list reset to row 1 after every reload despite
  # its own transform() chain explicitly calling `pos(2)`; adding
  # `+unbind(load)` alone (no other change) fixed it.

  key=$(echo "$selection" | head -1)
  local chosen_line chosen_id
  chosen_line=$(echo "$selection" | tail -1)
  chosen_id=$(printf '%s' "$chosen_line" | cut -f1)

  local chosen_ws="" chosen_pane_idx=""
  case "$chosen_id" in
    ws:*)
      chosen_ws="${chosen_id#ws:}"
      ;;
    pane:*)
      local rest="${chosen_id#pane:}"
      chosen_ws="${rest%%:*}"
      local rest2="${rest#*:}"
      chosen_pane_idx="${rest2%%:*}"
      ;;
  esac

  case "$key" in
    1)     echo "action:refresh" ;;
    2)     echo "tab:worktrees" ;;
    K)
      if [[ -n "$chosen_pane_idx" ]]; then
        if [[ -n "$launch_ws" && "$chosen_ws" == "$launch_ws" ]]; then
          echo "action:pane-remove:$chosen_pane_idx"
        else
          echo "action:pane-remove-unsupported"
        fi
      elif [[ -n "$chosen_ws" ]]; then
        echo "action:kill:$chosen_ws"
      else
        echo "action:refresh"
      fi
      ;;
    r)
      if [[ -n "$chosen_pane_idx" ]]; then
        echo "action:rename-pane:$chosen_ws:$chosen_pane_idx"
      elif [[ -n "$chosen_ws" ]]; then
        echo "action:rename:$chosen_ws"
      else
        echo "action:refresh"
      fi
      ;;
    R)     echo "action:refresh" ;;
    a)     echo "action:pane-add" ;;
    "]")   echo "action:pane-next" ;;
    "[")   echo "action:pane-prev" ;;
    "?")   echo "tab:help" ;;
    *)
      if [[ -z "$chosen_ws" ]]; then
        echo "quit"
      elif [[ -n "$chosen_pane_idx" ]]; then
        echo "action:switch-pane:$chosen_ws:$chosen_pane_idx"
      else
        echo "action:switch:$chosen_ws"
      fi
      ;;
  esac
}

# ──────────────────────────────────────────────────────────────────────────
# Worktrees tab (placeholder)
# ──────────────────────────────────────────────────────────────────────────

render_worktrees_tab() {
  local data lines header
  data=$(lazy_llm_gather_worktrees)

  if [[ -z "$data" ]]; then
    lines="(No worktrees in this repo, or not inside a git repo.)"
    header="no worktrees — n:new"
  else
    lines=""
    while IFS=$'\t' read -r path branch dirty ahead behind session pr; do
      local short_path="${path/#$HOME/\~}"
      [[ ${#short_path} -gt 38 ]] && short_path="...${short_path: -35}"

      local dirty_mark="${dirty:- }"
      local ab="↑${ahead} ↓${behind}"
      local sess_mark=" "
      [[ -n "$session" ]] && sess_mark="●"
      local pr_mark="   "
      case "$pr" in
        OPEN)   pr_mark="PR●" ;;
        MERGED) pr_mark="PR✓" ;;
        CLOSED) pr_mark="PRx" ;;
      esac

      lines+=$(printf '%-38s  %-24s %s  %-10s %s  %s' \
        "$short_path" "$branch" "$dirty_mark" "$ab" "$sess_mark" "$pr_mark")
      lines+=$'\n'
    done <<< "$data"
    lines="${lines%$'\n'}"
    # Adaptive width — see the matching comment on the Workspaces tab's header.
    local _budget
    _budget=$(_dashboard_header_budget)
    if [[ "$_budget" -ge 50 ]]; then
      header="/:search enter:open n:new g:lazygit K:cleanup R:refresh"
    elif [[ "$_budget" -ge 30 ]]; then
      header="/:search enter:open n:new K:cleanup"
    else
      header=""
    fi
  fi

  # Preview: git status -sb + recent log for the selected worktree path.
  local preview_cmd
  preview_cmd='set -- {1}; '
  preview_cmd+='wt="$1"; wt="${wt/#\~/$HOME}"; '
  preview_cmd+='if git -C "$wt" rev-parse --git-dir >/dev/null 2>&1; then '
  preview_cmd+='echo "=== git status ==="; git -C "$wt" -c color.status=always status -sb 2>&1 | head -20; '
  preview_cmd+='echo; echo "=== git log -10 ==="; git -C "$wt" -c color.ui=always log --oneline -10 2>&1; '
  preview_cmd+='else echo "(preview unavailable: $wt)"; fi'

  # Modal search + --height=100% — see the matching comments on the
  # Workspaces tab's fzf call.
  local selection key
  selection=$(echo "$lines" | fzf \
    --height=100% \
    --ansi \
    --reverse \
    --border=rounded \
    --prompt="worktree> " \
    --header="$header" \
    --preview="$preview_cmd" \
    --preview-window="right:55%:follow" \
    --disabled --no-input \
    --bind='enter:print()+accept' \
    --bind='1:print(1)+accept' --bind='2:print(2)+accept' \
    --bind='n:print(n)+accept' --bind='g:print(g)+accept' \
    --bind='K:print(K)+accept' --bind='R:print(R)+accept' --bind='?:print(?)+accept' \
    --bind='/:unbind(1,2,n,g,K,R,?)+show-input+enable-search' \
    --bind='tab:clear-query+hide-input+rebind(1,2,n,g,K,R,?)' \
    --bind='q:abort' \
  ) || { echo "quit"; return 0; }

  key=$(echo "$selection" | head -1)
  local chosen_line chosen_path
  chosen_line=$(echo "$selection" | tail -1)
  chosen_path=$(echo "$chosen_line" | awk '{print $1}')
  chosen_path="${chosen_path/#\~/$HOME}"
  [[ -d "$chosen_path" ]] || chosen_path=""

  case "$key" in
    1)   echo "tab:workspaces" ;;
    2)   echo "action:refresh" ;;
    n)   echo "action:worktree-new" ;;
    g)   [[ -z "$chosen_path" ]] && echo "action:refresh" || echo "action:worktree-lazygit:$chosen_path" ;;
    K)   [[ -z "$chosen_path" ]] && echo "action:refresh" || echo "action:worktree-cleanup:$chosen_path" ;;
    R)   echo "action:refresh" ;;
    "?") echo "tab:help" ;;
    *)
      [[ -z "$chosen_path" ]] && echo "quit" || echo "action:worktree-open:$chosen_path"
      ;;
  esac
}

# ──────────────────────────────────────────────────────────────────────────
# Action dispatch
# ──────────────────────────────────────────────────────────────────────────

dispatch_action() {
  local action="$1"
  case "$action" in
    action:switch:*)
      local name="${action#action:switch:}"
      tmux switch-client -t "$name" 2>/dev/null \
        || tmux attach-session -t "$name" 2>/dev/null \
        || echo "Could not switch to $name" >&2
      # switching exits the popup naturally
      ;;
    action:switch-pane:*)
      # Switch to the workspace AND focus a specific pane in it. Uses
      # lazy_llm_cycle_to_index with an explicit session:window target rather
      # than llm-cycle's ambient "current pane" resolution — after
      # switch-client, ambient resolution from inside this popup process
      # can't be trusted to follow the client to the new window (untested
      # tmux edge case; explicit targeting sidesteps the question entirely).
      # Order matters: cycle BEFORE switching, so the pane is already in
      # place by the time the client lands on the window.
      local rest="${action#action:switch-pane:}"
      local name="${rest%%:*}"
      local idx="${rest#*:}"
      local win
      win=$(tmux list-windows -t "$name" -F '#{window_index}' 2>/dev/null | head -1)
      [[ -n "$win" ]] && lazy_llm_cycle_to_index "$name" "$win" "$idx"
      # Picking a pane row is looking at it, even when it was already the
      # one in view (cycle_to_index no-ops then, and clears nothing).
      local picked_pane
      picked_pane=$(tmux show-option -wv -t "$name:$win" @AI_PANES 2>/dev/null | awk -v i="$idx" '{print $(i+1)}') || picked_pane=""
      lazy_llm_clear_unread "$picked_pane"
      tmux switch-client -t "$name" 2>/dev/null \
        || tmux attach-session -t "$name" 2>/dev/null \
        || echo "Could not switch to $name" >&2
      ;;
    action:kill:*)
      local name="${action#action:kill:}"
      # Use llm-sessions --kill for the validated kill path (checks @lazy_llm marker)
      local confirm
      confirm=$(printf 'no\nyes' | fzf \
        --height=100% --reverse --border=rounded --header="Kill workspace '$name'?" \
        --prompt="confirm> " || echo no)
      if [[ "$confirm" == "yes" ]]; then
        "$HOME/.local/bin/llm-sessions" --kill "$name" >&2 || true
      fi
      ;;
    action:rename:*)
      local name="${action#action:rename:}"
      local new_name
      new_name=$(echo "" | fzf --print-query \
        --height=100% --reverse --border=rounded \
        --header="Rename workspace '$name' to:" \
        --prompt="new name> " \
        --query="$name" \
        --no-info \
        --bind 'enter:accept-non-empty' \
        --expect=enter | head -1 || true)
      if [[ -n "$new_name" ]] && [[ "$new_name" != "$name" ]]; then
        tmux rename-session -t "$name" "$new_name" 2>/dev/null \
          || echo "Could not rename to $new_name" >&2
      fi
      ;;
    action:rename-pane:*)
      # Per-pane DISPLAY label, stored separately from @AI_TOOLS (which
      # still names the actual tool binary/detection pattern — renaming a
      # pane must not break status detection). @AI_PANE_NAMES is a
      # space-separated array parallel to @AI_TOOLS/@AI_PANES; "_" marks a
      # slot with no override (falls back to the tool name).
      local rest="${action#action:rename-pane:}"
      local name="${rest%%:*}"
      local idx="${rest#*:}"
      local win
      win=$(tmux list-windows -t "$name" -F '#{window_index}' 2>/dev/null | head -1)
      if [[ -n "$win" ]]; then
        lazy_llm_read_multi_state_for "$name" "$win"
        local -a tool_arr=() name_arr=()
        read -ra tool_arr <<< "$REPLY_TOOLS"
        if [[ -n "$REPLY_PANE_NAMES" ]]; then
          read -ra name_arr <<< "$REPLY_PANE_NAMES"
        fi
        # Pad name_arr out to tool_arr's length with "_" placeholders.
        local j
        for ((j = ${#name_arr[@]}; j < ${#tool_arr[@]}; j++)); do
          name_arr+=("_")
        done
        local current_label="${name_arr[$idx]:-_}"
        [[ "$current_label" == "_" ]] && current_label="${tool_arr[$idx]:-pane}"
        local new_label
        new_label=$(echo "" | fzf --print-query \
          --height=100% --reverse --border=rounded \
          --header="Rename pane $((idx + 1)) (currently '$current_label') to:" \
          --prompt="new label> " \
          --query="$current_label" \
          --no-info \
          --bind 'enter:accept-non-empty' \
          --expect=enter | head -1 || true)
        if [[ -n "$new_label" ]] && [[ "$new_label" != "$current_label" ]]; then
          name_arr[$idx]="$new_label"
          tmux set-option -w -t "$name:$win" @AI_PANE_NAMES "${name_arr[*]}"
        fi
      fi
      ;;
    action:refresh)
      : # outer loop re-renders the current tab
      ;;
    action:pane-add)
      local tool
      # `|| true`: without it, pressing Esc here makes fzf exit nonzero, and
      # since this is a bare assignment (not tested by any if/while/||),
      # `set -e` kills the WHOLE dashboard rather than just cancelling this
      # sub-prompt. Same class of bug as the one already fixed in
      # lazy_llm_detect_pane_status — found live: pressing 'a' then Esc closed
      # the entire popup instead of returning to the tree.
      tool=$(printf 'claude\njetski-cli\ngemini\nopencode\ncodex\ngrok\naider' | fzf \
        --height=100% --reverse --border=rounded --prompt="tool> " \
        --header="Pick an AI tool to add (esc to cancel):" \
        --no-info || true)
      [[ -n "$tool" ]] && "$HOME/.local/bin/llm-add" -t "$tool" >&2 || true
      ;;
    action:pane-remove:*)
      local idx="${action#action:pane-remove:}"
      [[ -z "$idx" ]] && return 0
      local confirm
      confirm=$(printf 'no\nyes' | fzf \
        --height=100% --reverse --border=rounded --header="Remove pane $idx?" \
        --prompt="confirm> " || echo no)
      [[ "$confirm" == "yes" ]] && "$HOME/.local/bin/llm-remove" -f "$idx" >&2 || true
      ;;
    action:pane-next)
      "$HOME/.local/bin/llm-cycle" next >&2 || true
      ;;
    action:pane-prev)
      "$HOME/.local/bin/llm-cycle" prev >&2 || true
      ;;
    action:pane-remove-unsupported)
      tmux display-message "Pane removal only works for the current workspace's panes today — switch to it first (Enter), then K."
      ;;
    action:worktree-open:*)
      local path="${action#action:worktree-open:}"
      local branch
      branch=$(git -C "$path" branch --show-current 2>/dev/null)
      if [[ -n "$branch" ]]; then
        "$HOME/.local/bin/lazy-llm" -W "$branch" >&2 || true
      fi
      ;;
    action:worktree-new)
      local new_branch
      # Same errexit hazard as action:pane-add above — `|| true` needed or
      # Esc here kills the whole dashboard.
      new_branch=$(echo "" | fzf --print-query --height=100% --reverse --border=rounded \
        --header="New worktree — branch name (will be created from HEAD if it doesn't exist):" \
        --prompt="branch> " --no-info \
        --bind 'enter:accept-non-empty' | head -1 || true)
      if [[ -n "$new_branch" ]]; then
        "$HOME/.local/bin/lazy-llm" -W "$new_branch" >&2 || true
      fi
      ;;
    action:worktree-lazygit:*)
      local path="${action#action:worktree-lazygit:}"
      if command -v lazygit >/dev/null 2>&1; then
        tmux display-popup -E -w 95% -h 90% "lazygit -p '$path'"
      else
        tmux display-message "lazygit not installed"
      fi
      ;;
    action:worktree-cleanup:*)
      local path="${action#action:worktree-cleanup:}"
      _dashboard_worktree_cleanup_flow "$path"
      ;;
  esac
}

# Cleanup flow with pre-flight warnings and dual confirms.
# Lives in the dashboard (not the lib) because the prompts are fzf-bound.
_dashboard_worktree_cleanup_flow() {
  local path="$1"
  local repo branch session ahead_count default warnings_text=""
  repo=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null) || return 1
  branch=$(git -C "$path" branch --show-current 2>/dev/null)
  if [[ -z "$branch" ]]; then
    tmux display-message "Detached worktree — refusing to cleanup"
    return 1
  fi

  default=$(lazy_llm_default_branch "$repo")

  if [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]]; then
    warnings_text+="⚠  Worktree has uncommitted changes"$'\n'
  fi
  ahead_count=$(git -C "$path" rev-list --count "origin/$default..HEAD" 2>/dev/null || echo 0)
  if [[ "$ahead_count" -gt 0 ]]; then
    warnings_text+="⚠  Branch is $ahead_count commits ahead of origin/$default — they will be lost if branch is deleted"$'\n'
  fi
  if ! git -C "$path" rev-parse --verify "@{u}" >/dev/null 2>&1; then
    warnings_text+="⚠  Branch has no upstream — local-only commits will be lost"$'\n'
  fi
  session=$(lazy_llm_find_session_for_path "$path")
  if [[ -n "$session" ]]; then
    warnings_text+="⚠  Will kill attached lazy-llm workspace '$session'"$'\n'
  fi
  if command -v gh >/dev/null 2>&1; then
    local pr_state
    pr_state=$(gh pr view "$branch" --json state -q .state 2>/dev/null) || pr_state=""
    [[ "$pr_state" == "OPEN" ]] && warnings_text+="⚠  Open PR — branch deletion may close it remotely"$'\n'
  fi

  local confirm body
  body=$(printf 'Cleanup worktree: %s\nBranch: %s\n%s' "$path" "$branch" "${warnings_text:-(no warnings — clean removal)}")
  confirm=$(printf 'no\nyes' | fzf --height=100% --reverse --border=rounded \
    --header="$body" --prompt="remove worktree? " || echo no)
  [[ "$confirm" != "yes" ]] && return 0

  local default_choice="yes"
  [[ -n "$warnings_text" ]] && default_choice="no"
  local del_branch
  del_branch=$(printf 'no\nyes' | fzf --height=100% --reverse --border=rounded \
    --header="Also delete branch '$branch'? (data loss risk if warnings shown)" \
    --prompt="delete branch ($default_choice)? " || echo "$default_choice")

  local force="no"
  [[ -n "$warnings_text" ]] && force="yes"

  if lazy_llm_cleanup_worktree "$path" "$del_branch" "$force"; then
    tmux display-message "Cleaned up '$path'"
  fi
}

# ──────────────────────────────────────────────────────────────────────────
# Help tab — a proper tab (not a separate ephemeral popup), reachable from
# any other tab via '?' and, like the others, via '1'/'2'/'3'.
#
# Why a tab and not the always-visible subframe the originating task
# preferred by default: the Workspaces/Worktrees headers can only afford
# ~30-50 characters (see the header-width comment on render_sessions_tab) —
# a right-side preview leaves the list column only ~45% of the popup width.
# An always-visible keybinding strip would compete for that same scarce
# space. A dedicated tab instead gets the FULL popup width (no preview
# split needed here), which is exactly the difference between "the sparse
# header hints" and "the complete reference" fitting at all.
# ──────────────────────────────────────────────────────────────────────────

render_help_tab() {
  # Two-column layout (user-requested — a plain scrolling list of every key
  # read as a wall of text). Built by zipping two arrays rather than one big
  # string, so column widths stay exact regardless of content edits.
  local -a left=(
    "TABS"
    " 1   Workspaces"
    " 2   Worktrees"
    " 3   Help (this tab)"
    ""
    "WORKSPACES TAB"
    " Enter  ws row: switch"
    "        pane row: switch + focus"
    " z      fold/unfold panes"
    " ^Up ^Dn reorder row (own level)"
    " k  j   same, no-Ctrl alternate"
    " r      rename ws / pane label"
    " K      ws: kill · pane: remove"
    "        (current workspace only)"
    " R      refresh"
    ""
    "CURRENT WORKSPACE ONLY"
    " a      add AI pane"
    " ]  [   cycle next/prev pane"
  )
  local -a right=(
    "WORKTREES TAB"
    " Enter  open/attach in worktree"
    " n      new worktree + workspace"
    " g      launch lazygit"
    " K      atomic cleanup"
    " R      refresh"
    ""
    "GLOBAL"
    " ?      open this Help tab"
    " q  Esc close the dashboard"
    " /      search (type to filter)"
    " Tab    done searching (back to keys)"
    ""
    "ROW TYPES (Workspaces tab)"
    " ▾  ▸   workspace (expanded/folded)"
    " ↳      an AI pane, nested under it"
    " bold   the pane currently in view"
    ""
    "STATUS GLYPHS"
    " ◐      waiting (blocked on you)"
    " ◉      unread (done, your turn)"
    " ●      working (generating)"
    " ○      idle (already seen)"
    " ?      unknown"
  )

  local lw=34 rw=37
  local rows=${#left[@]}
  [[ ${#right[@]} -gt "$rows" ]] && rows=${#right[@]}

  # Manual char-count padding, not printf %-*s — the field width printf
  # computes for %s is byte-based, so any row containing a multi-byte
  # glyph (▾ ↳ · are all 2-3 bytes in UTF-8) comes out under-padded and
  # the right border drifts left. ${#text} is bash's own length operator,
  # which counts CHARACTERS correctly in a UTF-8 locale — use that instead.
  _help_pad() {
    local text="$1" width="$2" pad=$(( $2 - ${#1} ))
    [[ "$pad" -lt 0 ]] && pad=0
    printf '%s%*s' "$text" "$pad" ""
  }
  # Same reasoning for the border rule — `tr ' ' '─'` operates byte-wise and
  # mangles a multi-byte replacement character; build it by repetition
  # instead.
  _help_rule() {
    local n="$1" s="" i
    for ((i = 0; i < n; i++)); do s+="─"; done
    printf '%s' "$s"
  }

  local body="lazy-llm dashboard — keybindings"$'\n'
  body+="╭$(_help_rule $((lw + 2)))┬$(_help_rule $((rw + 2)))╮"
  local i
  for ((i = 0; i < rows; i++)); do
    body+=$'\n'"│ $(_help_pad "${left[i]:-}" "$lw") │ $(_help_pad "${right[i]:-}" "$rw") │"
  done
  body+=$'\n'"╰$(_help_rule $((lw + 2)))┴$(_help_rule $((rw + 2)))╯"

  local selection key
  selection=$(printf '%s\n' "$body" | fzf \
    --height=100% \
    --reverse \
    --border=rounded \
    --prompt="help> " \
    --no-info \
    --bind='q:abort' \
    --expect="1,2,3" \
  ) || { echo "quit"; return 0; }

  key=$(echo "$selection" | head -1)
  case "$key" in
    1) echo "tab:workspaces" ;;
    2) echo "tab:worktrees" ;;
    *) echo "action:refresh" ;;
  esac
}

# ──────────────────────────────────────────────────────────────────────────
# CLI handling
# ──────────────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: llm-dashboard [--tab workspaces|worktrees|help] [--help]

Tabbed popup dashboard for lazy-llm. Launches Workspaces tab by default. The
Workspaces tab is a tree: every lazy-llm workspace, with its AI panes nested
beneath it (press z to fold/unfold). The old separate Panes tab is folded
into this tree — '--tab panes' is still accepted as a compat alias for
'--tab workspaces'. Full keybinding reference: the Help tab ('3' or '?' from
either other tab) — the dashboard's own headers only have room for a couple
of hints (see the Help tab for why), so this is the actual reference.

Inside the dashboard:
  1, 2, 3    switch tabs (Workspaces, Worktrees, Help)
  Enter      primary action (switch workspace, or workspace+pane on a pane
             row / open worktree)
  n          new worktree+workspace (Worktrees — no workspace-level 'new' from here)
  z          fold/unfold a workspace's panes (Workspaces)
  Ctrl-Up,   reorder a row among its own tree-level siblings — a workspace
  Ctrl-Down  row among workspaces, a pane row among that workspace's own
             panes only (Workspaces). k/j are no-Ctrl alternates for the
             same two actions (useful over an SSH/tunneled terminal where
             Ctrl+Arrow doesn't reach the popup cleanly).
  a          add an AI pane to the CURRENT workspace (Workspaces — the one
             this dashboard was opened from, not whatever's highlighted)
  g          launch lazygit (Worktrees)
  K          kill workspace / remove pane / cleanup worktree (with confirmation)
  r          rename (Workspaces)
  ], [       cycle next / prev AI pane in the CURRENT workspace (Workspaces)
  R          refresh
  ?          open the Help tab
  q, Esc     close
EOF
}

# Parse args
current_tab=workspaces
while [[ $# -gt 0 ]]; do
  case "$1" in
    --tab)
      shift
      case "$1" in
        workspaces) current_tab="workspaces" ;;
        panes) current_tab="workspaces" ;; # compat alias — panes now live in the Workspaces tree
        worktrees) current_tab="worktrees" ;;
        help) current_tab="help" ;;
        *) echo "Unknown tab: $1" >&2; exit 2 ;;
      esac
      shift
      ;;
    --emit-rows)
      # Reload-plumbing only, not for interactive use: fzf's reload() action
      # (bound to 'z' fold/unfold in render_sessions_tab) re-invokes this
      # script with this flag as an independent subprocess, and feeds its
      # stdout back into the SAME running fzf as the tree's new row list —
      # see the row-model comment above _dashboard_build_rows for why this
      # has to be a standalone, out-of-process entry point rather than a
      # function call into the popup's own bash state.
      shift
      _dashboard_build_rows "${LAZY_LLM_LAUNCH_SESSION:-}"
      printf '%s\n' "$REPLY_ROWS"
      exit 0
      ;;
    --fold-transform)
      # Reload-plumbing only, not for interactive use: fzf's transform()
      # action (bound to 'z' fold/unfold in render_sessions_tab) re-invokes
      # this script with this flag as an independent subprocess and
      # interprets its STDOUT as a chain of further fzf actions to run (see
      # the 'z' bind's own comment for the full rationale/history — this
      # replaced an earlier execute-silent(...)+reload(...) pair once a bug
      # was found in relying on --track --id-nth=1 for cursor placement).
      #
      # Takes a raw tree row id ("ws:<name>" or "pane:<name>:<idx0>:<pane_id>",
      # i.e. fzf's {1}): flips that row's workspace's persisted fold flag,
      # rebuilds the row list, and prints back `reload-sync(...)+pos(N)`
      # (reload-sync, not reload — see below) where N is the 1-based line of
      # the row the cursor should land on in the NEW list — the SAME id's
      # row if it still exists there, else (the case
      # where 'z' was pressed on a pane row and its own parent workspace
      # just got folded, hiding that row) its parent workspace's "ws:<name>"
      # row. Falls back to row 1 only if neither is found (shouldn't happen
      # for a real id from a live row, but keeps this from ever emitting an
      # unusable pos()).
      shift
      _dashboard_fold_id="${1:-}"
      _dashboard_fold_ws=$(_dashboard_ws_from_id "$_dashboard_fold_id")
      [[ -n "$_dashboard_fold_ws" ]] && lazy_llm_toggle_collapsed "$_dashboard_fold_ws"

      _dashboard_build_rows "${LAZY_LLM_LAUNCH_SESSION:-}"

      _dashboard_fold_pos=""
      if [[ -n "$_dashboard_fold_id" ]]; then
        _dashboard_fold_pos=$(printf '%s\n' "$REPLY_ROWS" | awk -F'\t' -v id="$_dashboard_fold_id" '$1==id{print NR; exit}') || true
      fi
      if [[ -z "$_dashboard_fold_pos" && -n "$_dashboard_fold_ws" ]]; then
        _dashboard_fold_pos=$(printf '%s\n' "$REPLY_ROWS" | awk -F'\t' -v id="ws:${_dashboard_fold_ws}" '$1==id{print NR; exit}') || true
      fi
      [[ -n "$_dashboard_fold_pos" ]] || _dashboard_fold_pos=1

      # reload-sync, NOT reload, here — confirmed live (fzf 0.74.3) that a
      # plain reload(...)+pos(N) chained in one transform() output races:
      # reload() is asynchronous, so the chained pos(N) can run before (or
      # while) the new list is still loading and its effect gets discarded
      # once the reload actually lands, leaving the cursor exactly where
      # --track alone used to leave it (row 1) — silently reintroducing the
      # bug this whole mechanism exists to fix. reload-sync(...) blocks
      # until the reload command's full output is in, so the chained pos(N)
      # applies to the list that's actually on screen. Verified live with a
      # minimal repro fzf instance before trusting this in the real script
      # (`man fzf`'s own reload(...) vs reload-sync(...) distinction is
      # about blocking behavior for exactly this kind of chained-action
      # ordering, not just multi-select preservation).
      printf 'reload-sync(%s --emit-rows)+pos(%s)\n' "$_dashboard_self" "$_dashboard_fold_pos"
      exit 0
      ;;
    --reorder-transform)
      # Reload-plumbing only, not for interactive use: fzf's transform()
      # action (bound to both Ctrl-Up/Ctrl-Down AND their no-Ctrl k/j
      # alternates in render_sessions_tab — same handler either way, only
      # the key differs) re-invokes this script with this flag as an
      # independent subprocess — same shape as --fold-transform (see its
      # own comment and the Ctrl-Up/Ctrl-Down bind comment above the fzf
      # call for the full rationale; not re-litigated here).
      #
      # Takes a direction ("up" or "down") and a raw tree row id
      # ("ws:<name>" or "pane:<name>:<idx0>:<pane_id>", i.e. fzf's {1}):
      # moves that row among its OWN tree-level siblings only (a "ws:" id
      # reorders workspaces via lazy_llm_move_ws_order, persisted to the
      # server-scoped @lazy_llm_ws_order option; a "pane:" id reorders that
      # workspace's own panes via lazy_llm_move_pane_order, persisted
      # straight into @AI_PANES/@AI_TOOLS/@AI_PANE_NAMES — see both
      # helpers' own comments in lazy-llm-lib.sh), rebuilds the row list,
      # and prints back `reload-sync(...)+pos(N)` where N is the 1-based
      # line the moved row now occupies in the NEW list.
      shift
      _dashboard_reorder_dir="${1:-}"; shift
      _dashboard_reorder_id="${1:-}"
      _dashboard_reorder_ws=$(_dashboard_ws_from_id "$_dashboard_reorder_id")

      case "$_dashboard_reorder_id" in
        ws:*)
          [[ -n "$_dashboard_reorder_ws" ]] && lazy_llm_move_ws_order "$_dashboard_reorder_ws" "$_dashboard_reorder_dir"
          ;;
        pane:*)
          # "pane:<name>:<idx0>:<pane_id>" — idx0 is the 3rd colon-delimited
          # segment (same parsing _dashboard_ws_from_id's own case
          # statement implies but doesn't itself expose).
          _dashboard_reorder_rest="${_dashboard_reorder_id#pane:}"
          _dashboard_reorder_rest2="${_dashboard_reorder_rest#*:}"
          _dashboard_reorder_pidx="${_dashboard_reorder_rest2%%:*}"
          if [[ -n "$_dashboard_reorder_ws" && -n "$_dashboard_reorder_pidx" ]]; then
            _dashboard_reorder_win=$(tmux list-windows -t "$_dashboard_reorder_ws" -F '#{window_index}' 2>/dev/null | head -1)
            [[ -n "$_dashboard_reorder_win" ]] && lazy_llm_move_pane_order "$_dashboard_reorder_ws" "$_dashboard_reorder_win" "$_dashboard_reorder_pidx" "$_dashboard_reorder_dir"
          fi
          ;;
      esac

      _dashboard_build_rows "${LAZY_LLM_LAUNCH_SESSION:-}"

      # Cursor target after the move: for a workspace row, the id STRING
      # itself is unchanged by the swap ("ws:<name>" doesn't encode
      # position) so the same $1==id match --fold-transform uses works
      # unmodified. For a pane row the id's <idx0> segment IS the row's
      # position, so it changes across the swap (e.g. pane:foo:1:%3 becomes
      # pane:foo:0:%3 after moving up) — match on the trailing pane_id
      # field instead (stable across the swap) rather than the full id.
      _dashboard_reorder_pos=""
      case "$_dashboard_reorder_id" in
        ws:*)
          _dashboard_reorder_pos=$(printf '%s\n' "$REPLY_ROWS" | awk -F'\t' -v id="$_dashboard_reorder_id" '$1==id{print NR; exit}') || true
          ;;
        pane:*)
          _dashboard_reorder_pid="${_dashboard_reorder_id##*:}"
          _dashboard_reorder_pos=$(printf '%s\n' "$REPLY_ROWS" | awk -F'\t' -v pid="$_dashboard_reorder_pid" '{split($1,f,":"); if (f[1]=="pane" && f[4]==pid) {print NR; exit}}') || true
          ;;
      esac
      if [[ -z "$_dashboard_reorder_pos" && -n "$_dashboard_reorder_ws" ]]; then
        _dashboard_reorder_pos=$(printf '%s\n' "$REPLY_ROWS" | awk -F'\t' -v id="ws:${_dashboard_reorder_ws}" '$1==id{print NR; exit}') || true
      fi
      [[ -n "$_dashboard_reorder_pos" ]] || _dashboard_reorder_pos=1

      # reload-sync, NOT reload — identical confirmed-live async race as
      # --fold-transform (a plain reload()'s chained pos(N) can be
      # discarded before the new list actually lands); see its own comment
      # for the full root-cause writeup.
      printf 'reload-sync(%s --emit-rows)+pos(%s)\n' "$_dashboard_self" "$_dashboard_reorder_pos"
      exit 0
      ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

# ──────────────────────────────────────────────────────────────────────────
# Main outer loop — tab dispatch
# ──────────────────────────────────────────────────────────────────────────

if ! command -v fzf &>/dev/null; then
  echo "Error: fzf is required" >&2
  exit 1
fi

while true; do
  case "$current_tab" in
    workspaces) result=$(render_sessions_tab) ;;
    worktrees) result=$(render_worktrees_tab) ;;
    help)       result=$(render_help_tab) ;;
    *)         echo "Unknown tab: $current_tab" >&2; exit 1 ;;
  esac

  case "$result" in
    tab:*)
      current_tab="${result#tab:}"
      ;;
    action:switch:*|action:switch-pane:*|action:kill:*|action:rename:*|action:rename-pane:*|action:refresh|action:pane-add|action:pane-remove:*|action:pane-remove-unsupported|action:pane-next|action:pane-prev|action:worktree-open:*|action:worktree-new|action:worktree-lazygit:*|action:worktree-cleanup:*)
      dispatch_action "$result"
      # Switch action exits the popup; for others we re-enter the current tab
      [[ "$result" == action:switch:* || "$result" == action:switch-pane:* ]] && break
      ;;
    quit|"")
      break
      ;;
    *)
      echo "Unexpected result: $result" >&2
      break
      ;;
  esac
done
