#!/usr/bin/env bash
# llm-dashboard-open - launch llm-dashboard in a popup sized generously
# against the current terminal, instead of a fixed 70%.
#
# History: this used to compute height from the tree's content-row count,
# aiming to eliminate blank space below a short list. That solved the wrong
# problem — the preview pane shares the popup's height with the list (they're
# a side-by-side split), so shrinking the popup to match a short list ALSO
# shrinks the preview, and a short preview reads badly for actual
# conversation content. Corrected per direct user feedback: default to a
# generous height (most of the terminal), with a floor so it's never
# unusably short and a ceiling so it never crowds out the terminal's own
# chrome. No content-based shrinking — vertical space for reading the
# preview matters more than eliminating blank rows below a short tree.
#
# Bound to Prefix+S (see lazy-llm's window-setup function) via `run-shell`,
# since tmux's own `bind-key ... display-popup -h N` needs N computed before
# the popup opens — that has to happen in a real shell, not tmux's own
# command language.

set -euo pipefail

# Generous default: most of the terminal. Floor keeps it usable on a tiny
# terminal; there's no separate ceiling constant because TARGET_PERCENT
# itself (comfortably under 100) is already the ceiling relative to the
# client's own height.
TARGET_PERCENT=90
MIN_HEIGHT=24

client_h=$(tmux display-message -p '#{client_height}' 2>/dev/null) || client_h=50
height=$((client_h * TARGET_PERCENT / 100))
[[ "$height" -lt "$MIN_HEIGHT" ]] && height=$MIN_HEIGHT
[[ "$height" -gt "$client_h" ]] && height=$client_h

exec tmux display-popup -E -w 92% -h "${height}" "$HOME/.local/bin/llm-dashboard" "$@"
