#!/usr/bin/env bash
# llm-dashboard-open - launch llm-dashboard in a popup sized generously
# against the current terminal, instead of a fixed 70%.
#
# History: this used to compute height from the tree's content-row count,
# aiming to eliminate blank space below a short list. That solved the wrong
# problem — the preview pane shares the popup's height with the list (they're
# a side-by-side split), so shrinking the popup to match a short list ALSO
# shrinks the preview, and a short preview reads badly for actual
# conversation content. Corrected per direct user feedback: default to a
# generous height (most of the terminal), with a floor so it's never
# unusably short and a ceiling so it never crowds out the terminal's own
# chrome. No content-based shrinking — vertical space for reading the
# preview matters more than eliminating blank rows below a short tree.
#
# Bound to Prefix+S (see lazy-llm's window-setup function) via `run-shell`,
# since tmux's own `bind-key ... display-popup -h N` needs N computed before
# the popup opens — that has to happen in a real shell, not tmux's own
# command language.

set -euo pipefail

# Generous default: most of the terminal. Floor keeps it usable on a tiny
# terminal; there's no separate ceiling constant because TARGET_PERCENT
# itself (comfortably under 100) is already the ceiling relative to the
# client's own height.
TARGET_PERCENT=90
MIN_HEIGHT=24

client_h=$(tmux display-message -p '#{client_height}' 2>/dev/null) || client_h=50
height=$((client_h * TARGET_PERCENT / 100))
[[ "$height" -lt "$MIN_HEIGHT" ]] && height=$MIN_HEIGHT
[[ "$height" -gt "$client_h" ]] && height=$client_h

# Resolve the calling workspace HERE, in run-shell's own context, and pass
# it into the popup explicitly — verified live that this is necessary: a
# popup's child process does NOT reliably inherit the calling pane/session
# context (TMUX_PANE is unset inside it, and the ambient
# `tmux display-message -p` fallback resolved to a DIFFERENT, unrelated
# session in testing, not the one that opened the popup). Passing it in via
# `-e` sidesteps that entirely — see coding-standards/frameworks/tmux-fzf.md.
launch_session=$(tmux display-message -p '#S' 2>/dev/null) || launch_session=""

# Universal nav hints (same on every tab) go in the popup's own title bar,
# not fzf's --header — the title spans the FULL popup width (it's tmux's
# own border, not constrained by the list column fzf's preview pane eats
# into), and unlike --header it can't wrap awkwardly inside the box. It
# also can't be changed once the popup is running (tmux only accepts a
# handful of flags when "modifying" an already-open popup, -T isn't one of
# them — see `display-popup` in the tmux manual) — fine here, since this
# content is the same regardless of which tab is active.
# "3:help" dropped — redundant with "?:help" right next to it (both open the
# same tab); one shortcut per action, per user request.
TITLE=" lazy-llm │ 1:workspaces 2:worktrees │ ?:help q:close "

exec tmux display-popup -E -w 92% -h "${height}" -T "${TITLE}" \
  -e "LAZY_LLM_LAUNCH_SESSION=${launch_session}" \
  "$HOME/.local/bin/llm-dashboard" "$@"
